<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Clears any private feeds inherited from the machine-wide config so restore is
       reproducible on any machine and NuGet's audit does not warn about unreachable feeds. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
