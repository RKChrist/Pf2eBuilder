<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Pf2e.Domain\Pf2e.Domain.csproj" />
    <ProjectReference Include="..\..\src\Pf2e.Contracts\Pf2e.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Pf2e.Application\Pf2e.Application.csproj" />
    <!-- For the options validators, which live beside the host that reads them. The layering
         assertions in ArchitectureRules read compiled assemblies, so what this test project
         references cannot loosen what the source projects may reference. -->
    <ProjectReference Include="..\..\src\Pf2e.Api\Pf2e.Api.csproj" />
  </ItemGroup>

</Project>
