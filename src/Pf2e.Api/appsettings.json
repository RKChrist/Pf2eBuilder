{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "https://localhost:7173"
    ]
  },
  "Realtime": {
    "HubPath": "/hub/campaign",
    "KeepAliveSeconds": 15,
    "ClientTimeoutSeconds": 30
  },
  "Auth": {
    "Cookie": {
      "Name": "pf2e.auth",
      "ExpireMinutes": 720,
      "SlidingExpiration": true,
      "SameSite": "Lax",
      "SecurePolicy": "SameAsRequest",
      "LoginPath": "/account",
      "AccessDeniedPath": "/account"
    },
    "Jwt": {
      "Issuer": "pf2e-builder",
      "Audience": "pf2e-builder",
      "AccessTokenMinutes": 60,
      "RefreshTokenMinutes": 20160,
      "ClockSkewSeconds": 30
    }
  },
  "Database": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=pf2e.db",
    "MigrateOnStartup": true
  },
  "Seeding": {
    "Enabled": true,
    "SeedDataPath": "../../tools/rules-import/out/seed",
    "RulesetVersion": "aon-20260902-190924"
  },
  "Hosting": {
    "ClientRoot": "",
    "StartClient": true,
    "ClientProject": "../Pf2e.Client",
    "ClientUrl": "http://localhost:5173"
  }
}
