@* One stroked line drawing per name, at the size of the text beside it.

   Icons here name things and actions: a heart is hit points, a tent is camp, an eye is what the
   players can see. Statistics are not in the set on purpose. A row of five glyphs standing for
   armour class, Fortitude, Reflex, Will and Perception is a legend a GM has to learn mid-fight,
   and "AC" is already the shortest way to write armour class. *@
<svg class="pf-icon @Class"
     viewBox="0 0 24 24"
     fill="none"
     stroke="currentColor"
     stroke-width="1.7"
     stroke-linecap="round"
     stroke-linejoin="round"
     aria-hidden="@(Label is null ? "true" : null)"
     role="@(Label is null ? null : "img")"
     focusable="false"
     @attributes="Attributes">
    @if (Label is { } label)
    {
        <title>@label</title>
    }
    @switch (Name)
    {
        case "heart":
            <path d="M12 20.3C7 17 3.8 14.1 3.8 10.4A4.1 4.1 0 0 1 12 8.1a4.1 4.1 0 0 1 8.2 2.3c0 3.7-3.2 6.6-8.2 9.9Z" />
            break;

        case "shield":
            <path d="M12 3.2 19.5 6v6c0 4-3 6.9-7.5 8.4C7.5 18.9 4.5 16 4.5 12V6Z" />
            break;

        case "eye":
            <path d="M2.4 12S5.9 5.8 12 5.8 21.6 12 21.6 12 18.1 18.2 12 18.2 2.4 12 2.4 12Z" />
            <circle cx="12" cy="12" r="2.7" />
            break;

        case "eye-off":
            <path d="M4 4.6 20 19.9" />
            <path d="M9.6 6.2A9.6 9.6 0 0 1 12 5.9c6.1 0 9.6 6.1 9.6 6.1a17 17 0 0 1-3 3.7" />
            <path d="M17.2 17.3A9.8 9.8 0 0 1 12 18.2C5.9 18.2 2.4 12 2.4 12a17.3 17.3 0 0 1 4.3-4.8" />
            <path d="M10.2 10.3a2.7 2.7 0 0 0 3.6 3.8" />
            break;

        case "dice":
            <rect x="4" y="4" width="16" height="16" rx="3.4" />
            <circle cx="9" cy="9" r="1.1" fill="currentColor" stroke="none" />
            <circle cx="15" cy="15" r="1.1" fill="currentColor" stroke="none" />
            break;

        case "spark":
            <path d="M12 3.4 13.7 9l5.6 1.7-5.6 1.7L12 18l-1.7-5.6L4.7 10.7 10.3 9Z" />
            break;

        case "skull":
            <path d="M5.3 11.2a6.7 6.7 0 1 1 13.4 0v3.2a2 2 0 0 1-1.3 1.9l-.7.3v2.1a1 1 0 0 1-1 1H8.3a1 1 0 0 1-1-1v-2.1l-.7-.3a2 2 0 0 1-1.3-1.9Z" />
            <circle cx="9.3" cy="11.6" r="1.6" />
            <circle cx="14.7" cy="11.6" r="1.6" />
            break;

        case "person":
            <circle cx="12" cy="7.4" r="3.3" />
            <path d="M5.4 20v-1.3a6.6 6.6 0 0 1 13.2 0V20" />
            break;

        case "clock":
            <circle cx="12" cy="12" r="8.2" />
            <path d="M12 7.6V12l3 1.8" />
            break;

        case "tent":
            <path d="M12 2.8c2.6 2.9 3.9 5.2 3.9 7a3.9 3.9 0 0 1-7.8 0c0-1.8 1.3-4.1 3.9-7Z" />
            <path d="M4.6 15.4 19.4 20.4M19.4 15.4 4.6 20.4" />
            break;

        case "boot":
            <path d="M6.6 7.4h10.8a1.8 1.8 0 0 1 1.8 1.8v9.2a1.8 1.8 0 0 1-1.8 1.8H6.6a1.8 1.8 0 0 1-1.8-1.8V9.2a1.8 1.8 0 0 1 1.8-1.8Z" />
            <path d="M9.2 7.4V5.6a2.8 2.8 0 0 1 5.6 0v1.8" />
            <path d="M9.6 12.6h4.8" />
            break;

        case "moon":
            <path d="M20 14.2A8.4 8.4 0 0 1 9.4 3.9a8.6 8.6 0 1 0 10.6 10.3Z" />
            break;

        case "sun":
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2.8v2M12 19.2v2M4.5 4.5l1.4 1.4M18.1 18.1l1.4 1.4M2.8 12h2M19.2 12h2M4.5 19.5l1.4-1.4M18.1 5.9l1.4-1.4" />
            break;

        case "swords":
            <path d="M4 4h3.2l9 9-3.2 3.2-9-9Z" />
            <path d="M20 4h-3.2l-3.4 3.4 3.2 3.2L20 7.2Z" />
            <path d="M13.6 16.2 17 19.6M10.4 16.2 7 19.6" />
            break;

        case "plus":
            <path d="M12 5.4v13.2M5.4 12h13.2" />
            break;

        case "minus":
            <path d="M5.4 12h13.2" />
            break;

        case "close":
            <path d="M6 6l12 12M18 6 6 18" />
            break;

        case "chevron":
            <path d="M8.6 5.4 15.8 12l-7.2 6.6" />
            break;

        case "upload":
            <path d="M12 15.6V4.4" />
            <path d="M7.8 8.6 12 4.4l4.2 4.2" />
            <path d="M4.6 15v3.2a1.4 1.4 0 0 0 1.4 1.4h12a1.4 1.4 0 0 0 1.4-1.4V15" />
            break;

        case "clipboard":
            <path d="M9 4.6h6v2.2H9Z" />
            <path d="M15 5.7h2.2a1.4 1.4 0 0 1 1.4 1.4v11.5a1.4 1.4 0 0 1-1.4 1.4H6.8a1.4 1.4 0 0 1-1.4-1.4V7.1a1.4 1.4 0 0 1 1.4-1.4H9" />
            break;

        case "bolt":
            <path d="M13.4 3.2 6.2 13.4h4.9l-.9 7.4 7.4-10.4h-4.9Z" />
            break;

        case "flag":
            <path d="M6 20.4V4.2" />
            <path d="M6 4.8h9.6l-1.8 3.4 1.8 3.4H6Z" />
            break;

        case "undo":
            <path d="M4.4 9.4h8.9a5 5 0 0 1 0 10h-4" />
            <path d="M7.8 5.6 4 9.4l3.8 3.8" />
            break;

        case "check":
            <path d="M5 12.6 9.6 17 19 6.8" />
            break;

        case "warn":
            <path d="M12 4.2 21 19.4H3Z" />
            <path d="M12 10v4.2M12 16.8h.01" />
            break;
    }
</svg>

@code {
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    [Parameter, EditorRequired] public string Name { get; set; } = string.Empty;

    [Parameter] public string? Class { get; set; }

    /// <summary>What a reader is told this drawing means. Null for the common case, where the
    /// icon sits beside the same word it stands for and repeating it is noise.</summary>
    [Parameter] public string? Label { get; set; }
}
