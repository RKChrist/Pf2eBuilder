@typeparam TValue

<div @attributes="Attributes" class="pf-segmented @Class" role="group" aria-label="@Label">
    @foreach (var option in Options)
    {
        <button type="button"
                class="pf-segmented__option"
                aria-pressed="@(IsSelected(option) ? "true" : "false")"
                disabled="@(Disabled || option.Disabled)"
                @onclick="() => ValueChanged.InvokeAsync(option.Value)">@option.Text</button>
    }
</div>

@code {
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    [Parameter] public string? Class { get; set; }

    [Parameter] public IReadOnlyList<ChoiceOption<TValue>> Options { get; set; } = Array.Empty<ChoiceOption<TValue>>();

    [Parameter] public TValue? Value { get; set; }

    [Parameter] public EventCallback<TValue?> ValueChanged { get; set; }

    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;

    [Parameter] public bool Disabled { get; set; }

    private bool IsSelected(ChoiceOption<TValue> option) => object.Equals(Value, option.Value);
}
