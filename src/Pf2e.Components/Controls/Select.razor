@typeparam TValue
@using System.Globalization

<div @attributes="Attributes" class="pf-field @(HasError ? "pf-field--invalid" : null) @Class">
    <label class="pf-field__label" for="@_id">@Label</label>
    <div class="pf-select">
        <select class="pf-select__native"
                id="@_id"
                value="@Format(Value)"
                @onchange="OnChange"
                disabled="@Disabled"
                aria-describedby="@DescribedBy"
                aria-invalid="@(HasError ? "true" : null)">
            @foreach (var option in Options)
            {
                <option value="@Format(option.Value)">@option.Text</option>
            }
        </select>
    </div>
    @if (HasHint)
    {
        <p class="pf-field__hint" id="@HintId">@Hint</p>
    }
    @if (HasError)
    {
        <p class="pf-field__error" id="@ErrorId">@Error</p>
    }
</div>

@code {
    private readonly string _id = $"pf-{Guid.NewGuid():N}";

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    [Parameter] public string? Class { get; set; }

    [Parameter] public IReadOnlyList<ChoiceOption<TValue>> Options { get; set; } = Array.Empty<ChoiceOption<TValue>>();

    [Parameter] public TValue? Value { get; set; }

    [Parameter] public EventCallback<TValue?> ValueChanged { get; set; }

    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;

    [Parameter] public string? Hint { get; set; }

    [Parameter] public string? Error { get; set; }

    [Parameter] public bool Disabled { get; set; }

    private bool HasHint => !string.IsNullOrEmpty(Hint);

    private bool HasError => !string.IsNullOrEmpty(Error);

    private string HintId => $"{_id}-hint";

    private string ErrorId => $"{_id}-error";

    private string? DescribedBy => (HasHint, HasError) switch
    {
        (true, true) => $"{HintId} {ErrorId}",
        (true, false) => HintId,
        (false, true) => ErrorId,
        (false, false) => null,
    };

    private static string? Format(TValue? value) =>
        BindConverter.FormatValue(value, CultureInfo.InvariantCulture)?.ToString();

    private Task OnChange(ChangeEventArgs e) =>
        BindConverter.TryConvertTo<TValue>(e.Value, CultureInfo.InvariantCulture, out var parsed)
            ? ValueChanged.InvokeAsync(parsed)
            : Task.CompletedTask;
}
