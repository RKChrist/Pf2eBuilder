<div @attributes="Attributes" class="pf-field @(HasError ? "pf-field--invalid" : null) @Class">
    <label class="pf-field__label" for="@_id">@Label</label>
    <input class="pf-input"
           id="@_id"
           type="@Type"
           value="@Value"
           @oninput="OnInput"
           inputmode="@InputMode"
           autocomplete="@Autocomplete"
           placeholder="@Placeholder"
           disabled="@Disabled"
           aria-describedby="@DescribedBy"
           aria-invalid="@(HasError ? "true" : null)" />
    @if (HasHint)
    {
        <p class="pf-field__hint" id="@HintId">@Hint</p>
    }
    @if (HasError)
    {
        <p class="pf-field__error" id="@ErrorId">@Error</p>
    }
</div>

@code {
    private readonly string _id = $"pf-{Guid.NewGuid():N}";

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    [Parameter] public string? Class { get; set; }

    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;

    [Parameter] public string? Value { get; set; }

    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    /// <summary>A password field is the same control with its characters hidden, so it is this
    /// one. Anything else a browser has a keyboard for, such as email, goes here too.</summary>
    [Parameter] public string Type { get; set; } = "text";

    /// <summary>Named on the input rather than left to the browser's guess, because a password
    /// manager fills nothing without it, and the wrapper's attributes land on the div.</summary>
    [Parameter] public string? Autocomplete { get; set; }

    [Parameter] public string? InputMode { get; set; }

    [Parameter] public string? Placeholder { get; set; }

    [Parameter] public string? Hint { get; set; }

    [Parameter] public string? Error { get; set; }

    [Parameter] public bool Disabled { get; set; }

    private bool HasHint => !string.IsNullOrEmpty(Hint);

    private bool HasError => !string.IsNullOrEmpty(Error);

    private string HintId => $"{_id}-hint";

    private string ErrorId => $"{_id}-error";

    private string? DescribedBy => (HasHint, HasError) switch
    {
        (true, true) => $"{HintId} {ErrorId}",
        (true, false) => HintId,
        (false, true) => ErrorId,
        (false, false) => null,
    };

    private Task OnInput(ChangeEventArgs e) => ValueChanged.InvokeAsync(e.Value?.ToString());
}
