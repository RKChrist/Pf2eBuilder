@page "/"
@inherits FluxorComponent
@inject IState<RulesBrowserState> Browser
@inject IDispatcher Dispatcher
@inject NavigationManager Navigation

<PageTitle>@Heading</PageTitle>

<header class="top">
    @if (State.ActiveCategory is not null)
    {
        <button type="button" class="back" @onclick="@(() => Dispatcher.Dispatch(new CategoryCleared()))">
            <span class="chevron" aria-hidden="true">←</span>
            All @RuleGroups.Of(State.ActiveGroup).Label categories
        </button>
    }

    <h1 class="heading">@Heading</h1>
</header>

@if (State.ActiveCategory is null)
{
    <ul class="categories">
        @foreach (var category in RuleCatalog.InGroup(State.ActiveGroup))
        {
            <li>
                @if (category.Route == RuleCatalog.BrowseRoute)
                {
                    <button type="button" class="category" @onclick="() => Open(category.Key)">
                        @category.Label
                        <span class="chevron" aria-hidden="true">→</span>
                    </button>
                }
                else
                {
                    <a class="category" href="@category.Route">
                        @category.Label
                        <span class="chevron" aria-hidden="true">→</span>
                    </a>
                }
            </li>
        }
    </ul>
}
else
{
    <div class="filters">
        <input class="name" type="search" inputmode="search" autocomplete="off"
               placeholder="Filter by name" aria-label="Filter by name"
               value="@State.Query" @oninput="OnQuery" />

        @if (State.Trait is { } activeTrait)
        {
            <button type="button" class="active-trait" @onclick="@(() => Dispatcher.Dispatch(new TraitSelected(null)))">
                @activeTrait
                <span class="dismiss" aria-hidden="true">×</span>
                <span class="assistive">Remove this trait filter</span>
            </button>
        }
    </div>

    <RemoteView T="RuleSearchResult" Data="State.Results">
        <NotAsked>
            <SkeletonRows />
        </NotAsked>
        <Loading>
            <SkeletonRows />
        </Loading>
        <Failed Context="message">
            <FailureState Message="@message" OnRetry="@(() => Dispatcher.Dispatch(new SearchRetried()))" />
        </Failed>
        <Loaded Context="found">
            @* The page's own rows decide whether levels are a thing here, except once a range is
               set: taking away the control that emptied the list is not a kindness. *@
            @if (found.Items.Any(item => item.Level is not null) || State.MinLevel is not null || State.MaxLevel is not null)
            {
                <div class="levels">
                    <label class="level-field">
                        <span class="level-label">Level from</span>
                        <select value="@Box(State.MinLevel)" @onchange="OnMinLevel">
                            <option value="">Any</option>
                            @foreach (var level in Levels)
                            {
                                <option value="@level">@level</option>
                            }
                        </select>
                    </label>

                    <label class="level-field">
                        <span class="level-label">to</span>
                        <select value="@Box(State.MaxLevel)" @onchange="OnMaxLevel">
                            <option value="">Any</option>
                            @foreach (var level in Levels)
                            {
                                <option value="@level">@level</option>
                            }
                        </select>
                    </label>
                </div>
            }

            @if (TraitsOn(found) is { Count: > 0 } traits)
            {
                <div class="trait-scroller" role="group" aria-label="Filter by trait">
                    @foreach (var trait in traits)
                    {
                        <button type="button"
                                class="trait-chip @(trait == State.Trait ? "on" : null)"
                                aria-pressed="@(trait == State.Trait ? "true" : "false")"
                                @onclick="() => Dispatcher.Dispatch(new TraitSelected(trait == State.Trait ? null : trait))">
                            @trait
                        </button>
                    }
                </div>
            }

            @if (found.Items.Count == 0)
            {
                <EmptyState Message="@EmptyMessage">
                    @if (State.Query.Length > 0)
                    {
                        <button type="button" @onclick="@(() => Dispatcher.Dispatch(new QueryChanged(string.Empty)))">
                            Clear the name filter
                        </button>
                    }
                    @if (State.MinLevel is not null || State.MaxLevel is not null)
                    {
                        <button type="button" @onclick="@(() => Dispatcher.Dispatch(new LevelRangeChanged(null, null)))">
                            Widen to every level
                        </button>
                    }
                    @if (State.Trait is not null)
                    {
                        <button type="button" @onclick="@(() => Dispatcher.Dispatch(new TraitSelected(null)))">
                            Drop the trait filter
                        </button>
                    }
                </EmptyState>
            }
            else
            {
                <ul class="records">
                    @foreach (var item in found.Items)
                    {
                        <li>
                            <button type="button" class="record" @onclick="() => OpenRule(item.Id)">
                                <span class="record-name">@item.Name</span>
                                <span class="record-marks">
                                    @if (item.Level is int level)
                                    {
                                        <span class="record-level">Level @level</span>
                                    }
                                    <RarityTag Rarity="@item.Rarity" />
                                </span>
                                <TraitList Traits="item.Traits" AlreadyShown="@item.Rarity" />
                            </button>
                        </li>
                    }
                </ul>

                <nav class="pager" aria-label="Pages">
                    <button type="button" disabled="@(found.Page <= 1)"
                            @onclick="() => Dispatcher.Dispatch(new PageSelected(found.Page - 1))">
                        Previous
                    </button>
                    <span class="count">Page @found.Page of @PageCount(found)</span>
                    <button type="button" disabled="@(found.Page >= PageCount(found))"
                            @onclick="() => Dispatcher.Dispatch(new PageSelected(found.Page + 1))">
                        Next
                    </button>
                </nav>
            }
        </Loaded>
    </RemoteView>
}

<RuleSheet RuleId="@OpenRuleId" />

@code {
    static readonly int[] Levels = [.. Enumerable.Range(-1, 32)];

    [Parameter, SupplyParameterFromQuery(Name = "rule")] public string? OpenRuleId { get; set; }

    RulesBrowserState State => Browser.Value;

    string Heading => State.ActiveCategory is { } category
        ? RuleCatalog.LabelOf(category)
        : RuleGroups.Of(State.ActiveGroup).Heading;

    string EmptyMessage => State.Query.Length > 0
        ? $"No {Heading.ToLowerInvariant()} match “{State.Query}”."
        : $"No {Heading.ToLowerInvariant()} match these filters.";

    static int PageCount(RuleSearchResult found) =>
        Math.Max(1, (found.TotalMatching + found.PageSize - 1) / found.PageSize);

    static IReadOnlyList<string> TraitsOn(RuleSearchResult found) =>
        [.. found.Items.SelectMany(item => item.Traits).Distinct(StringComparer.Ordinal).Order(StringComparer.Ordinal)];

    static string Box(int? level) => level?.ToString() ?? string.Empty;

    void Open(string category) => Dispatcher.Dispatch(new CategorySelected(category));

    void OpenRule(string id) => Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("rule", id));

    void OnQuery(ChangeEventArgs args) =>
        Dispatcher.Dispatch(new QueryChanged(args.Value as string ?? string.Empty));

    void OnMinLevel(ChangeEventArgs args) =>
        Dispatcher.Dispatch(new LevelRangeChanged(Unbox(args), State.MaxLevel));

    void OnMaxLevel(ChangeEventArgs args) =>
        Dispatcher.Dispatch(new LevelRangeChanged(State.MinLevel, Unbox(args)));

    static int? Unbox(ChangeEventArgs args) =>
        int.TryParse(args.Value as string, out var level) ? level : null;
}
