@page "/"
@inherits FluxorComponent
@inject IState<RulesBrowserState> Browser
@inject IState<CatalogSizeState> Sizes
@inject IDispatcher Dispatcher
@inject NavigationManager Navigation

<PageTitle>@Heading</PageTitle>

<header class="top">
    @if (State.ActiveCategory is not null)
    {
        <Button Class="back"
                Variant="ButtonVariant.Quiet"
                OnClick="@(() => Dispatcher.Dispatch(new CategoryCleared()))">
            <span aria-hidden="true">←</span>
            All @RuleGroups.Of(State.ActiveGroup).Label categories
        </Button>
    }

    <h1 class="heading">@Heading</h1>

    @if (Blurb is { Length: > 0 } blurb)
    {
        <p class="blurb">@blurb</p>
    }

    @if (State.ActiveCategory is { } shown && State.Results is RemoteData<RuleSearchResult>.Loaded counted)
    {
        <p class="total">@Total(shown, counted.Value.TotalMatching)</p>
    }
</header>

@if (State.ActiveCategory is null)
{
    <div class="board">
        @foreach (var section in Sections)
        {
            <section class="section" aria-label="@section.Name">
                @if (Sections.Count > 1)
                {
                    <h2 class="section-title">@section.Name</h2>
                }
                <div class="categories">
                    @foreach (var category in section.Categories)
                    {
                        @if (category.Route == RuleCatalog.BrowseRoute)
                        {
                            <button type="button" class="category" @onclick="() => Open(category.Key)">
                                @CategoryFace(category)
                            </button>
                        }
                        else
                        {
                            <a class="category" href="@category.Route">@CategoryFace(category)</a>
                        }
                    }
                </div>
            </section>
        }
    </div>
}
else
{
    <div class="filters">
        <SearchField Class="name"
                     Value="@State.Query"
                     ValueChanged="OnQuery"
                     Placeholder="@($"Filter {Heading.ToLowerInvariant()} by name")"
                     Label="Filter by name" />

        <Button Class="refine-toggle"
                Variant="ButtonVariant.Secondary"
                aria-expanded="@(_refining ? "true" : "false")"
                aria-controls="refine"
                OnClick="@(() => _refining = !_refining)">
            Filters@(ActiveFilters > 0 ? $" ({ActiveFilters})" : null)
        </Button>

        @if (State.Trait is { } activeTrait)
        {
            <button type="button" class="active-trait" @onclick="@(() => Dispatcher.Dispatch(new TraitSelected(null)))">
                @activeTrait
                <span class="dismiss" aria-hidden="true">×</span>
                <span class="visually-hidden">Remove this trait filter</span>
            </button>
        }
    </div>

    <RemoteView T="RuleSearchResult" Data="State.Results">
        <NotAsked>@Waiting</NotAsked>
        <Loading>@Waiting</Loading>
        <Failed Context="message">
            <div class="panel">
                <Card>
                    <ErrorState Title="@($"Could not load {Heading.ToLowerInvariant()}")">
                        <ChildContent>@message</ChildContent>
                        <Action>
                            <Button Variant="ButtonVariant.Secondary"
                                    OnClick="@(() => Dispatcher.Dispatch(new SearchRetried()))">
                                Try again
                            </Button>
                        </Action>
                    </ErrorState>
                </Card>
            </div>
        </Failed>
        <Loaded Context="found">
            @* Folded away on a phone, where it would push the list below the fold, and always open
               at laptop width, where there is room for it beside nothing. *@
            <div class="refine" id="refine" data-open="@(_refining ? "true" : "false")">
                @* The page's own rows decide whether levels are a thing here, except once a range
                   is set: taking away the control that emptied the list is not a kindness. *@
                @if (found.Items.Any(item => item.Level is not null) || State.Levels != LevelScale.Whole)
                {
                    <div class="levels">
                        <RangeSlider Label="Level"
                                     LowLabel="Lowest level"
                                     HighLabel="Highest level"
                                     Min="LevelScale.Floor"
                                     Max="LevelScale.Ceiling"
                                     TickEvery="1"
                                     ShowEnds="true"
                                     Value="State.Levels"
                                     ValueChanged="@(levels => Dispatcher.Dispatch(new LevelRangeChanged(levels)))" />
                    </div>
                }

                @if (TraitsOn(found) is { Count: > 0 } traits)
                {
                    <p class="refine-label" id="trait-filter-label">Only records with the trait</p>
                    <div class="trait-scroller" role="group" aria-labelledby="trait-filter-label">
                        @foreach (var trait in traits)
                        {
                            <button type="button"
                                    class="trait-chip @(trait == State.Trait ? "on" : null)"
                                    aria-pressed="@(trait == State.Trait ? "true" : "false")"
                                    @onclick="() => Dispatcher.Dispatch(new TraitSelected(trait == State.Trait ? null : trait))">
                                @trait
                            </button>
                        }
                    </div>
                }
            </div>

            @if (found.Items.Count == 0)
            {
                <div class="panel">
                    <Card>
                        <EmptyState Title="@($"No {Heading.ToLowerInvariant()} match")">
                            <ChildContent>@EmptyBody</ChildContent>
                            <Action>
                                <div class="pf-cluster">
                                    @if (State.Query.Length > 0)
                                    {
                                        <Button Variant="ButtonVariant.Secondary"
                                                OnClick="@(() => Dispatcher.Dispatch(new QueryChanged(string.Empty)))">
                                            Clear the name filter
                                        </Button>
                                    }
                                    @if (State.Levels != LevelScale.Whole)
                                    {
                                        <Button Variant="ButtonVariant.Secondary"
                                                OnClick="@(() => Dispatcher.Dispatch(new LevelRangeChanged(LevelScale.Whole)))">
                                            Widen to every level
                                        </Button>
                                    }
                                    @if (State.Trait is not null)
                                    {
                                        <Button Variant="ButtonVariant.Secondary"
                                                OnClick="@(() => Dispatcher.Dispatch(new TraitSelected(null)))">
                                            Drop the trait filter
                                        </Button>
                                    }
                                </div>
                            </Action>
                        </EmptyState>
                    </Card>
                </div>
            }
            else
            {
                <div class="panel">
                    <Card>
                        <ListContent>
                            <ul class="rows">
                                @foreach (var item in found.Items)
                                {
                                    <RuleRow Rule="item" OnOpen="() => OpenRule(item.Id)" />
                                }
                            </ul>
                        </ListContent>
                    </Card>
                </div>

                @if (PageCount(found) > 1)
                {
                    <div class="panel">
                        <Pager Page="found.Page"
                               PageCount="PageCount(found)"
                               PageChanged="@(page => Dispatcher.Dispatch(new PageSelected(page)))"
                               Label="Pages" />
                    </div>
                }
            }
        </Loaded>
    </RemoteView>
}

@code {
    bool _refining;

    RulesBrowserState State => Browser.Value;

    string Heading => State.ActiveCategory is { } category
        ? RuleCatalog.LabelOf(category)
        : RuleGroups.Of(State.ActiveGroup).Heading;

    string? Blurb => State.ActiveCategory is { } category
        ? CategoryNotes.Of(category)?.Blurb
        : GroupNotes.Of(State.ActiveGroup);

    int ActiveFilters => (State.Levels != LevelScale.Whole ? 1 : 0) + (State.Trait is not null ? 1 : 0);

    sealed record Section(string Name, IReadOnlyList<RuleCategory> Categories);

    IReadOnlyList<Section> Sections =>
    [
        .. CategoryNotes.SectionOrder(State.ActiveGroup)
            .Select(name => new Section(name, [.. RuleCatalog.InGroup(State.ActiveGroup)
                .Where(category => CategoryNotes.Of(category.Key)?.Section == name)]))
            .Where(section => section.Categories.Count > 0),
    ];

    RenderFragment CategoryFace(RuleCategory category) => @<text>
        <span class="face">
            <span class="label">@category.Label</span>
            @if (Sizes.Value.Of(category.Key) is int size)
            {
                <span class="size">@Numbers.Grouped(size)</span>
            }
        </span>
        @if (CategoryNotes.Of(category.Key) is { } note)
        {
            <span class="note">@note.Blurb</span>
        }
    </text>;

    RenderFragment Waiting => @<div class="pending">
        <Spinner ShowLabel="true" Label="@($"Loading {Heading.ToLowerInvariant()}")" />
    </div>;

    string EmptyBody => State.Query.Length > 0
        ? $"Nothing here matches “{State.Query}”."
        : "Nothing here matches these filters.";

    string Total(string category, int matching)
    {
        var noun = matching == 1 ? RuleCatalog.OneOf(category) : RuleCatalog.LabelOf(category);
        var of = Sizes.Value.Of(category) is int all && all != matching ? $" of {Numbers.Grouped(all)}" : null;
        return $"{Numbers.Grouped(matching)}{of} {noun.ToLowerInvariant()}";
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();

        if (Sizes.Value.Sizes is RemoteData<RuleCounts>.NotAsked or RemoteData<RuleCounts>.Failed)
        {
            Dispatcher.Dispatch(new CatalogSizesRequested());
        }
    }

    static int PageCount(RuleSearchResult found) =>
        Math.Max(1, (found.TotalMatching + found.PageSize - 1) / found.PageSize);

    static IReadOnlyList<string> TraitsOn(RuleSearchResult found) =>
        [.. found.Items.SelectMany(item => item.Traits).Distinct(StringComparer.Ordinal).Order(StringComparer.Ordinal)];

    void Open(string category) => Dispatcher.Dispatch(new CategorySelected(category));

    void OpenRule(string id) => Navigation.NavigateTo(Navigation.Rule(id));

    void OnQuery(string? query) => Dispatcher.Dispatch(new QueryChanged(query ?? string.Empty));
}
