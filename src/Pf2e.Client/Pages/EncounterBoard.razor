@page "/campaign/encounter"
@inherits FluxorComponent
@inject IState<CampaignState> Store
@inject IState<ConditionsState> ConditionsStore
@inject IState<ExplorationState> ExplorationStore
@inject IDispatcher Dispatcher
@inject NavigationManager Navigation
@using System.Globalization

<PageTitle>Encounter</PageTitle>

@* The initiative order, and everything a fight asks about a creature on the row for it.

   Every combatant carries the same five numbers, players included. A GM resolving "does a 24
   hit Gnibbo" was previously told Gnibbo's name and nothing else, and had to leave the fight for
   the party page to find out. A player's numbers were never secret; they were just somewhere
   else. *@
<CampaignPage Heading="Encounter" Context="table">
    <div class="fight">
        <Card Class="fight__card">
            <ChildContent>
                <SectionHead Text="Initiative" Glyph="swords">
                    <Aside>
                        @if (table.Role == "Dm")
                        {
                            <div class="fight__acts">
                            <Button Variant="ButtonVariant.Quiet"
                                    OnClick="() => Dispatcher.Dispatch(new CombatantPickerOpened())">
                                <Icon Name="plus" Class="pf-icon--lead" />Add
                            </Button>
                            <Button Variant="ButtonVariant.Quiet"
                                    OnClick="() => Dispatcher.Dispatch(new InitiativeRolled())">
                                <Icon Name="dice" Class="pf-icon--lead" />Roll
                            </Button>
                            <Button Variant="ButtonVariant.Quiet"
                                    OnClick="() => Dispatcher.Dispatch(new ChangeUndone())">
                                <Icon Name="undo" Class="pf-icon--lead" />Undo
                            </Button>
                            </div>
                        }
                    </Aside>
                </SectionHead>

                @* Whose turn and which round, in a sentence, directly above the order. The
                   rule down the current row's edge says the same thing, but only once you have
                   found the row, and on a phone with twelve creatures in the order that means
                   scrolling. This is the one fact a GM reads most often in a session. *@
                <div class="now @(Turn(table) is null ? "now--idle" : null)" role="status">
                    <Icon Name="flag" Class="now__glyph" />
                    <span class="now__who">
                        @if (Turn(table) is { } current)
                        {
                            <strong class="now__name">@current.Name</strong>
                            <text> is up</text>
                        }
                        else
                        {
                            <text>Nobody has rolled initiative yet</text>
                        }
                    </span>
                    @if (table.Encounter is { Round: > 0 } started)
                    {
                        <span class="now__round">Round @started.Round</span>
                    }
                    @if (table.Role == "Dm")
                    {
                        @* The button pressed more than every other control in the app put
                           together, beside the sentence it changes. *@
                        <Button Class="fight__next"
                                Disabled="@(table.Encounter is not { Round: > 0 })"
                                OnClick="() => Dispatcher.Dispatch(new TurnAdvanced())">
                            <Icon Name="chevron" Class="pf-icon--lead" />Next turn
                        </Button>
                    }
                </div>

                @if (table.Encounter is not { Combatants.Count: > 0 } fight)
                {
                    <EmptyState Title="Nobody is in this fight yet">
                        <ChildContent>
                            @if (table.Role == "Dm")
                            {
                                <text>Add the party and whatever they ran into, then roll initiative.</text>
                            }
                            else
                            {
                                <text>The GM has not started the fight yet.</text>
                            }
                        </ChildContent>
                    </EmptyState>
                }
                else
                {
                    <ol class="order">
                        @foreach (var combatant in fight.Combatants)
                        {
                            var vitals = Vitals(table, combatant);
                            var adversary = combatant.Kind == "Adversary";
                            var mine = !adversary || table.Role == "Dm";

                            <li class="turn @(combatant.IsCurrentTurn ? "turn--now" : null)"
                                data-combatant="@combatant.Id"
                                aria-current="@(combatant.IsCurrentTurn ? "true" : null)">

                                <div class="turn__head">
                                    @if (table.Role == "Dm")
                                    {
                                        @* Typed, not only rolled. At a real table the players
                                           roll their own dice and read the number out, and a
                                           misheard twenty-one used to be fixable only by rolling
                                           the whole fight again. *@
                                        <input class="turn__initiative turn__initiative--typed"
                                               type="text"
                                               inputmode="numeric"
                                               aria-label="@($"{combatant.Name}'s initiative")"
                                               value="@Shown(combatant)"
                                               @onchange="e => Commit(combatant, e.Value?.ToString())" />
                                    }
                                    else
                                    {
                                        <span class="turn__initiative">@combatant.Initiative</span>
                                    }

                                    @* Who this is, in one block, so the button that takes
                                       them out of the fight stays beside the initiative rather
                                       than being pushed to a line of its own by three traits. *@
                                    <div class="turn__who">
                                    <Icon Name="@(adversary ? "skull" : "person")"
                                          Class="turn__kind"
                                          Label="@(adversary ? "Adversary" : "Player character")" />
                                    @if (combatant.Monster is { RuleId: { Length: > 0 } record })
                                    {
                                        <a class="turn__called turn__called--record"
                                           href="@Navigation.Rule(record)"
                                           title="@($"What {combatant.Name} can do")">@combatant.Name</a>
                                    }
                                    else
                                    {
                                        <span class="turn__called">@combatant.Name</span>
                                    }
                                    @if (vitals?.Level is { } level)
                                    {
                                        <span class="turn__level">Level @level</span>
                                    }
                                    </div>

                                    @if (table.Role == "Dm")
                                    {
                                        <Button Variant="ButtonVariant.Quiet"
                                                Class="turn__out"
                                                OnClick="() => Dispatcher.Dispatch(new CombatantRemoved(combatant.Id))">
                                            <Icon Name="close" Label="@($"Take {combatant.Name} out of the fight")" />
                                        </Button>
                                    }
                                </div>

                                <div class="turn__body">
                                    @* What this creature is and how it is doing, on one line.
                                       Half the rules in a fight turn on the traits: whether it
                                       is undead, whether it can be flanked, whether it is a
                                       minion. *@
                                    <div class="turn__facts">
                                        @if (vitals is { } hurt)
                                        {
                                            <HitPoints Current="hurt.Current"
                                                       Max="hurt.Max"
                                                       Temporary="hurt.Temporary" />
                                        }
                                        @if (combatant.Monster is { Traits.Count: > 0 } kinds)
                                        {
                                            <span class="turn__traits">
                                                @foreach (var trait in kinds.Traits)
                                                {
                                                    <TraitLink Name="@trait" />
                                                }
                                            </span>
                                        }
                                        @if (adversary && !combatant.Revealed && table.Role == "Dm")
                                        {
                                            <span class="turn__hidden">
                                                <Icon Name="eye-off" />Hidden
                                            </span>
                                        }
                                    </div>

                                    @if (vitals is { } seen)
                                    {
                                        @* A character's numbers come from the strip the other
                                           mode pages use, so every one of them opens the sheet
                                           that explains it and is marked while something is
                                           moving it. A monster's stat line is a printed number
                                           with nothing behind it, so it stays a plain list. *@
                                        @if (Sheet(table, combatant) is { } sheet)
                                        {
                                            @* Attacks on the row whose turn it is and nowhere
                                               else. They are three chips per character, they
                                               wrap to two lines on a phone, and nobody rolls
                                               them except on that character's own turn, which
                                               is the moment they appear. *@
                                            <StatStrip Character="sheet"
                                                       ShowEffects="false"
                                                       ShowAttacks="combatant.IsCurrentTurn" />
                                        }
                                        else
                                        {
                                            <ul class="defences">
                                                @foreach (var defence in seen.Defences)
                                                {
                                                    <li class="defence" data-defence="@defence.Short">
                                                        <span class="defence__label">@defence.Short</span>
                                                        <span class="defence__value">@defence.Value</span>
                                                    </li>
                                                }
                                            </ul>
                                        }
                                    }

                                    @* Conditions where the fight is, not on another page. Tapping
                                       one takes it off; Undo puts it back, which is what makes a
                                       one-tap removal safe enough to be worth the speed. *@
                                    <div class="turn__chips">
                                        @foreach (var effect in combatant.Effects)
                                        {
                                            @* A player reads a monster's conditions and cannot
                                               take them off, the same way they cannot put them
                                               on. The chip stays, because "the ogre is
                                               frightened 2" is how a player decides their turn. *@
                                            if (mine)
                                            {
                                                <button type="button"
                                                        class="chip"
                                                        data-effect="@effect.Id"
                                                        aria-label="@($"Remove {Named(effect)} from {combatant.Name}")"
                                                        @onclick="() => Clear(combatant, effect)">
                                                    <span class="chip__name">@Named(effect)</span>
                                                    <Icon Name="close" Class="chip__off" />
                                                </button>
                                            }
                                            else
                                            {
                                                <span class="chip chip--read" data-effect="@effect.Id">
                                                    <span class="chip__name">@Named(effect)</span>
                                                </span>
                                            }
                                        }
                                        @if (mine)
                                        {
                                            <button type="button"
                                                    class="chip chip--add"
                                                    @onclick="() => Dispatcher.Dispatch(new PickerOpened(Subject(combatant)))">
                                                <Icon Name="spark" Class="chip__glyph" />
                                                <span class="chip__name">Effect</span>
                                            </button>
                                        }
                                    </div>
                                </div>

                                @* Damage and healing. A player's hit points were only ever
                                   changeable from the party page, which is the one page nobody
                                   is looking at during a fight. *@
                                @if (vitals is not null && mine)
                                {
                                    <div class="turn__dm">
                                        <div class="amount">
                                            <TextInput Class="amount__field"
                                                       Label="@($"Hit points to apply to {combatant.Name}")"
                                                       InputMode="numeric"
                                                       Placeholder="0"
                                                       Value="@State.HitPointDraft(combatant.Id)"
                                                       ValueChanged="typed => Dispatcher.Dispatch(
                                                           new HitPointDraftChanged(combatant.Id, typed ?? string.Empty))" />
                                            <Button Variant="ButtonVariant.Secondary"
                                                    Class="amount__act"
                                                    Disabled="@(Typed(combatant.Id) is null)"
                                                    OnClick='() => Apply(combatant.Id, "Damage")'>
                                                <Icon Name="minus" Class="pf-icon--lead" />Damage
                                            </Button>
                                            <Button Variant="ButtonVariant.Secondary"
                                                    Class="amount__act"
                                                    Disabled="@(Typed(combatant.Id) is null)"
                                                    OnClick='() => Apply(combatant.Id, "Heal")'>
                                                <Icon Name="plus" Class="pf-icon--lead" />Heal
                                            </Button>
                                        </div>

                                        @if (adversary)
                                        {
                                            @* A monster the players have not been shown is not on
                                               their screen at all, so this is the only way it gets
                                               there, and a bare toggle would not say so. *@
                                            <Switch Class="reveal"
                                                    Checked="combatant.Revealed"
                                                    CheckedChanged="on => Dispatcher.Dispatch(new MonsterRevealed(combatant.Id, on))">
                                                <span class="reveal__label">
                                                    <Icon Name="@(combatant.Revealed ? "eye" : "eye-off")" />
                                                    Players can see it
                                                </span>
                                            </Switch>
                                        }
                                    </div>
                                }
                            </li>
                        }
                    </ol>

                    @if (fight.Reminders.Count > 0)
                    {
                        @* What the turn change left somebody to do. The app does not do these
                           itself: persistent damage is followed by a flat check, and an app that
                           takes the hit points without rolling it has decided half a rule. *@
                        <ul class="reminders">
                            @foreach (var reminder in fight.Reminders)
                            {
                                <li class="reminder">
                                    <Icon Name="bolt" Class="reminder__glyph" />@reminder
                                </li>
                            }
                        </ul>
                    }

                    @if (table.Role == "Dm")
                    {
                        <Button Variant="ButtonVariant.Secondary"
                                Class="fight__end"
                                OnClick="() => Dispatcher.Dispatch(new EncounterEnded())">
                            End the fight
                        </Button>
                    }
                }
            </ChildContent>
        </Card>
    </div>
</CampaignPage>

<BottomSheet Open="@(State.AddingCombatant is not null)"
             Title="Add to the fight"
             OnClose="() => Dispatcher.Dispatch(new CombatantPickerClosed())">
    @if (State.AddingCombatant is { } picker && Table is { } open)
    {
        <div class="adding">
            @if (Absent(open) is { Count: > 0 } roster)
            {
                <SectionHead Text="From this campaign" Glyph="person" Level="3"
                             Class="pf-section--sub">
                    <Aside>
                        @if (roster.Count > 1)
                        {
                            <Button Variant="ButtonVariant.Quiet"
                                    Class="adding__all"
                                    OnClick="() => AddEveryone(roster)">
                                <Icon Name="plus" Class="pf-icon--lead" />All @roster.Count
                            </Button>
                        }
                    </Aside>
                </SectionHead>
                <Card>
                    <ListContent>
                        @foreach (var character in roster)
                        {
                            <ListRow Title="@character.Name"
                                     Meta="@Line($"Level {character.Level} {character.AncestryName} {character.ClassName}")"
                                     OnClick="() => Dispatcher.Dispatch(new CombatantAdded(null, character.Id, null))" />
                        }
                    </ListContent>
                </Card>
            }

            <SectionHead Text="A monster" Glyph="skull" Level="3" Class="pf-section--sub" />
            <SearchField Value="@picker.Query"
                         ValueChanged="query => Dispatcher.Dispatch(new MonsterQueryChanged(query ?? string.Empty))"
                         Placeholder="Search 3,786 creatures"
                         Label="Search the bestiary" />

            <RemoteView T="RuleSearchResult" Data="picker.Found">
                <NotAsked>
                    <p class="hint">Every creature in the ruleset, with the numbers a fight needs.</p>
                </NotAsked>
                <Loading>
                    <div class="pending"><Spinner ShowLabel="true" Label="Searching" /></div>
                </Loading>
                <Failed Context="message">
                    <ErrorState Title="Could not search the bestiary">
                        <ChildContent>@message</ChildContent>
                    </ErrorState>
                </Failed>
                <Loaded Context="found">
                    @if (found.Items.Count == 0)
                    {
                        <p class="hint">Nothing by that name.</p>
                    }
                    else
                    {
                        <Card>
                            <ListContent>
                                @foreach (var creature in found.Items)
                                {
                                    <ListRow Title="@creature.Name"
                                             Meta="@Line(Glance(creature))"
                                             OnClick="() => Dispatcher.Dispatch(new CombatantAdded(creature.Id, null, null))" />
                                }
                            </ListContent>
                        </Card>
                    }
                </Loaded>
            </RemoteView>
        </div>
    }
</BottomSheet>

@code {
    CampaignState State => Store.Value;

    CampaignView? Table =>
        State.Campaign is RemoteData<CampaignView>.Loaded loaded ? loaded.Value : null;

    static CombatantView? Turn(CampaignView table) =>
        table.Encounter is { Round: > 0 } fight
            ? fight.Combatants.FirstOrDefault(c => c.IsCurrentTurn)
            : null;

    /// <summary>What the box shows: what is being typed into it, or the number the server last
    /// confirmed. Not both, and never the server's number over a half-typed one.</summary>
    string Shown(CombatantView combatant) =>
        State.InitiativeDraft(combatant.Id) is { Length: > 0 } typed
            ? typed
            : combatant.Initiative.ToString();

    /// <summary>Sent on the way out of the box rather than per keystroke. Anything that is not a
    /// number a fight could produce puts the confirmed one back rather than sending a request
    /// the server would refuse.</summary>
    void Commit(CombatantView combatant, string? typed)
    {
        if (int.TryParse(typed, out var initiative) && initiative is >= -20 and <= 60)
        {
            if (initiative != combatant.Initiative)
            {
                Dispatcher.Dispatch(new InitiativeSet(combatant.Id, initiative));
                return;
            }
        }

        // The number the server last confirmed, written back explicitly. Dispatching an empty
        // draft looks like it does this and does not: the draft was already empty, so nothing
        // changed and the refused text stayed in the box.
        Dispatcher.Dispatch(new InitiativeDrafted(
            combatant.Id, combatant.Initiative.ToString(CultureInfo.InvariantCulture)));
    }

    /// <summary>One defence on a row, already written the way it reads.</summary>
    sealed record Reading(string Short, string Value);

    /// <summary>
    /// What a row can say about a creature. Null where the viewer is not shown the numbers at
    /// all, which is every monster in a player's copy: the projection has already left the stat
    /// line out, so this is reading what arrived rather than deciding what to hide.
    /// </summary>
    sealed record Seen(
        int Current, int Max, int Temporary, int? Level, IReadOnlyList<Reading> Defences);

    /// <summary>A character's numbers are on the sheet in the same payload and a monster's are on
    /// its stat line. Both go through the one defence table, so the order never differs by row.</summary>
    static Seen? Vitals(CampaignView table, CombatantView combatant)
    {
        if (combatant.Monster is { } monster)
        {
            return new Seen(
                monster.CurrentHitPoints,
                monster.MaxHitPoints,
                monster.TemporaryHitPoints,
                monster.Level,
                [.. Defences.All.Select(d => new Reading(d.Line.Short, d.Write(d.OfMonster(monster))))]);
        }

        if (table.Characters.FirstOrDefault(c => c.Id == combatant.Id) is not { } character)
        {
            return null;
        }

        return new Seen(
            character.CurrentHitPoints,
            character.MaxHitPoints,
            character.TemporaryHitPoints,
            character.Level,
            [
                .. Defences.All
                    .Select(d => (d, Value: d.OfCharacter(character)))
                    .Where(pair => pair.Value is not null)
                    .Select(pair => new Reading(pair.d.Line.Short, pair.d.Write(pair.Value!.Total))),
            ]);
    }

    /// <summary>The sheet behind a combatant, and null for a monster and for every monster in
    /// a player's copy. A sheet is what a breakdown is read off, so its absence is what
    /// decides whether the numbers on the row can be opened at all.</summary>
    static CharacterSheetView? Sheet(CampaignView table, CombatantView combatant) =>
        combatant.Kind == "Adversary"
            ? null
            : table.Characters.FirstOrDefault(c => c.Id == combatant.Id);

    static EffectSubject Subject(CombatantView combatant) =>
        combatant.Kind == "Adversary"
            ? EffectSubject.Monster(combatant.Id)
            : EffectSubject.Character(combatant.Id);

    void Clear(CombatantView combatant, ActiveEffectView effect) =>
        Dispatcher.Dispatch(new EffectSet(Subject(combatant), effect.Id, null));

    static string Named(ActiveEffectView effect) => SheetFormat.Named(effect);

    static IReadOnlyList<CharacterSheetView> Absent(CampaignView table) => SheetFormat.Absent(table);

    static string Glance(RuleSummary creature) => SheetFormat.Glance(creature);

    static RenderFragment Line(string text) => @<span class="line">@text</span>;

    int? Typed(Guid creatureId) => SheetFormat.Typed(State.HitPointDraft(creatureId));

    /// <summary>The whole party at once, which is how a fight starts. One action carrying all
    /// of them, because one action per character meant one command per character racing the rest
    /// on the same campaign, and all but one were lost.</summary>
    void AddEveryone(IReadOnlyList<CharacterSheetView> roster) =>
        Dispatcher.Dispatch(new PartyAdded([.. roster.Select(character => character.Id)]));

    void Apply(Guid creatureId, string direction)
    {
        if (Typed(creatureId) is { } amount)
        {
            Dispatcher.Dispatch(new HitPointsApplied(creatureId, amount, direction));
        }
    }
}
