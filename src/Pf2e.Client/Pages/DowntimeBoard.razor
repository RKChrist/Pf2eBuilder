@page "/campaign/downtime"
@inherits FluxorComponent
@inject IState<CampaignState> Store
@inject IState<ConditionsState> ConditionsStore
@inject IState<ExplorationState> ExplorationStore
@inject IDispatcher Dispatcher
@inject NavigationManager Navigation

<PageTitle>Downtime</PageTitle>

<CampaignPage Heading="Downtime" Context="table">
    <div class="downtime">
        <Card Class="downtime__card">
            <ChildContent>
                <SectionHead Text="What everyone is spending the day on" Glyph="sun">
                    <Aside>
                        <span class="clock" role="status">
                            <Icon Name="sun" />
                            <span class="clock__label">Day</span>
                            <span class="clock__value">@table.Day</span>
                        </span>
                    </Aside>
                </SectionHead>

                @foreach (var character in table.Characters)
                {
                    <ActivityChooser Name="@character.Name"
                                     Options="Spending"
                                     Nothing="Nothing today"
                                     Chosen="@character.DowntimeActivity"
                                     Says="@ExplorationStore.Value.DowntimeNamed(character.DowntimeActivity)?.What"
                                     ChosenChanged="key => Dispatcher.Dispatch(
                                         new DowntimeActivityChosen(
                                             character.Id,
                                             key,
                                             key is null ? null : character.DowntimeTaskLevel ?? character.Level))">
                        <Numbers>
                            @* A day's work is a skill roll, so whatever is on the character
                               belongs on the page that chooses the work. *@
                            <StatStrip Character="character" ShowAttacks="false" />
                        </Numbers>
                        <ChildContent>
                        @if (ExplorationStore.Value.DowntimeNamed(character.DowntimeActivity) is { } chosen)
                        {
                            @* The task level and the DC it comes to, side by side. Picking a task
                               is choosing how hard it is, and the DC is the only reason the
                               number matters, so the two belong on one line. *@
                            <div class="spending__task">
                                <div class="spending__level">
                                    <span class="spending__level-label">Task level</span>
                                    <NumberStepper Label="@($"Task level for {character.Name}")"
                                                   Min="0"
                                                   Max="25"
                                                   Value="character.DowntimeTaskLevel ?? character.Level"
                                                   ValueChanged="level => Dispatcher.Dispatch(
                                                       new DowntimeActivityChosen(character.Id, chosen.Key, level))" />
                                </div>

                                @if (character.DowntimeDc is { } dc)
                                {
                                    <p class="spending__dc">
                                        <span class="spending__dc-label">DC</span>
                                        <span class="spending__dc-value">@dc</span>
                                        @if (chosen.Skill is { } skill)
                                        {
                                            <span class="spending__skill">
                                                @skill @Signed(SkillOf(character, skill))
                                            </span>
                                        }
                                    </p>
                                }
                            </div>
                        }
                        </ChildContent>
                    </ActivityChooser>
                }

                <ActivityGuide Options="Spending" Glyph="sun"
                               Title="What each of these does" />

                @if (table.Role == "Dm")
                {
                    <div class="downtime__turn">
                        <Button Class="downtime__next"
                                OnClick="() => Dispatcher.Dispatch(new DayAdvanced())">
                            <Icon Name="moon" Class="pf-icon--lead" />Next day
                        </Button>
                        <p class="downtime__next-says">
                            One activity per character per day, so the day turning clears what
                            everybody chose.
                        </p>
                    </div>
                }
            </ChildContent>
        </Card>
    </div>
</CampaignPage>

@code {
    static string Signed(int total) => SheetFormat.Signed(total);

    static int SkillOf(CharacterSheetView character, string skill) =>
        SheetFormat.SkillOf(character, skill);

    IReadOnlyList<ActivityChooser.Choice> Spending =>
        [.. ExplorationStore.Value.Downtime.Select(a => new ActivityChooser.Choice(a.Key, a.Name, a.What))];
}
