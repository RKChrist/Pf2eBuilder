@page "/conditions"
@inherits FluxorComponent
@inject IState<ConditionsState> Store
@inject IState<RulesBrowserState> Browser
@inject IDispatcher Dispatcher

<PageTitle>Conditions</PageTitle>

<header class="top">
    <h1 class="heading">Conditions</h1>
</header>

<RemoteView T="IReadOnlyList<ConditionSummary>" Data="Store.Value.Conditions">
    <Loading>
        <div class="pending">
            <Spinner ShowLabel="true" Label="Loading conditions" />
        </div>
    </Loading>
    <Failed Context="message">
        <div class="panel">
            <Card>
                <ErrorState Title="Could not load the conditions">
                    <ChildContent>@message</ChildContent>
                    <Action>
                        <Button Variant="ButtonVariant.Secondary" OnClick="Load">Try again</Button>
                    </Action>
                </ErrorState>
            </Card>
        </div>
    </Failed>
    <Loaded Context="conditions">
        <div class="preamble">
            <p>
                The @conditions.Count conditions this app can work out the numbers for, not the whole
                appendix. Ones that carry a value are shown at 1.
            </p>
            <p class="checked">@Checked(conditions)</p>
        </div>

        <div class="cards">
            @foreach (var condition in conditions)
            {
                <Card Title="@condition.Name">
                    <HeadContent>
                        @if (condition.HasValue)
                        {
                            <span class="valued">Takes a value</span>
                        }
                    </HeadContent>
                    <ChildContent>
                        <ul class="modifiers">
                            @foreach (var modifier in condition.Modifiers)
                            {
                                <li class="modifier">
                                    <ModifierValue Value="modifier.Value"
                                                   Kind="RuleDisplay.KindOf(modifier.Type)" />
                                    <span class="effect">to @string.Join(" and ", modifier.Applies)</span>
                                </li>
                            }
                        </ul>

                        <div class="foot">
                            @if (!condition.Verified)
                            {
                                <span class="unverified">
                                    <span class="glyph" aria-hidden="true">▲</span>
                                    Unverified
                                </span>
                            }
                            @if (condition.SourceUrl is { } url)
                            {
                                <a class="archives" href="@url" target="_blank" rel="noopener">
                                    Archives of Nethys
                                </a>
                            }
                        </div>
                    </ChildContent>
                </Card>
            }
        </div>
    </Loaded>
</RemoteView>

@code {
    protected override void OnInitialized()
    {
        base.OnInitialized();

        var owner = RuleCatalog.All.First(category => category.Route == RuleCatalog.ConditionsRoute).Group;
        if (Browser.Value.ActiveGroup != owner)
        {
            Dispatcher.Dispatch(new GroupSelected(owner));
        }

        if (Store.Value.Conditions is RemoteData<IReadOnlyList<ConditionSummary>>.NotAsked)
        {
            Load();
        }
    }

    void Load() => Dispatcher.Dispatch(new ConditionsRequested());

    static string Checked(IReadOnlyList<ConditionSummary> conditions) =>
        conditions.Count(condition => condition.Verified) switch
        {
            0 => "None of these tables has been checked against the printed rules yet.",
            var all when all == conditions.Count => "Every table here has been checked against the printed rules.",
            var some => $"{some} of {conditions.Count} tables have been checked against the printed rules.",
        };
}
