@page "/campaign"
@page "/party"
@inherits FluxorComponent
@inject IState<CampaignState> Store
@inject IState<ConditionsState> ConditionsStore
@inject IState<ExplorationState> ExplorationStore
@inject IDispatcher Dispatcher
@inject NavigationManager Navigation

<PageTitle>Campaign</PageTitle>

@* The party. Everybody's card, what each of them is carrying, and the form that puts somebody
   new on the table. The modes have pages of their own; this is the one they all come back to. *@
<CampaignPage Heading="Campaign" Context="table">
    @if (table.Characters.Count == 0)
    {
        <div class="panel">
            <Card>
                <EmptyState Title="Nobody is in this campaign yet">
                    <ChildContent>
                        Read out the code @State.Code so everyone joins the same campaign, then paste a
                        character export below to put somebody on it.
                    </ChildContent>
                </EmptyState>
            </Card>
        </div>
    }
    else
    {
        <div class="party">
            @foreach (var character in table.Characters)
            {
                <Card Class="character">
                    <ChildContent>
                        <div class="identity">
                            <h2 class="character__name">@character.Name</h2>
                            <p class="lineage">
                                Level @character.Level @character.AncestryName @character.ClassName
                            </p>
                        </div>

                        <div class="stats">
                            @foreach (var line in StatSlots.For(character))
                            {
                                <button type="button"
                                        class="stat"
                                        aria-label="@line.Name"
                                        @onclick="() => Open(character.Id, StatAddress.Fixed(line.Slot))">
                                    <span class="stat__label">@line.Short</span>
                                    <span class="stat__value">@(line.IsRoll ? Signed(line.Of(character)!.Total) : line.Of(character)!.Total.ToString())</span>
                                </button>
                            }
                        </div>

                        @if (character.Attacks.Count > 0)
                        {
                            <h3 class="rolls__heading">Attacks</h3>
                            <div class="rolls" aria-label="Attacks">
                                @foreach (var roll in character.Attacks)
                                {
                                    <button type="button"
                                            class="roll"
                                            @onclick="() => Open(character.Id, StatAddress.Weapon(roll.Name))">
                                        <span class="roll__name">@roll.Name</span>
                                        <span class="roll__value">@Signed(roll.Value.Total)</span>
                                    </button>
                                }
                            </div>
                        }

                        @if (character.Skills.Count > 0)
                        {
                            @* Trained and better in the open, the rest behind a summary. A
                               player reads the four they are good at; a DM occasionally asks
                               for an untrained Nature, and that has to stay reachable. *@
                            <h3 class="rolls__heading">Skills</h3>
                            <div class="rolls" aria-label="Trained skills">
                                @foreach (var roll in Trained(character))
                                {
                                    <button type="button"
                                            class="roll"
                                            @onclick="() => Open(character.Id, StatAddress.Skilled(roll.Name))">
                                        <span class="roll__name">@roll.Name</span>
                                        <span class="roll__value">@Signed(roll.Value.Total)</span>
                                    </button>
                                }
                            </div>

                            @if (Untrained(character).Count > 0)
                            {
                                <details class="rest">
                                    <summary class="rest__summary">Untrained skills</summary>
                            <div class="rolls" aria-label="Untrained skills">
                                @foreach (var roll in Untrained(character))
                                {
                                    <button type="button"
                                            class="roll"
                                            @onclick="() => Open(character.Id, StatAddress.Skilled(roll.Name))">
                                        <span class="roll__name">@roll.Name</span>
                                        <span class="roll__value">@Signed(roll.Value.Total)</span>
                                    </button>
                                }
                            </div>
                                </details>
                            }
                        }

                        <div class="vitals">
                            <p class="hp">
                                <span class="hp__label">Hit points</span>
                                <span class="hp__current">@character.CurrentHitPoints</span>
                                <span class="hp__of" aria-hidden="true">/</span>
                                <span class="hp__max">@character.MaxHitPoints</span>
                            </p>
                            @* The primary control, because the stepper alone made losing a hundred
                               hit points a hundred taps and a hundred round trips, which is unusable
                               in the moment it exists for. The keypad comes up on a phone. *@
                            <div class="amount">
                                <TextInput Class="amount__field"
                                           Label="@($"Hit points to apply to {character.Name}")"
                                           InputMode="numeric"
                                           Placeholder="0"
                                           Value="@State.HitPointDraft(character.Id)"
                                           ValueChanged="typed => Dispatcher.Dispatch(
                                               new HitPointDraftChanged(character.Id, typed ?? string.Empty))" />
                                <Button Variant="ButtonVariant.Secondary"
                                        Disabled="@(Typed(character.Id) is null)"
                                        OnClick='() => Apply(character.Id, "Damage")'>
                                    Damage
                                </Button>
                                <Button Variant="ButtonVariant.Secondary"
                                        Disabled="@(Typed(character.Id) is null)"
                                        OnClick='() => Apply(character.Id, "Heal")'>
                                    Heal
                                </Button>
                            </div>

                            @* The stepper stays for the nudge case. Zero is the resting value, so the
                               minus button is live without a tap to arm it and the card never shows a
                               total the server has not sent back. *@
                            <NumberStepper Class="delta"
                                           Label="@($"Change {character.Name}'s hit points")"
                                           DecrementLabel="@($"{character.Name} takes a point of damage")"
                                           IncrementLabel="@($"{character.Name} recovers a hit point")"
                                           Min="-99"
                                           Max="99"
                                           Value="0"
                                           ValueChanged="delta => Nudge(character.Id, delta)" />
                        </div>

                        @if (character.Effects.Count > 0)
                        {
                            <div class="chips">
                                @foreach (var effect in character.Effects)
                                {
                                    <TraitChip>@Named(effect)</TraitChip>
                                }
                            </div>
                        }

                        <div class="acts">
                            <Button Variant="ButtonVariant.Secondary"
                                    OnClick="() => Dispatcher.Dispatch(new PickerOpened(character.Id))">
                                Effects
                            </Button>
                            @* A level-up between sessions, a number Pathbuilder got wrong and a
                               homebrew ancestry all need this, and re-exporting is not always
                               possible at the table. *@
                            <Button Variant="ButtonVariant.Secondary"
                                    OnClick="() => Dispatcher.Dispatch(new EditorOpened(character.Id))">
                                Edit
                            </Button>
                        </div>
                    </ChildContent>
                </Card>
            }
        </div>
    }

    @if (table.Characters.Any(c => c.Feats.Count > 0 || c.Spells.Count > 0))
    {
        <div class="reference">
            <Card Class="reference__card">
                <ChildContent>
                    <h2 class="reference__heading">What the party has</h2>

                    @foreach (var character in table.Characters.Where(c => c.Feats.Count > 0 || c.Spells.Count > 0))
                    {
                        <details class="owned" data-owned="@character.Id">
                            <summary class="owned__summary">
                                <span class="owned__name">@character.Name</span>
                                <span class="owned__count">
                                    @character.Feats.Count feats, @character.Spells.Count spells
                                </span>
                            </summary>

                            @foreach (var group in Owned(character))
                            {
                                <h3 class="owned__kind">@group.Heading</h3>
                                <div class="owned__entries">
                                    @foreach (var entry in group.Entries)
                                    {
                                        @if (entry.RuleId is { } id)
                                        {
                                            <a class="owned__entry" href="@Navigation.Rule(id)">
                                                <span class="owned__entry-name">@entry.Name</span>
                                                <span class="owned__entry-kind">@entry.Kind</span>
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="owned__entry owned__entry--unknown">
                                                <span class="owned__entry-name">@entry.Name</span>
                                                <span class="owned__entry-kind">@entry.Kind · no record under this name</span>
                                            </span>
                                        }
                                    }
                                </div>
                            }
                        </details>
                    }
                </ChildContent>
            </Card>
        </div>
    }

    <div class="panel import">
        <Card Title="Put a character in the campaign">
            <ChildContent>
                <TextArea Label="Pathbuilder export"
                          Rows="5"
                          Placeholder="Paste the export here"
                          Hint="In Pathbuilder, choose Export JSON. Paste the JSON itself, or open pathbuilder2e.com/json.php?id=NNNNNN with the number it gives you and copy the page."
                          Error="@State.ImportError"
                          Value="@State.PasteDraft"
                          ValueChanged="paste => Dispatcher.Dispatch(new PasteDraftChanged(paste ?? string.Empty))" />
                <Button Variant="ButtonVariant.Primary"
                        Busy="State.Importing"
                        Disabled="@(State.PasteDraft.Trim().Length == 0)"
                        OnClick="() => Dispatcher.Dispatch(new ImportRequested())">
                    Import
                </Button>
            </ChildContent>
        </Card>
    </div>
</CampaignPage>

<BottomSheet Open="@(Opened is not null)"
             Title="@BreakdownTitle"
             OnClose="() => Dispatcher.Dispatch(new BreakdownClosed())">
    @if (Opened is { } open && Character(open.CharacterId) is { } character
        && open.Stat.In(character) is { } breakdown)
    {

        <div class="breakdown">
            <p class="breakdown__base">
                <span class="breakdown__what">Before any effect</span>
                <span class="breakdown__number">@breakdown.Base</span>
            </p>

            <h3 class="breakdown__heading">Applied</h3>
            <ul class="breakdown__applied">
                @foreach (var modifier in breakdown.Applied)
                {
                    <li class="row">
                        <ModifierValue Value="modifier.Value" Kind="RuleDisplay.KindOf(modifier.Type)" />
                        <span class="row__source">@modifier.Source</span>
                        <span class="row__applies">to @string.Join(" and ", modifier.Applies)</span>
                    </li>
                }
                @if (breakdown.Applied.Count == 0)
                {
                    <li class="row row--none">Nothing is changing this number.</li>
                }
            </ul>

            <h3 class="breakdown__heading">Suppressed</h3>
            <ul class="breakdown__suppressed">
                @foreach (var suppressed in breakdown.Suppressed)
                {
                    <li class="row row--off">
                        <ModifierValue Value="suppressed.Modifier.Value"
                                       Kind="RuleDisplay.KindOf(suppressed.Modifier.Type)" />
                        <span class="row__source">@suppressed.Modifier.Source</span>
                        <span class="row__reason">@suppressed.Reason</span>
                    </li>
                }
                @if (breakdown.Suppressed.Count == 0)
                {
                    <li class="row row--none">The stacking rule is holding nothing back.</li>
                }
            </ul>
        </div>
    }
</BottomSheet>

<BottomSheet Open="@(Picking is not null)"
             Title="Effects"
             OnClose="() => Dispatcher.Dispatch(new PickerClosed())">
    @if (Picking is { } picker && Character(picker.CharacterId) is { } character)
    {
        <SegmentedControl Class="picker__arms"
                          TValue="PickerArm"
                          Label="Where the effect comes from"
                          Options="Arms"
                          Value="picker.Arm"
                          ValueChanged="arm => Dispatcher.Dispatch(new ArmSelected(arm))" />

        <div class="applied">
            @foreach (var effect in character.Effects)
            {
                <div class="applied__row" data-effect="@effect.Id">
                    <span class="applied__name">@Named(effect)</span>
                    <Button Variant="ButtonVariant.Quiet"
                            OnClick="() => Dispatcher.Dispatch(new EffectSet(character.Id, effect.Id, null))">
                        Remove
                    </Button>
                </div>
            }
            @if (character.Effects.Count == 0)
            {
                <p class="applied__none">Nothing is on @character.Name yet.</p>
            }
        </div>

        @switch (picker.Arm)
        {
            case PickerArm.Conditions:
                <RemoteView T="IReadOnlyList<ConditionSummary>" Data="ConditionsStore.Value.Conditions">
                    <Loading>
                        <div class="pending">
                            <Spinner ShowLabel="true" Label="Loading conditions" />
                        </div>
                    </Loading>
                    <Failed Context="message">
                        <ErrorState Title="Could not load the conditions">
                            <ChildContent>@message</ChildContent>
                            <Action>
                                <Button Variant="ButtonVariant.Secondary"
                                        OnClick="() => Dispatcher.Dispatch(new ConditionsRequested())">
                                    Try again
                                </Button>
                            </Action>
                        </ErrorState>
                    </Failed>
                    <Loaded Context="effects">
                        @* Buffs first. A player reaches for this sheet because something good just
                           happened to them far more often than because something bad did. *@
                        @foreach (var group in Grouped(effects))
                        {
                            <h3 class="effects__kind">@group.Heading</h3>
                            <div class="conditions">
                                @foreach (var condition in group.Effects)
                                {
                                    <div class="condition" data-condition="@condition.Key">
                                        <span class="condition__name">
                                            @condition.Name
                                            @if (Reads(condition) is { Length: > 0 } reads)
                                            {
                                                <span class="condition__reads">@reads</span>
                                            }
                                        </span>
                                        @if (condition.HasValue)
                                        {
                                            <NumberStepper Label="@condition.Name"
                                                           Min="0"
                                                           Max="10"
                                                           Value="Held(character, condition.Key)?.Value ?? 0"
                                                           ValueChanged="value => Seed(character, condition, value)" />
                                        }
                                        else
                                        {
                                            <Switch Checked="@(Held(character, condition.Key) is not null)"
                                                    CheckedChanged="on => Seed(character, condition, on ? 1 : 0)">
                                                <span class="visually-hidden">@condition.Name</span>
                                            </Switch>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </Loaded>
                </RemoteView>
                break;

            case PickerArm.Rules:
                <div class="rules">
                    <SearchField Value="@picker.Query"
                                 ValueChanged="query => Dispatcher.Dispatch(new RuleQueryChanged(query ?? string.Empty))"
                                 Placeholder="Search every rule"
                                 Label="Search the rules for an effect" />

                    <RemoteView T="RuleSearchResult" Data="picker.Found">
                        <NotAsked>
                            <p class="hint">
                                The same records the browser shows. Tap one to apply what it states.
                            </p>
                        </NotAsked>
                        <Loading>
                            <div class="pending">
                                <Spinner ShowLabel="true" Label="Searching" />
                            </div>
                        </Loading>
                        <Failed Context="message">
                            <ErrorState Title="Could not search the rules">
                                <ChildContent>@message</ChildContent>
                            </ErrorState>
                        </Failed>
                        <Loaded Context="found">
                            @if (found.Items.Count == 0)
                            {
                                <p class="hint">Nothing matches that.</p>
                            }
                            else
                            {
                                <Card>
                                    <ListContent>
                                        @foreach (var rule in found.Items)
                                        {
                                            <ListRow Title="@rule.Name"
                                                     Meta="@Says(rule)"
                                                     OnClick="() => Take(character, rule)" />
                                        }
                                    </ListContent>
                                </Card>
                            }
                        </Loaded>
                    </RemoteView>
                </div>
                break;

            case PickerArm.Custom:
                <div class="custom">
                    <TextInput Label="Name"
                               Placeholder="Courageous Anthem"
                               Value="@State.Draft.Name"
                               ValueChanged="name => Redraft(State.Draft with { Name = name ?? string.Empty })" />

                    <SegmentedControl Class="custom__sign"
                                      TValue="bool"
                                      Label="Bonus or penalty"
                                      Options="Signs"
                                      Value="State.Draft.Bonus"
                                      ValueChanged="bonus => Redraft(State.Draft with { Bonus = bonus })" />

                    <NumberStepper Class="custom__value"
                                   Label="How much"
                                   Min="1"
                                   Max="10"
                                   Value="State.Draft.Value"
                                   ValueChanged="value => Redraft(State.Draft with { Value = value })" />

                    <Select Class="custom__type"
                            TValue="string"
                            Label="Type"
                            Options="Types"
                            Value="@State.Draft.Type"
                            ValueChanged="type => Redraft(State.Draft with { Type = type ?? Types[0].Value })" />

                    <Select Class="custom__applies"
                            TValue="string"
                            Label="Applies to"
                            Options="Targets"
                            Value="@State.Draft.Applies"
                            ValueChanged="applies => Redraft(State.Draft with { Applies = applies ?? Targets[0].Value })" />

                    <Button Variant="ButtonVariant.Primary"
                            Disabled="@(State.Draft.Name.Trim().Length == 0)"
                            OnClick="() => Dispatcher.Dispatch(new CustomEffectAdded(character.Id, State.Draft))">
                        Add
                    </Button>
                </div>
                break;
        }
    }
</BottomSheet>

<BottomSheet Open="@(State.Editing is not null)"
             Title="@(State.Editing is { } e ? $"Edit {e.Draft.Name}" : "Edit")"
             OnClose="() => Dispatcher.Dispatch(new EditorClosed())">
    @if (State.Editing is { } editor)
    {
        var draft = editor.Draft;

        <div class="editor">
            @if (editor.Trouble is { } wrong)
            {
                <p class="trouble" role="alert">@wrong</p>
            }

            <div class="editor__grid">
                <TextInput Label="Name" Value="@draft.Name"
                           ValueChanged="v => Edit(draft with { Name = v ?? string.Empty })" />
                <div class="editor__field">
                    <span class="editor__label" id="edit-Level">Level</span>
                    <NumberStepper Label="Level" Min="1" Max="20" Value="draft.Level"
                                   ValueChanged="v => Edit(draft with { Level = v })" />
                </div>
                <TextInput Label="Class" Value="@draft.ClassName"
                           ValueChanged="v => Edit(draft with { ClassName = v ?? string.Empty })" />
                <TextInput Label="Ancestry" Value="@draft.AncestryName"
                           ValueChanged="v => Edit(draft with { AncestryName = v ?? string.Empty })" />
            </div>

            <h3 class="editor__heading">Attributes</h3>
            @* Modifiers, not scores. The sheet says Dexterity +3, so this says +3 too rather
               than making somebody convert 16 in their head to mean the same thing. *@
            <div class="editor__grid">
                <div class="editor__field">
                    <span class="editor__label" id="edit-Strength">Str</span>
                    <NumberStepper Label="Str" Min="-5" Max="10" Value="draft.Strength"
                                   ValueChanged="v => Edit(draft with { Strength = v })" />
                </div>
                <div class="editor__field">
                    <span class="editor__label" id="edit-Dexterity">Dex</span>
                    <NumberStepper Label="Dex" Min="-5" Max="10" Value="draft.Dexterity"
                                   ValueChanged="v => Edit(draft with { Dexterity = v })" />
                </div>
                <div class="editor__field">
                    <span class="editor__label" id="edit-Constitution">Con</span>
                    <NumberStepper Label="Con" Min="-5" Max="10" Value="draft.Constitution"
                                   ValueChanged="v => Edit(draft with { Constitution = v })" />
                </div>
                <div class="editor__field">
                    <span class="editor__label" id="edit-Intelligence">Int</span>
                    <NumberStepper Label="Int" Min="-5" Max="10" Value="draft.Intelligence"
                                   ValueChanged="v => Edit(draft with { Intelligence = v })" />
                </div>
                <div class="editor__field">
                    <span class="editor__label" id="edit-Wisdom">Wis</span>
                    <NumberStepper Label="Wis" Min="-5" Max="10" Value="draft.Wisdom"
                                   ValueChanged="v => Edit(draft with { Wisdom = v })" />
                </div>
                <div class="editor__field">
                    <span class="editor__label" id="edit-Charisma">Cha</span>
                    <NumberStepper Label="Cha" Min="-5" Max="10" Value="draft.Charisma"
                                   ValueChanged="v => Edit(draft with { Charisma = v })" />
                </div>
            </div>

            <h3 class="editor__heading">Proficiencies</h3>
            <div class="editor__grid">
                <Select TValue="string" Label="Key attribute" Options="CharacterEdits.Attributes"
                        Value="@draft.KeyAttribute"
                        ValueChanged="v => Edit(draft with { KeyAttribute = v ?? draft.KeyAttribute })" />
                <Select TValue="string" Label="Fortitude" Options="CharacterEdits.Ranks"
                        Value="@draft.Fortitude"
                        ValueChanged="v => Edit(draft with { Fortitude = v ?? draft.Fortitude })" />
                <Select TValue="string" Label="Reflex" Options="CharacterEdits.Ranks"
                        Value="@draft.Reflex"
                        ValueChanged="v => Edit(draft with { Reflex = v ?? draft.Reflex })" />
                <Select TValue="string" Label="Will" Options="CharacterEdits.Ranks"
                        Value="@draft.Will"
                        ValueChanged="v => Edit(draft with { Will = v ?? draft.Will })" />
                <Select TValue="string" Label="Perception" Options="CharacterEdits.Ranks"
                        Value="@draft.Perception"
                        ValueChanged="v => Edit(draft with { Perception = v ?? draft.Perception })" />
                <Select TValue="string" Label="Class DC" Options="CharacterEdits.Ranks"
                        Value="@draft.ClassDc"
                        ValueChanged="v => Edit(draft with { ClassDc = v ?? draft.ClassDc })" />
            </div>

            <h3 class="editor__heading">Armour and hit points</h3>
            <div class="editor__grid">
                <TextInput Label="Armour" Value="@draft.ArmorName"
                           ValueChanged="v => Edit(draft with { ArmorName = v ?? string.Empty })" />
                <Select TValue="string" Label="Armour proficiency" Options="CharacterEdits.Ranks"
                        Value="@draft.ArmorRank"
                        ValueChanged="v => Edit(draft with { ArmorRank = v ?? draft.ArmorRank })" />
                <div class="editor__field">
                    <span class="editor__label" id="edit-ArmorItemBonus">Armour bonus</span>
                    <NumberStepper Label="Armour bonus" Min="0" Max="10" Value="draft.ArmorItemBonus"
                                   ValueChanged="v => Edit(draft with { ArmorItemBonus = v })" />
                </div>
                <div class="editor__field">
                    <span class="editor__label">Dex cap</span>
                    <NumberStepper Label="Dex cap" Min="0" Max="10" Value="draft.ArmorDexCap ?? 10"
                                   ValueChanged="v => Edit(draft with { ArmorDexCap = v })" />
                </div>
                <div class="editor__field">
                    <span class="editor__label" id="edit-AncestryHitPoints">Ancestry HP</span>
                    <NumberStepper Label="Ancestry HP" Min="0" Max="20" Value="draft.AncestryHitPoints"
                                   ValueChanged="v => Edit(draft with { AncestryHitPoints = v })" />
                </div>
                <div class="editor__field">
                    <span class="editor__label" id="edit-ClassHitPoints">Class HP</span>
                    <NumberStepper Label="Class HP" Min="0" Max="20" Value="draft.ClassHitPoints"
                                   ValueChanged="v => Edit(draft with { ClassHitPoints = v })" />
                </div>
            </div>

            <div class="editor__acts">
                <Button Variant="ButtonVariant.Secondary"
                        OnClick="() => Dispatcher.Dispatch(new EditorClosed())">
                    Cancel
                </Button>
                <Button Disabled="editor.Saving"
                        OnClick="() => Dispatcher.Dispatch(new EditSubmitted())">
                    @if (editor.Saving)
                    {
                        <text>Saving</text>
                    }
                    else
                    {
                        <text>Save</text>
                    }
                </Button>
            </div>
        </div>
    }
</BottomSheet>

@code {
    void Edit(CharacterBuildEdit draft) => Dispatcher.Dispatch(new EditDraftChanged(draft));

    sealed record OwnedGroup(string Heading, IReadOnlyList<SheetEntryView> Entries);

    /// <summary>Feats by the kind the export called them, then spells by rank, each in the
    /// order a character sheet lists them rather than alphabetically.</summary>
    static IReadOnlyList<OwnedGroup> Owned(CharacterSheetView character) =>
    [
        .. character.Feats
            .GroupBy(feat => feat.Kind)
            .OrderBy(group => group.Min(feat => feat.Level))
            .Select(group => new OwnedGroup(group.Key, [.. group.OrderBy(feat => feat.Level)])),
        .. character.Spells
            .GroupBy(spell => spell.Kind)
            .OrderBy(group => group.Key == "Cantrip" ? 0 : group.Min(spell => spell.Level))
            .Select(group => new OwnedGroup(
                group.Key,
                [.. group.OrderBy(spell => spell.Name, StringComparer.OrdinalIgnoreCase)])),
    ];

    static readonly IReadOnlyList<ChoiceOption<PickerArm>> Arms =
    [
        new(PickerArm.Conditions, "Effects"),
        new(PickerArm.Rules, "Rules"),
        new(PickerArm.Custom, "Custom"),
    ];

    sealed record EffectGroup(string Heading, IReadOnlyList<ConditionSummary> Effects);

    static IReadOnlyList<EffectGroup> Grouped(IReadOnlyList<ConditionSummary> effects) =>
    [
        .. new[] { ("Buff", "Buffs"), ("Condition", "Conditions") }
            .Select(kind => new EffectGroup(kind.Item2,
                [.. effects.Where(e => e.Kind == kind.Item1).OrderBy(e => e.Name, StringComparer.Ordinal)]))
            .Where(group => group.Effects.Count > 0),
    ];

    /// <summary>What the effect does, in the words of the breakdown it will appear in, so nobody
    /// has to open the rule to find out whether an anthem helps their armour class.</summary>
    static string Reads(ConditionSummary effect) =>
        string.Join("; ", effect.Modifiers.Select(m =>
            $"{(m.Value > 0 ? "+" : string.Empty)}{m.Value} {m.Type.ToLowerInvariant()} to {string.Join(", ", m.Applies)}"));

    static readonly IReadOnlyList<ChoiceOption<bool>> Signs =
    [
        new(true, "Bonus"),
        new(false, "Penalty"),
    ];

    static readonly IReadOnlyList<ChoiceOption<string>> Types =
    [
        new("Status", "Status"),
        new("Circumstance", "Circumstance"),
        new("Item", "Item"),
        new("Untyped", "Untyped"),
    ];

    static readonly IReadOnlyList<ChoiceOption<string>> Targets =
        [.. EffectVocabulary.All.Select(choice => new ChoiceOption<string>(choice.Token, choice.Label))];

    CampaignState State => Store.Value;

    OpenBreakdown? Opened => State.Breakdown;

    EffectPicker? Picking => State.Picker;

    string BreakdownTitle =>
        Opened is { } open && Character(open.CharacterId) is { } character
        && open.Stat.In(character) is { } breakdown
            ? $"{open.Stat.Label} {breakdown.Total}"
            : "Breakdown";
    CharacterSheetView? Character(Guid id) =>
        State.Campaign is RemoteData<CampaignView>.Loaded loaded
            ? loaded.Value.Characters.FirstOrDefault(character => character.Id == id)
            : null;

    static ActiveEffectView? Held(CharacterSheetView character, string key) =>
        character.Effects.FirstOrDefault(effect =>
            effect.Kind == "Seeded" && string.Equals(effect.Key, key, StringComparison.OrdinalIgnoreCase));

    static string Named(ActiveEffectView effect) =>
        effect.HasValue && effect.Value > 0 ? $"{effect.Name} {effect.Value}" : effect.Name;

    static RenderFragment Says(RuleSummary rule) => @<text>
        @if (rule.HasModifiers)
        {
            <span class="states">States a modifier this app can apply</span>
        }
        else
        {
            <span class="states states--none">States no modifier this app can apply yet. Tap to write it yourself.</span>
        }
    </text>;

    void Open(Guid characterId, StatAddress address) =>
        Dispatcher.Dispatch(new BreakdownOpened(characterId, address));

    /// <summary>A roll reads +14 or -1, never 14, because the number is added to a die.</summary>
    static string Signed(int total) => total >= 0 ? $"+{total}" : total.ToString();

    static IReadOnlyList<NamedBreakdownView> Trained(CharacterSheetView character) =>
        [.. character.Skills.Where(skill => skill.Rank != nameof(ProficiencyRank.Untrained))];

    static IReadOnlyList<NamedBreakdownView> Untrained(CharacterSheetView character) =>
        [.. character.Skills.Where(skill => skill.Rank == nameof(ProficiencyRank.Untrained))];

    void Nudge(Guid characterId, int delta) =>
        Dispatcher.Dispatch(new HitPointsNudged(characterId, delta));

    /// <summary>Null for anything that is not a number a table would apply, which is what leaves
    /// both buttons disabled rather than sending a request the server will refuse.</summary>
    int? Typed(Guid characterId) =>
        int.TryParse(State.HitPointDraft(characterId), out var amount) && amount is > 0 and <= 999
            ? amount
            : null;

    void Apply(Guid characterId, string direction)
    {
        if (Typed(characterId) is { } amount)
        {
            Dispatcher.Dispatch(new HitPointsApplied(characterId, amount, direction));
        }
    }

    void Redraft(EffectDraft draft) => Dispatcher.Dispatch(new DraftChanged(draft));

    void Take(CharacterSheetView character, RuleSummary rule)
    {
        if (rule.HasModifiers)
        {
            Dispatcher.Dispatch(new RuleEffectRequested(character.Id, rule.Id, rule.Name));
            return;
        }

        Dispatcher.Dispatch(new RuleDeclined(rule.Name));
    }

    /// <summary>A seeded effect reuses whatever slot it already holds, so raising clumsy from 1 to
    /// 2 is the same effect rather than a second one.</summary>
    void Seed(CharacterSheetView character, ConditionSummary condition, int value)
    {
        var slot = Held(character, condition.Key)?.Id ?? Guid.NewGuid();
        var effect = value <= 0
            ? null
            : new EffectSpec(
                condition.Name,
                "Seeded",
                condition.Key,
                condition.HasValue ? value : 0,
                null,
                []);

        Dispatcher.Dispatch(new EffectSet(character.Id, slot, effect));
    }
}
