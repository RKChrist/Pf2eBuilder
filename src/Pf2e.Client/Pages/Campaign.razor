@page "/campaign"
@page "/party"
@inherits FluxorComponent
@inject IState<CampaignState> Store
@inject IState<ConditionsState> ConditionsStore
@inject IState<ExplorationState> ExplorationStore
@inject IDispatcher Dispatcher
@inject NavigationManager Navigation

<PageTitle>Campaign</PageTitle>

@* The party. Everybody's card, what each of them is carrying, and the form that puts somebody
   new on the table. The modes have pages of their own; this is the one they all come back to. *@
<CampaignPage Heading="Campaign" Context="table">
    @if (table.Characters.Count == 0)
    {
        <div class="panel">
            <Card>
                <EmptyState Title="Nobody is in this campaign yet">
                    <ChildContent>
                        Read out the code @State.Code so everyone joins the same campaign, then paste a
                        character export below to put somebody on it.
                    </ChildContent>
                </EmptyState>
            </Card>
        </div>
    }
    else
    {
        <div class="party">
            @foreach (var character in table.Characters)
            {
                <Card Class="character">
                    <ChildContent>
                        <div class="identity">
                            <h2 class="character__name">@character.Name</h2>
                            <p class="lineage">
                                Level @character.Level @character.AncestryName @character.ClassName
                            </p>
                        </div>

                        <div class="stats">
                            @foreach (var line in StatSlots.For(character))
                            {
                                var stat = line.Of(character)!;
                                var swing = stat.Swing;

                                <button type="button"
                                        class="stat"
                                        data-stat="@line.Short"
                                        data-moved="@(swing > 0 ? "up" : swing < 0 ? "down" : null)"
                                        aria-label="@Explains(character, line, stat)"
                                        @onclick="() => Open(character.Id, StatAddress.Fixed(line.Slot))">
                                    <span class="stat__label">@line.Short</span>
                                    <span class="stat__value">@(line.IsRoll ? Signed(stat.Total) : stat.Total.ToString())</span>
                                    @if (swing != 0)
                                    {
                                        <span class="stat__moved" data-moved="@(swing > 0 ? "up" : "down")">
                                            @(swing > 0 ? "+" : string.Empty)@swing
                                        </span>
                                    }
                                </button>
                            }
                        </div>

                        @if (character.Attacks.Count > 0)
                        {
                            <SectionHead Text="Attacks" Level="3" Class="pf-section--sub" />
                            <div class="rolls" aria-label="Attacks">
                                @foreach (var roll in character.Attacks)
                                {
                                    <button type="button"
                                            class="roll"
                                            @onclick="() => Open(character.Id, StatAddress.Weapon(roll.Name))">
                                        <span class="roll__name">@roll.Name</span>
                                        <span class="roll__value">@Signed(roll.Value.Total)</span>
                                    </button>
                                }
                            </div>
                        }

                        @if (character.Skills.Count > 0)
                        {
                            @* Trained and better in the open, the rest behind a summary. A
                               player reads the four they are good at; a DM occasionally asks
                               for an untrained Nature, and that has to stay reachable. *@
                            <SectionHead Text="Skills" Level="3" Class="pf-section--sub" />
                            <div class="rolls" aria-label="Trained skills">
                                @foreach (var roll in Trained(character))
                                {
                                    <button type="button"
                                            class="roll"
                                            @onclick="() => Open(character.Id, StatAddress.Skilled(roll.Name))">
                                        <span class="roll__name">@roll.Name</span>
                                        <span class="roll__value">@Signed(roll.Value.Total)</span>
                                    </button>
                                }
                            </div>

                            @if (Untrained(character).Count > 0)
                            {
                                <Disclosure Class="rest" Title="Untrained skills"
                                            Count="Untrained(character).Count">
                            <div class="rolls" aria-label="Untrained skills">
                                @foreach (var roll in Untrained(character))
                                {
                                    <button type="button"
                                            class="roll"
                                            @onclick="() => Open(character.Id, StatAddress.Skilled(roll.Name))">
                                        <span class="roll__name">@roll.Name</span>
                                        <span class="roll__value">@Signed(roll.Value.Total)</span>
                                    </button>
                                }
                            </div>
                                </Disclosure>
                            }
                        }

                        <div class="vitals">
                            <p class="hp">
                                <span class="hp__label">Hit points</span>
                                <span class="hp__current">@character.CurrentHitPoints</span>
                                <span class="hp__of" aria-hidden="true">/</span>
                                <span class="hp__max">@character.MaxHitPoints</span>
                            </p>
                            @* The primary control, because the stepper alone made losing a hundred
                               hit points a hundred taps and a hundred round trips, which is unusable
                               in the moment it exists for. The keypad comes up on a phone. *@
                            <div class="amount">
                                <TextInput Class="amount__field"
                                           Label="@($"Hit points to apply to {character.Name}")"
                                           InputMode="numeric"
                                           Placeholder="0"
                                           Value="@State.HitPointDraft(character.Id)"
                                           ValueChanged="typed => Dispatcher.Dispatch(
                                               new HitPointDraftChanged(character.Id, typed ?? string.Empty))" />
                                <Button Variant="ButtonVariant.Secondary"
                                        Disabled="@(Typed(character.Id) is null)"
                                        OnClick='() => Apply(character.Id, "Damage")'>
                                    Damage
                                </Button>
                                <Button Variant="ButtonVariant.Secondary"
                                        Disabled="@(Typed(character.Id) is null)"
                                        OnClick='() => Apply(character.Id, "Heal")'>
                                    Heal
                                </Button>
                            </div>
                        </div>

                        @if (character.Effects.Count > 0)
                        {
                            <div class="chips">
                                @foreach (var effect in character.Effects)
                                {
                                    <button type="button"
                                            class="chip"
                                            data-effect="@effect.Id"
                                            aria-label="@($"Remove {Named(effect)} from {character.Name}")"
                                            @onclick="() => Dispatcher.Dispatch(
                                                new EffectSet(EffectSubject.Character(character.Id), effect.Id, null))">
                                        <span class="chip__name">@Named(effect)</span>
                                        <Icon Name="close" Class="chip__off" />
                                    </button>
                                }
                            </div>
                        }

                        <div class="acts">
                            <Button Variant="ButtonVariant.Secondary"
                                    OnClick="() => Dispatcher.Dispatch(new PickerOpened(EffectSubject.Character(character.Id)))">
                                Effects
                            </Button>
                            @* A level-up between sessions, a number Pathbuilder got wrong and a
                               homebrew ancestry all need this, and re-exporting is not always
                               possible at the table. *@
                            <Button Variant="ButtonVariant.Secondary"
                                    OnClick="() => Dispatcher.Dispatch(new EditorOpened(character.Id))">
                                Edit
                            </Button>
                        </div>
                    </ChildContent>
                </Card>
            }
        </div>
    }

    @if (table.Characters.Any(c => c.Feats.Count > 0 || c.Spells.Count > 0))
    {
        <div class="reference">
            <Card Class="reference__card">
                <ChildContent>
                    <SectionHead Text="What the party has" Glyph="clipboard" />

                    @foreach (var character in table.Characters.Where(c => c.Feats.Count > 0 || c.Spells.Count > 0))
                    {
                        <Disclosure Class="owned" Glyph="person" data-owned="@character.Id">
                            <SummaryContent>
                                <span class="owned__name">@character.Name</span>
                                <span class="owned__count">
                                    @character.Feats.Count feats, @character.Spells.Count spells
                                </span>
                            </SummaryContent>
                            <ChildContent>

                            @foreach (var group in Owned(character))
                            {
                                <h3 class="owned__kind">@group.Heading</h3>
                                <div class="owned__entries">
                                    @foreach (var entry in group.Entries)
                                    {
                                        @if (entry.RuleId is { } id)
                                        {
                                            <a class="owned__entry" href="@Navigation.Rule(id)">
                                                <span class="owned__entry-name">@entry.Name</span>
                                                <span class="owned__entry-kind">@entry.Kind</span>
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="owned__entry owned__entry--unknown">
                                                <span class="owned__entry-name">@entry.Name</span>
                                                <span class="owned__entry-kind">@entry.Kind · no record under this name</span>
                                            </span>
                                        }
                                    }
                                </div>
                            }
                            </ChildContent>
                        </Disclosure>
                    }
                </ChildContent>
            </Card>
        </div>
    }

    <div class="panel import">
        <Card Title="Put a character in the campaign">
            <ChildContent>
                @* Two ways in, because the two builders people use export differently.
                   Pathbuilder gives you JSON you can copy. Wanderer's Guide only offers a
                   download, and its file is twelve megabytes, so "paste it" meant finding an
                   editor that would open twelve megabytes of JSON and selecting all of it. *@
                <div class="import__ways">
                    <label class="drop">
                        <InputFile class="visually-hidden drop__input"
                                   accept=".json,application/json"
                                   OnChange="Chosen" />
                        <span class="drop__face">
                            <Icon Name="upload" Class="drop__glyph" />
                            <span class="drop__lead">Choose a file</span>
                            <span class="drop__says">
                                The .json a builder downloaded. Pathbuilder or Wanderer's Guide.
                            </span>
                        </span>
                    </label>

                    @if (State.File is { } chosen)
                    {
                        <p class="drop__chosen">
                            <Icon Name="check" Class="drop__tick" />
                            <span class="drop__name">@chosen.Name</span>
                            <span class="drop__size">@Size(chosen.Bytes)</span>
                            <Button Variant="ButtonVariant.Quiet"
                                    OnClick="() => Dispatcher.Dispatch(new FileCleared())">
                                <Icon Name="close" Label="Use a different file" />
                            </Button>
                        </p>
                    }

                    <Disclosure Class="import__paste"
                                Title="Paste it instead"
                                Glyph="clipboard"
                                Open="@(State.File is null)">
                        <TextArea Label="Character export"
                                  Rows="5"
                                  Placeholder="Paste the export here"
                                  Hint="In Pathbuilder, choose Export JSON. Paste the JSON itself, or open pathbuilder2e.com/json.php?id=NNNNNN with the number it gives you and copy the page."
                                  Value="@State.PasteDraft"
                                  ValueChanged="paste => Dispatcher.Dispatch(new PasteDraftChanged(paste ?? string.Empty))" />
                    </Disclosure>
                </div>

                @if (State.ImportError is { } trouble)
                {
                    <p class="import__trouble" role="alert">
                        <Icon Name="warn" Class="pf-icon--lead" />@trouble
                    </p>
                }

                <Button Variant="ButtonVariant.Primary"
                        Class="import__go"
                        Busy="State.Importing"
                        Disabled="@(State.Offered.Trim().Length == 0)"
                        OnClick="() => Dispatcher.Dispatch(new ImportRequested())">
                    Import
                </Button>
            </ChildContent>
        </Card>
    </div>
</CampaignPage>

<CharacterEditorSheet />

@code {
    CampaignState State => Store.Value;

    sealed record OwnedGroup(string Heading, IReadOnlyList<SheetEntryView> Entries);

    /// <summary>Feats by the kind the export called them, then spells by rank, each in the
    /// order a character sheet lists them rather than alphabetically.</summary>
    static IReadOnlyList<OwnedGroup> Owned(CharacterSheetView character) =>
    [
        .. character.Feats
            .GroupBy(feat => feat.Kind)
            .OrderBy(group => group.Min(feat => feat.Level))
            .Select(group => new OwnedGroup(group.Key, [.. group.OrderBy(feat => feat.Level)])),
        .. character.Spells
            .GroupBy(spell => spell.Kind)
            .OrderBy(group => group.Key == "Cantrip" ? 0 : group.Min(spell => spell.Level))
            .Select(group => new OwnedGroup(
                group.Key,
                [.. group.OrderBy(spell => spell.Name, StringComparer.OrdinalIgnoreCase)])),
    ];

    static string Named(ActiveEffectView effect) => SheetFormat.Named(effect);

    /// <summary>What the box says aloud. The tint and the arrow say it on screen and say
    /// nothing to a screen reader, so the label carries it in words.</summary>
    static string Explains(CharacterSheetView character, StatLine line, BreakdownSummary stat)
    {
        var swing = stat.Swing;
        var written = line.IsRoll ? SheetFormat.Signed(stat.Total) : stat.Total.ToString();

        return swing == 0
            ? $"{line.Name} {written}. Nothing is changing it."
            : $"{line.Name} {written}, {Math.Abs(swing)} {(swing > 0 ? "up" : "down")} on its own.";
    }

    static string Signed(int total) => SheetFormat.Signed(total);

    static IReadOnlyList<NamedBreakdownView> Trained(CharacterSheetView character) =>
        SheetFormat.Trained(character);

    static IReadOnlyList<NamedBreakdownView> Untrained(CharacterSheetView character) =>
        SheetFormat.Untrained(character);

    void Open(Guid characterId, StatAddress address) =>
        Dispatcher.Dispatch(new BreakdownOpened(characterId, address));

    void Nudge(Guid characterId, int delta) =>
        Dispatcher.Dispatch(new HitPointsNudged(characterId, delta));

    int? Typed(Guid characterId) => SheetFormat.Typed(State.HitPointDraft(characterId));

    void Apply(Guid characterId, string direction)
    {
        if (Typed(characterId) is { } amount)
        {
            Dispatcher.Dispatch(new HitPointsApplied(characterId, amount, direction));
        }
    }

    /// <summary>The cap the server states, read from the one place that states it, so a file
    /// too big is refused here with a sentence rather than at the far end with a 413.</summary>
    const long Cap = 24 * 1024 * 1024;

    /// <summary>Read whole and held, not streamed into the paste box. The import wants the
    /// text in one piece and the box would re-render the party on every chunk.</summary>
    async Task Chosen(InputFileChangeEventArgs change)
    {
        var file = change.File;
        if (file is null)
        {
            return;
        }

        if (file.Size > Cap)
        {
            Dispatcher.Dispatch(new FileRejected(
                $"{file.Name} is {Size(file.Size)}. The largest an import takes is {Size(Cap)}."));
            return;
        }

        try
        {
            using var reading = new StreamReader(file.OpenReadStream(Cap));
            Dispatcher.Dispatch(new FileChosen(
                new ChosenFile(file.Name, file.Size, await reading.ReadToEndAsync())));
        }
        catch (IOException failure)
        {
            Dispatcher.Dispatch(new FileRejected($"Could not read {file.Name}. {failure.Message}"));
        }
    }

    /// <summary>Megabytes for anything a builder exports, because every one of them is one.</summary>
    static string Size(long bytes) =>
        bytes >= 1024 * 1024 ? $"{bytes / 1024d / 1024d:0.#} MB" : $"{Math.Max(1, bytes / 1024)} KB";
}
