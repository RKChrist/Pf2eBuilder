@page "/campaign"
@page "/party"
@inherits FluxorComponent
@inject IState<CampaignState> Store
@inject IState<ConditionsState> ConditionsStore
@inject IState<ExplorationState> ExplorationStore
@inject IState<RulesBrowserState> Browser
@inject IDispatcher Dispatcher
@inject NavigationManager Navigation

<PageTitle>Campaign</PageTitle>

<header class="top">
    <h1 class="heading">Campaign</h1>
    @if (State.Code.Length > 0)
    {
        <p class="code">
            <span class="code__label">Campaign</span>
            <span class="campaign-code">@State.Code</span>
        </p>
    }
</header>

<RemoteView T="CampaignView" Data="State.Campaign">
    <NotAsked>@Entrance</NotAsked>
    <Loading>
        <div class="pending">
            <Spinner ShowLabel="true" Label="Opening the campaign" />
        </div>
    </Loading>
    <Failed Context="message">
        <div class="panel">
            <Card>
                <ErrorState Title="Could not open that campaign">
                    <ChildContent>@message</ChildContent>
                </ErrorState>
            </Card>
        </div>
        @Entrance
    </Failed>
    <Loaded Context="table">
        @* The mode is the campaign's, not this screen's, so it reads the same on every phone at
           the table. A player sees which mode they are in and cannot change it; the server
           refuses them either way, and drawing a control that always fails is worse than
           drawing none. *@
        <div class="shell">
            @if (table.Role == "Dm")
            {
                <SegmentedControl TValue="string"
                                  Class="shell__modes"
                                  Label="Campaign mode"
                                  Options="Modes"
                                  Value="@table.Mode"
                                  ValueChanged="mode => Dispatcher.Dispatch(new ModeChangeRequested(mode))" />
            }
            else
            {
                <p class="shell__mode" role="status">@ModeName(table.Mode)</p>
            }

            <p class="shell__where" role="status">
                @if (table.Encounter is { Round: > 0 } fight)
                {
                    <span class="shell__round">Round @fight.Round</span>
                }
                @if (table.Role == "Dm")
                {
                    <span class="shell__dm">DM</span>
                }
            </p>
        </div>

        @if (table.Mode == "Encounter")
        {
            @Fight(table)
        }
        else if (table.Mode == "Exploration" && table.Characters.Count > 0)
        {
            @Exploring(table)
            @Attempts(table)
            @Camp(table)
        }
        else if (table.Mode == "Downtime" && table.Characters.Count > 0)
        {
            @Downtime(table)
        }

        @if (!State.Live)
        {
            <p class="offline" role="status">
                Changes other people make will not arrive until this page can reach the campaign.
            </p>
        }

        @if (State.ActionError is { } trouble)
        {
            <p class="trouble" role="alert">@trouble</p>
        }

        @if (table.Characters.Count == 0)
        {
            <div class="panel">
                <Card>
                    <EmptyState Title="Nobody is in this campaign yet">
                        <ChildContent>
                            Read out the code @State.Code so everyone joins the same campaign, then paste a
                            Pathbuilder export below to put a character on it.
                        </ChildContent>
                    </EmptyState>
                </Card>
            </div>
        }
        else
        {
            <div class="party">
                @foreach (var character in table.Characters)
                {
                    <Card Class="character">
                        <ChildContent>
                            <div class="identity">
                                <h2 class="character__name">@character.Name</h2>
                                <p class="lineage">
                                    Level @character.Level @character.AncestryName @character.ClassName
                                </p>
                            </div>

                            <div class="stats">
                                @foreach (var line in StatSlots.For(character))
                                {
                                    <button type="button"
                                            class="stat"
                                            aria-label="@line.Name"
                                            @onclick="() => Open(character.Id, StatAddress.Fixed(line.Slot))">
                                        <span class="stat__label">@line.Short</span>
                                        <span class="stat__value">@(line.IsRoll ? Signed(line.Of(character)!.Total) : line.Of(character)!.Total.ToString())</span>
                                    </button>
                                }
                            </div>

                            @if (character.Attacks.Count > 0)
                            {
                                <h3 class="rolls__heading">Attacks</h3>
                                <div class="rolls" aria-label="Attacks">
                                    @foreach (var roll in character.Attacks)
                                    {
                                        <button type="button"
                                                class="roll"
                                                @onclick="() => Open(character.Id, StatAddress.Weapon(roll.Name))">
                                            <span class="roll__name">@roll.Name</span>
                                            <span class="roll__value">@Signed(roll.Value.Total)</span>
                                        </button>
                                    }
                                </div>
                            }

                            @if (character.Skills.Count > 0)
                            {
                                @* Trained and better in the open, the rest behind a summary. A
                                   player reads the four they are good at; a DM occasionally asks
                                   for an untrained Nature, and that has to stay reachable. *@
                                <h3 class="rolls__heading">Skills</h3>
                                <div class="rolls" aria-label="Trained skills">
                                    @foreach (var roll in Trained(character))
                                    {
                                        <button type="button"
                                                class="roll"
                                                @onclick="() => Open(character.Id, StatAddress.Skilled(roll.Name))">
                                            <span class="roll__name">@roll.Name</span>
                                            <span class="roll__value">@Signed(roll.Value.Total)</span>
                                        </button>
                                    }
                                </div>

                                @if (Untrained(character).Count > 0)
                                {
                                    <details class="rest">
                                        <summary class="rest__summary">Untrained skills</summary>
                                <div class="rolls" aria-label="Untrained skills">
                                    @foreach (var roll in Untrained(character))
                                    {
                                        <button type="button"
                                                class="roll"
                                                @onclick="() => Open(character.Id, StatAddress.Skilled(roll.Name))">
                                            <span class="roll__name">@roll.Name</span>
                                            <span class="roll__value">@Signed(roll.Value.Total)</span>
                                        </button>
                                    }
                                </div>
                                    </details>
                                }
                            }

                            <div class="vitals">
                                <p class="hp">
                                    <span class="hp__label">Hit points</span>
                                    <span class="hp__current">@character.CurrentHitPoints</span>
                                    <span class="hp__of" aria-hidden="true">/</span>
                                    <span class="hp__max">@character.MaxHitPoints</span>
                                </p>
                                @* The primary control, because the stepper alone made losing a hundred
                                   hit points a hundred taps and a hundred round trips, which is unusable
                                   in the moment it exists for. The keypad comes up on a phone. *@
                                <div class="amount">
                                    <TextInput Class="amount__field"
                                               Label="@($"Hit points to apply to {character.Name}")"
                                               InputMode="numeric"
                                               Placeholder="0"
                                               Value="@State.HitPointDraft(character.Id)"
                                               ValueChanged="typed => Dispatcher.Dispatch(
                                                   new HitPointDraftChanged(character.Id, typed ?? string.Empty))" />
                                    <Button Variant="ButtonVariant.Secondary"
                                            Disabled="@(Typed(character.Id) is null)"
                                            OnClick='() => Apply(character.Id, "Damage")'>
                                        Damage
                                    </Button>
                                    <Button Variant="ButtonVariant.Secondary"
                                            Disabled="@(Typed(character.Id) is null)"
                                            OnClick='() => Apply(character.Id, "Heal")'>
                                        Heal
                                    </Button>
                                </div>

                                @* The stepper stays for the nudge case. Zero is the resting value, so the
                                   minus button is live without a tap to arm it and the card never shows a
                                   total the server has not sent back. *@
                                <NumberStepper Class="delta"
                                               Label="@($"Change {character.Name}'s hit points")"
                                               DecrementLabel="@($"{character.Name} takes a point of damage")"
                                               IncrementLabel="@($"{character.Name} recovers a hit point")"
                                               Min="-99"
                                               Max="99"
                                               Value="0"
                                               ValueChanged="delta => Nudge(character.Id, delta)" />
                            </div>

                            @if (character.Effects.Count > 0)
                            {
                                <div class="chips">
                                    @foreach (var effect in character.Effects)
                                    {
                                        <TraitChip>@Named(effect)</TraitChip>
                                    }
                                </div>
                            }

                            <div class="acts">
                                <Button Variant="ButtonVariant.Secondary"
                                        OnClick="() => Dispatcher.Dispatch(new PickerOpened(character.Id))">
                                    Effects
                                </Button>
                                @* A level-up between sessions, a number Pathbuilder got wrong and a
                                   homebrew ancestry all need this, and re-exporting is not always
                                   possible at the table. *@
                                <Button Variant="ButtonVariant.Secondary"
                                        OnClick="() => Dispatcher.Dispatch(new EditorOpened(character.Id))">
                                    Edit
                                </Button>
                            </div>
                        </ChildContent>
                    </Card>
                }
            </div>
        }

        @if (table.Characters.Any(c => c.Feats.Count > 0 || c.Spells.Count > 0))
        {
            @Reference(table)
        }

        <div class="panel import">
            <Card Title="Put a character in the campaign">
                <ChildContent>
                    <TextArea Label="Pathbuilder export"
                              Rows="5"
                              Placeholder="Paste the export here"
                              Hint="In Pathbuilder, choose Export JSON. Paste the JSON itself, or open pathbuilder2e.com/json.php?id=NNNNNN with the number it gives you and copy the page."
                              Error="@State.ImportError"
                              Value="@State.PasteDraft"
                              ValueChanged="paste => Dispatcher.Dispatch(new PasteDraftChanged(paste ?? string.Empty))" />
                    <Button Variant="ButtonVariant.Primary"
                            Busy="State.Importing"
                            Disabled="@(State.PasteDraft.Trim().Length == 0)"
                            OnClick="() => Dispatcher.Dispatch(new ImportRequested())">
                        Import
                    </Button>
                </ChildContent>
            </Card>
        </div>
    </Loaded>
</RemoteView>

<BottomSheet Open="@(Opened is not null)"
             Title="@BreakdownTitle"
             OnClose="() => Dispatcher.Dispatch(new BreakdownClosed())">
    @if (Opened is { } open && Character(open.CharacterId) is { } character
        && open.Stat.In(character) is { } breakdown)
    {

        <div class="breakdown">
            <p class="breakdown__base">
                <span class="breakdown__what">Before any effect</span>
                <span class="breakdown__number">@breakdown.Base</span>
            </p>

            <h3 class="breakdown__heading">Applied</h3>
            <ul class="breakdown__applied">
                @foreach (var modifier in breakdown.Applied)
                {
                    <li class="row">
                        <ModifierValue Value="modifier.Value" Kind="RuleDisplay.KindOf(modifier.Type)" />
                        <span class="row__source">@modifier.Source</span>
                        <span class="row__applies">to @string.Join(" and ", modifier.Applies)</span>
                    </li>
                }
                @if (breakdown.Applied.Count == 0)
                {
                    <li class="row row--none">Nothing is changing this number.</li>
                }
            </ul>

            <h3 class="breakdown__heading">Suppressed</h3>
            <ul class="breakdown__suppressed">
                @foreach (var suppressed in breakdown.Suppressed)
                {
                    <li class="row row--off">
                        <ModifierValue Value="suppressed.Modifier.Value"
                                       Kind="RuleDisplay.KindOf(suppressed.Modifier.Type)" />
                        <span class="row__source">@suppressed.Modifier.Source</span>
                        <span class="row__reason">@suppressed.Reason</span>
                    </li>
                }
                @if (breakdown.Suppressed.Count == 0)
                {
                    <li class="row row--none">The stacking rule is holding nothing back.</li>
                }
            </ul>
        </div>
    }
</BottomSheet>

<BottomSheet Open="@(Picking is not null)"
             Title="Effects"
             OnClose="() => Dispatcher.Dispatch(new PickerClosed())">
    @if (Picking is { } picker && Character(picker.CharacterId) is { } character)
    {
        <SegmentedControl Class="picker__arms"
                          TValue="PickerArm"
                          Label="Where the effect comes from"
                          Options="Arms"
                          Value="picker.Arm"
                          ValueChanged="arm => Dispatcher.Dispatch(new ArmSelected(arm))" />

        <div class="applied">
            @foreach (var effect in character.Effects)
            {
                <div class="applied__row" data-effect="@effect.Id">
                    <span class="applied__name">@Named(effect)</span>
                    <Button Variant="ButtonVariant.Quiet"
                            OnClick="() => Dispatcher.Dispatch(new EffectSet(character.Id, effect.Id, null))">
                        Remove
                    </Button>
                </div>
            }
            @if (character.Effects.Count == 0)
            {
                <p class="applied__none">Nothing is on @character.Name yet.</p>
            }
        </div>

        @switch (picker.Arm)
        {
            case PickerArm.Conditions:
                <RemoteView T="IReadOnlyList<ConditionSummary>" Data="ConditionsStore.Value.Conditions">
                    <Loading>
                        <div class="pending">
                            <Spinner ShowLabel="true" Label="Loading conditions" />
                        </div>
                    </Loading>
                    <Failed Context="message">
                        <ErrorState Title="Could not load the conditions">
                            <ChildContent>@message</ChildContent>
                            <Action>
                                <Button Variant="ButtonVariant.Secondary"
                                        OnClick="() => Dispatcher.Dispatch(new ConditionsRequested())">
                                    Try again
                                </Button>
                            </Action>
                        </ErrorState>
                    </Failed>
                    <Loaded Context="effects">
                        @* Buffs first. A player reaches for this sheet because something good just
                           happened to them far more often than because something bad did. *@
                        @foreach (var group in Grouped(effects))
                        {
                            <h3 class="effects__kind">@group.Heading</h3>
                            <div class="conditions">
                                @foreach (var condition in group.Effects)
                                {
                                    <div class="condition" data-condition="@condition.Key">
                                        <span class="condition__name">
                                            @condition.Name
                                            @if (Reads(condition) is { Length: > 0 } reads)
                                            {
                                                <span class="condition__reads">@reads</span>
                                            }
                                        </span>
                                        @if (condition.HasValue)
                                        {
                                            <NumberStepper Label="@condition.Name"
                                                           Min="0"
                                                           Max="10"
                                                           Value="Held(character, condition.Key)?.Value ?? 0"
                                                           ValueChanged="value => Seed(character, condition, value)" />
                                        }
                                        else
                                        {
                                            <Switch Checked="@(Held(character, condition.Key) is not null)"
                                                    CheckedChanged="on => Seed(character, condition, on ? 1 : 0)">
                                                <span class="visually-hidden">@condition.Name</span>
                                            </Switch>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </Loaded>
                </RemoteView>
                break;

            case PickerArm.Rules:
                <div class="rules">
                    <SearchField Value="@picker.Query"
                                 ValueChanged="query => Dispatcher.Dispatch(new RuleQueryChanged(query ?? string.Empty))"
                                 Placeholder="Search every rule"
                                 Label="Search the rules for an effect" />

                    <RemoteView T="RuleSearchResult" Data="picker.Found">
                        <NotAsked>
                            <p class="hint">
                                The same records the browser shows. Tap one to apply what it states.
                            </p>
                        </NotAsked>
                        <Loading>
                            <div class="pending">
                                <Spinner ShowLabel="true" Label="Searching" />
                            </div>
                        </Loading>
                        <Failed Context="message">
                            <ErrorState Title="Could not search the rules">
                                <ChildContent>@message</ChildContent>
                            </ErrorState>
                        </Failed>
                        <Loaded Context="found">
                            @if (found.Items.Count == 0)
                            {
                                <p class="hint">Nothing matches that.</p>
                            }
                            else
                            {
                                <Card>
                                    <ListContent>
                                        @foreach (var rule in found.Items)
                                        {
                                            <ListRow Title="@rule.Name"
                                                     Meta="@Says(rule)"
                                                     OnClick="() => Take(character, rule)" />
                                        }
                                    </ListContent>
                                </Card>
                            }
                        </Loaded>
                    </RemoteView>
                </div>
                break;

            case PickerArm.Custom:
                <div class="custom">
                    <TextInput Label="Name"
                               Placeholder="Courageous Anthem"
                               Value="@State.Draft.Name"
                               ValueChanged="name => Redraft(State.Draft with { Name = name ?? string.Empty })" />

                    <SegmentedControl Class="custom__sign"
                                      TValue="bool"
                                      Label="Bonus or penalty"
                                      Options="Signs"
                                      Value="State.Draft.Bonus"
                                      ValueChanged="bonus => Redraft(State.Draft with { Bonus = bonus })" />

                    <NumberStepper Class="custom__value"
                                   Label="How much"
                                   Min="1"
                                   Max="10"
                                   Value="State.Draft.Value"
                                   ValueChanged="value => Redraft(State.Draft with { Value = value })" />

                    <Select Class="custom__type"
                            TValue="string"
                            Label="Type"
                            Options="Types"
                            Value="@State.Draft.Type"
                            ValueChanged="type => Redraft(State.Draft with { Type = type ?? Types[0].Value })" />

                    <Select Class="custom__applies"
                            TValue="string"
                            Label="Applies to"
                            Options="Targets"
                            Value="@State.Draft.Applies"
                            ValueChanged="applies => Redraft(State.Draft with { Applies = applies ?? Targets[0].Value })" />

                    <Button Variant="ButtonVariant.Primary"
                            Disabled="@(State.Draft.Name.Trim().Length == 0)"
                            OnClick="() => Dispatcher.Dispatch(new CustomEffectAdded(character.Id, State.Draft))">
                        Add
                    </Button>
                </div>
                break;
        }
    }
</BottomSheet>

@* Who is in the fight. A monster names a creature record and a player names somebody already
   on the roster, and both are one command on the server. *@
<BottomSheet Open="@(State.AddingCombatant is not null)"
             Title="Add to the fight"
             OnClose="() => Dispatcher.Dispatch(new CombatantPickerClosed())">
    @if (State.AddingCombatant is { } picker && Table is { } open)
    {
        <div class="adding">
            @if (Absent(open) is { Count: > 0 } roster)
            {
                <h3 class="adding__heading">From this campaign</h3>
                <Card>
                    <ListContent>
                        @foreach (var character in roster)
                        {
                            <ListRow Title="@character.Name"
                                     Meta="@Line($"Level {character.Level} {character.AncestryName} {character.ClassName}")"
                                     OnClick="() => Dispatcher.Dispatch(new CombatantAdded(null, character.Id, null))" />
                        }
                    </ListContent>
                </Card>
            }

            <h3 class="adding__heading">A monster</h3>
            <SearchField Value="@picker.Query"
                         ValueChanged="query => Dispatcher.Dispatch(new MonsterQueryChanged(query ?? string.Empty))"
                         Placeholder="Search 3,786 creatures"
                         Label="Search the bestiary" />

            <RemoteView T="RuleSearchResult" Data="picker.Found">
                <NotAsked>
                    <p class="hint">Every creature in the ruleset, with the numbers a fight needs.</p>
                </NotAsked>
                <Loading>
                    <div class="pending"><Spinner ShowLabel="true" Label="Searching" /></div>
                </Loading>
                <Failed Context="message">
                    <ErrorState Title="Could not search the bestiary">
                        <ChildContent>@message</ChildContent>
                    </ErrorState>
                </Failed>
                <Loaded Context="found">
                    @if (found.Items.Count == 0)
                    {
                        <p class="hint">Nothing by that name.</p>
                    }
                    else
                    {
                        <Card>
                            <ListContent>
                                @foreach (var creature in found.Items)
                                {
                                    <ListRow Title="@creature.Name"
                                             Meta="@Line(Glance(creature))"
                                             OnClick="() => Dispatcher.Dispatch(new CombatantAdded(creature.Id, null, null))" />
                                }
                            </ListContent>
                        </Card>
                    }
                </Loaded>
            </RemoteView>
        </div>
    }
</BottomSheet>

@* The build layer, in the form the calculator reads it. Nothing here touches hit points,
   effects or the turn: an edit is a re-import from a different source. *@
<BottomSheet Open="@(State.Editing is not null)"
             Title="@(State.Editing is { } e ? $"Edit {e.Draft.Name}" : "Edit")"
             OnClose="() => Dispatcher.Dispatch(new EditorClosed())">
    @if (State.Editing is { } editor)
    {
        var draft = editor.Draft;

        <div class="editor">
            @if (editor.Trouble is { } wrong)
            {
                <p class="trouble" role="alert">@wrong</p>
            }

            <div class="editor__grid">
                <TextInput Label="Name" Value="@draft.Name"
                           ValueChanged="v => Edit(draft with { Name = v ?? string.Empty })" />
                <div class="editor__field">
                    <span class="editor__label" id="edit-Level">Level</span>
                    <NumberStepper Label="Level" Min="1" Max="20" Value="draft.Level"
                                   ValueChanged="v => Edit(draft with { Level = v })" />
                </div>
                <TextInput Label="Class" Value="@draft.ClassName"
                           ValueChanged="v => Edit(draft with { ClassName = v ?? string.Empty })" />
                <TextInput Label="Ancestry" Value="@draft.AncestryName"
                           ValueChanged="v => Edit(draft with { AncestryName = v ?? string.Empty })" />
            </div>

            <h3 class="editor__heading">Attributes</h3>
            @* Modifiers, not scores. The sheet says Dexterity +3, so this says +3 too rather
               than making somebody convert 16 in their head to mean the same thing. *@
            <div class="editor__grid">
                <div class="editor__field">
                    <span class="editor__label" id="edit-Strength">Str</span>
                    <NumberStepper Label="Str" Min="-5" Max="10" Value="draft.Strength"
                                   ValueChanged="v => Edit(draft with { Strength = v })" />
                </div>
                <div class="editor__field">
                    <span class="editor__label" id="edit-Dexterity">Dex</span>
                    <NumberStepper Label="Dex" Min="-5" Max="10" Value="draft.Dexterity"
                                   ValueChanged="v => Edit(draft with { Dexterity = v })" />
                </div>
                <div class="editor__field">
                    <span class="editor__label" id="edit-Constitution">Con</span>
                    <NumberStepper Label="Con" Min="-5" Max="10" Value="draft.Constitution"
                                   ValueChanged="v => Edit(draft with { Constitution = v })" />
                </div>
                <div class="editor__field">
                    <span class="editor__label" id="edit-Intelligence">Int</span>
                    <NumberStepper Label="Int" Min="-5" Max="10" Value="draft.Intelligence"
                                   ValueChanged="v => Edit(draft with { Intelligence = v })" />
                </div>
                <div class="editor__field">
                    <span class="editor__label" id="edit-Wisdom">Wis</span>
                    <NumberStepper Label="Wis" Min="-5" Max="10" Value="draft.Wisdom"
                                   ValueChanged="v => Edit(draft with { Wisdom = v })" />
                </div>
                <div class="editor__field">
                    <span class="editor__label" id="edit-Charisma">Cha</span>
                    <NumberStepper Label="Cha" Min="-5" Max="10" Value="draft.Charisma"
                                   ValueChanged="v => Edit(draft with { Charisma = v })" />
                </div>
            </div>

            <h3 class="editor__heading">Proficiencies</h3>
            <div class="editor__grid">
                <Select TValue="string" Label="Key attribute" Options="CharacterEdits.Attributes"
                        Value="@draft.KeyAttribute"
                        ValueChanged="v => Edit(draft with { KeyAttribute = v ?? draft.KeyAttribute })" />
                <Select TValue="string" Label="Fortitude" Options="CharacterEdits.Ranks"
                        Value="@draft.Fortitude"
                        ValueChanged="v => Edit(draft with { Fortitude = v ?? draft.Fortitude })" />
                <Select TValue="string" Label="Reflex" Options="CharacterEdits.Ranks"
                        Value="@draft.Reflex"
                        ValueChanged="v => Edit(draft with { Reflex = v ?? draft.Reflex })" />
                <Select TValue="string" Label="Will" Options="CharacterEdits.Ranks"
                        Value="@draft.Will"
                        ValueChanged="v => Edit(draft with { Will = v ?? draft.Will })" />
                <Select TValue="string" Label="Perception" Options="CharacterEdits.Ranks"
                        Value="@draft.Perception"
                        ValueChanged="v => Edit(draft with { Perception = v ?? draft.Perception })" />
                <Select TValue="string" Label="Class DC" Options="CharacterEdits.Ranks"
                        Value="@draft.ClassDc"
                        ValueChanged="v => Edit(draft with { ClassDc = v ?? draft.ClassDc })" />
            </div>

            <h3 class="editor__heading">Armour and hit points</h3>
            <div class="editor__grid">
                <TextInput Label="Armour" Value="@draft.ArmorName"
                           ValueChanged="v => Edit(draft with { ArmorName = v ?? string.Empty })" />
                <Select TValue="string" Label="Armour proficiency" Options="CharacterEdits.Ranks"
                        Value="@draft.ArmorRank"
                        ValueChanged="v => Edit(draft with { ArmorRank = v ?? draft.ArmorRank })" />
                <div class="editor__field">
                    <span class="editor__label" id="edit-ArmorItemBonus">Armour bonus</span>
                    <NumberStepper Label="Armour bonus" Min="0" Max="10" Value="draft.ArmorItemBonus"
                                   ValueChanged="v => Edit(draft with { ArmorItemBonus = v })" />
                </div>
                <div class="editor__field">
                    <span class="editor__label">Dex cap</span>
                    <NumberStepper Label="Dex cap" Min="0" Max="10" Value="draft.ArmorDexCap ?? 10"
                                   ValueChanged="v => Edit(draft with { ArmorDexCap = v })" />
                </div>
                <div class="editor__field">
                    <span class="editor__label" id="edit-AncestryHitPoints">Ancestry HP</span>
                    <NumberStepper Label="Ancestry HP" Min="0" Max="20" Value="draft.AncestryHitPoints"
                                   ValueChanged="v => Edit(draft with { AncestryHitPoints = v })" />
                </div>
                <div class="editor__field">
                    <span class="editor__label" id="edit-ClassHitPoints">Class HP</span>
                    <NumberStepper Label="Class HP" Min="0" Max="20" Value="draft.ClassHitPoints"
                                   ValueChanged="v => Edit(draft with { ClassHitPoints = v })" />
                </div>
            </div>

            <div class="editor__acts">
                <Button Variant="ButtonVariant.Secondary"
                        OnClick="() => Dispatcher.Dispatch(new EditorClosed())">
                    Cancel
                </Button>
                <Button Disabled="editor.Saving"
                        OnClick="() => Dispatcher.Dispatch(new EditSubmitted())">
                    @if (editor.Saving)
                    {
                        <text>Saving</text>
                    }
                    else
                    {
                        <text>Save</text>
                    }
                </Button>
            </div>
        </div>
    }
</BottomSheet>

@code {
    static readonly IReadOnlyList<ChoiceOption<string>> Modes =
    [
        new("Exploration", "Explore"),
        new("Encounter", "Fight"),
        new("Downtime", "Downtime"),
    ];

    /// <summary>The label a player reads when they cannot change it. The switcher's labels are
    /// short because three of them share a phone's width; a sentence has room to be a word.</summary>
    static string ModeName(string mode) => mode switch
    {
        "Encounter" => "In a fight",
        "Downtime" => "Downtime",
        _ => "Exploring",
    };

    CampaignView? Table =>
        State.Campaign is RemoteData<CampaignView>.Loaded loaded ? loaded.Value : null;

    /// <summary>Everyone on the roster who is not already in the fight. Offering somebody twice
    /// is offering to give them two turns.</summary>
    static IReadOnlyList<CharacterSheetView> Absent(CampaignView table) =>
    [
        .. table.Characters.Where(character =>
            table.Encounter is null
            || !table.Encounter.Combatants.Any(combatant => combatant.Id == character.Id)),
    ];

    /// <summary>A creature row says what a DM choosing one wants to know, which is how hard it
    /// hits back rather than which book it is from.</summary>
    static string Glance(RuleSummary creature)
    {
        var facts = creature.Highlights
            .Where(fact => fact.Key is "ac" or "hp" or "size")
            .Select(fact => $"{MechanicsDisplay.LabelOf(fact.Key)} {string.Join(", ", fact.Values)}");

        var level = creature.Level is { } value ? $"Level {value}" : null;
        return string.Join(" · ", new[] { level }.Concat(facts).Where(part => part is { Length: > 0 })!);
    }

    /// <summary>A row's meta slot takes a fragment, so a sentence has to become one.</summary>
    static RenderFragment Line(string text) => @<span class="line">@text</span>;

    void Edit(CharacterBuildEdit draft) => Dispatcher.Dispatch(new EditDraftChanged(draft));

    /// <summary>
    /// The party's own feats and spells, in the same records the rest of the app uses.
    /// <para>Tapping one opens the rule. A name the ruleset does not hold still shows and
    /// simply does not open: homebrew is somebody's character too, a feat printed after the
    /// snapshot was taken is not the player's mistake, and an export written before the
    /// Remaster carries names the current records no longer use. The row says "no record under
    /// this name" rather than "not in the ruleset", because all three of those are true of a
    /// name and none of them is true of the thing it names.</para>
    /// <para>Shown in every mode, because a dispute about somebody's feat does not wait for
    /// the right mode to be selected.</para>
    /// </summary>
    RenderFragment Reference(CampaignView table) => @<div class="reference">
        <Card Class="reference__card">
            <ChildContent>
                <h2 class="reference__heading">What the party has</h2>

                @foreach (var character in table.Characters.Where(c => c.Feats.Count > 0 || c.Spells.Count > 0))
                {
                    <details class="owned" data-owned="@character.Id">
                        <summary class="owned__summary">
                            <span class="owned__name">@character.Name</span>
                            <span class="owned__count">
                                @character.Feats.Count feats, @character.Spells.Count spells
                            </span>
                        </summary>

                        @foreach (var group in Owned(character))
                        {
                            <h3 class="owned__kind">@group.Heading</h3>
                            <div class="owned__entries">
                                @foreach (var entry in group.Entries)
                                {
                                    @if (entry.RuleId is { } id)
                                    {
                                        <a class="owned__entry" href="@Navigation.Rule(id)">
                                            <span class="owned__entry-name">@entry.Name</span>
                                            <span class="owned__entry-kind">@entry.Kind</span>
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="owned__entry owned__entry--unknown">
                                            <span class="owned__entry-name">@entry.Name</span>
                                            <span class="owned__entry-kind">@entry.Kind · no record under this name</span>
                                        </span>
                                    }
                                }
                            </div>
                        }
                    </details>
                }
            </ChildContent>
        </Card>
    </div>;

    sealed record OwnedGroup(string Heading, IReadOnlyList<SheetEntryView> Entries);

    /// <summary>Feats by the kind the export called them, then spells by rank, each in the
    /// order a character sheet lists them rather than alphabetically.</summary>
    static IReadOnlyList<OwnedGroup> Owned(CharacterSheetView character) =>
    [
        .. character.Feats
            .GroupBy(feat => feat.Kind)
            .OrderBy(group => group.Min(feat => feat.Level))
            .Select(group => new OwnedGroup(group.Key, [.. group.OrderBy(feat => feat.Level)])),
        .. character.Spells
            .GroupBy(spell => spell.Kind)
            .OrderBy(group => group.Key == "Cantrip" ? 0 : group.Min(spell => spell.Level))
            .Select(group => new OwnedGroup(
                group.Key,
                [.. group.OrderBy(spell => spell.Name, StringComparer.OrdinalIgnoreCase)])),
    ];

    /// <summary>
    /// A day counter and one activity per character per day.
    /// <para>The task level is here because the DC comes from it, and the DC is the number the
    /// DM would otherwise open the book for. What each activity pays is not here: Earn Income's
    /// table is a currency per task level, per proficiency rank and per degree of success, and
    /// this project imports no rule text, so the screen says where the table is rather than
    /// inventing several hundred numbers.</para>
    /// </summary>
    RenderFragment Downtime(CampaignView table) => @<div class="downtime">
        <Card Class="downtime__card">
            <ChildContent>
                <div class="downtime__top">
                    <h2 class="downtime__heading">Downtime</h2>
                    <p class="downtime__day" role="status">
                        <span class="downtime__day-label">Day</span>
                        <span class="downtime__day-value">@table.Day</span>
                    </p>
                </div>

                @foreach (var character in table.Characters)
                {
                    <div class="spending" data-spending="@character.Id">
                        <Select TValue="string"
                                Label="@character.Name"
                                Options="ExplorationStore.Value.DowntimeOptions"
                                Value="@(character.DowntimeActivity ?? string.Empty)"
                                ValueChanged="key => Dispatcher.Dispatch(
                                    new DowntimeActivityChosen(
                                        character.Id,
                                        string.IsNullOrEmpty(key) ? null : key,
                                        string.IsNullOrEmpty(key) ? null : character.DowntimeTaskLevel ?? character.Level))" />

                        @if (ExplorationStore.Value.DowntimeNamed(character.DowntimeActivity) is { } chosen)
                        {
                            <div class="spending__task">
                                <div class="spending__level">
                                    <span class="spending__level-label">Task level</span>
                                    <NumberStepper Label="@($"Task level for {character.Name}")"
                                                   Min="0"
                                                   Max="25"
                                                   Value="character.DowntimeTaskLevel ?? character.Level"
                                                   ValueChanged="level => Dispatcher.Dispatch(
                                                       new DowntimeActivityChosen(character.Id, chosen.Key, level))" />
                                </div>

                                @if (character.DowntimeDc is { } dc)
                                {
                                    <p class="spending__dc">
                                        <span class="spending__dc-label">DC</span>
                                        <span class="spending__dc-value">@dc</span>
                                        @if (chosen.Skill is { } skill)
                                        {
                                            <span class="spending__skill">@skill @Signed(SkillOf(character, skill))</span>
                                        }
                                    </p>
                                }
                            </div>

                            <p class="spending__says">@chosen.What</p>
                        }
                    </div>
                }

                @if (table.Role == "Dm")
                {
                    <Button Class="downtime__next"
                            OnClick="() => Dispatcher.Dispatch(new DayAdvanced())">
                        Next day
                    </Button>
                    <p class="downtime__next-says">
                        One activity per character per day, so the day turning clears what
                        everybody chose.
                    </p>
                }
            </ChildContent>
        </Card>
    </div>;

    /// <summary>The character's own total in the skill the activity rolls, so the DM can see
    /// the DC and the modifier side by side rather than opening a card to find one of them.</summary>
    static int SkillOf(CharacterSheetView character, string skill) =>
        character.Skills.FirstOrDefault(entry => entry.Name == skill)?.Value.Total ?? 0;

    /// <summary>
    /// What each character can attempt, and what they cannot.
    /// <para>The server decides both, from the character's own ranks, so this draws a list and
    /// holds no rules. What it can do is put the ones they can try first: a player scanning for
    /// something to do is not scanning for the things they are not trained for.</para>
    /// <para>The ones they cannot are still shown, behind a summary, because "why can nobody
    /// here read this?" is a question a table asks and an app that hid the answer would leave
    /// them guessing.</para>
    /// </summary>
    RenderFragment Attempts(CampaignView table) => @<div class="attempts">
        <Card Class="attempts__card">
            <ChildContent>
                <h2 class="attempts__heading">What you can attempt</h2>

                @foreach (var character in table.Characters)
                {
                    <details class="trying" data-trying="@character.Id">
                        <summary class="trying__summary">
                            <span class="trying__name">@character.Name</span>
                            <span class="trying__count">
                                @character.CanAttempt.Count(a => a.Met) of @character.CanAttempt.Count
                            </span>
                        </summary>

                        <div class="tries">
                            @foreach (var attempt in character.CanAttempt.Where(a => a.Met)
                                .OrderByDescending(a => a.Modifier).ThenBy(a => a.Name, StringComparer.Ordinal))
                            {
                                <div class="try" data-try="@attempt.Key">
                                    <span class="try__name">@attempt.Name</span>
                                    <span class="try__skill">@attempt.Skill</span>
                                    <span class="try__value">@Signed(attempt.Modifier)</span>
                                </div>
                            }
                        </div>

                        @if (character.CanAttempt.Any(a => !a.Met))
                        {
                            <details class="trying__rest">
                                <summary class="trying__rest-summary">Not trained enough for</summary>
                                <div class="tries">
                                    @foreach (var attempt in character.CanAttempt.Where(a => !a.Met)
                                        .OrderBy(a => a.Name, StringComparer.Ordinal))
                                    {
                                        <div class="try try--barred" data-try="@attempt.Key">
                                            <span class="try__name">@attempt.Name</span>
                                            <span class="try__skill">
                                                needs @attempt.Required.ToLowerInvariant() in @attempt.Skill
                                            </span>
                                        </div>
                                    }
                                </div>
                            </details>
                        }
                    </details>
                }
            </ChildContent>
        </Card>
    </div>;

    /// <summary>
    /// What the party does when they stop, and how long they have been at it.
    /// <para>None of the ten-minute activities changes a number. Treat Wounds heals dice this
    /// app does not roll for a table that has dice in front of it; what it keeps is the hour of
    /// immunity afterwards, which is the half people forget. A full night is different: what it
    /// restores is arithmetic, so the engine does it.</para>
    /// </summary>
    RenderFragment Camp(CampaignView table) => @<div class="camp">
        <Card Class="camp__card">
            <ChildContent>
                <div class="camp__top">
                    <h2 class="camp__heading">When you stop</h2>
                    <p class="camp__clock" role="status">
                        <span class="camp__clock-label">Here</span>
                        <span class="camp__clock-value">@Duration.Spoken(table.ElapsedMinutes)</span>
                    </p>
                </div>

                @foreach (var character in table.Characters)
                {
                    <div class="camping" data-camping="@character.Id">
                        <div class="camping__who">
                            <span class="camping__name">@character.Name</span>
                            @if (character.TreatWoundsImmuneFor > 0)
                            {
                                <span class="camping__immune">
                                    Treated. Immune for @Duration.Spoken(character.TreatWoundsImmuneFor).
                                </span>
                            }
                        </div>

                        <div class="camping__acts">
                            @foreach (var activity in ExplorationStore.Value.Camp)
                            {
                                <Button Variant="ButtonVariant.Secondary"
                                        Class="camping__act"
                                        Disabled="@(activity.Key == "treat-wounds" && character.TreatWoundsImmuneFor > 0)"
                                        OnClick="() => Dispatcher.Dispatch(new CampActivityTaken(character.Id, activity.Key))">
                                    @activity.Name
                                </Button>
                            }
                        </div>
                    </div>
                }

                @* Once, under the buttons, rather than four sentences beside every character's
                   copy of them. Folded away because a table reads them the first session and
                   never again. *@
                <details class="camp__what">
                    <summary class="camp__what-summary">What these do</summary>
                    <dl class="camp__list">
                        @foreach (var activity in ExplorationStore.Value.Camp)
                        {
                            <div class="camp__entry">
                                <dt>
                                    @activity.Name
                                    <span class="camp__cost">@activity.Minutes min</span>
                                </dt>
                                <dd>@activity.What</dd>
                            </div>
                        }
                    </dl>
                </details>

                @if (table.Role == "Dm")
                {
                    <Button Class="camp__rest"
                            OnClick="() => Dispatcher.Dispatch(new NightRested())">
                        Rest for the night
                    </Button>
                    <p class="camp__rest-says">
                        Eight hours. Everyone recovers Constitution times level in hit points,
                        temporary hit points expire, fatigued ends, and drained and doomed each
                        step down by one.
                    </p>
                }
            </ChildContent>
        </Card>
    </div>;

    /// <summary>
    /// What everyone is doing while the party moves. One row per character, because that is the
    /// question the DM asks before opening a door and the one nobody remembers the answer to.
    /// <para>The consequence is printed under the choice rather than left in a rulebook. Three
    /// of the nine reach the fight and the rest are the table's to play out, and a sentence is
    /// how a screen tells those apart honestly.</para>
    /// </summary>
    RenderFragment Exploring(CampaignView table) => @<div class="explore">
        <Card Class="explore__card">
            <ChildContent>
                <h2 class="explore__heading">While you travel</h2>
                <p class="explore__blurb">
                    What each of you is doing. Scouting and sneaking change how the next fight
                    starts, so this is worth setting before anyone opens a door.
                </p>

                <div class="doing">
                    @foreach (var character in table.Characters)
                    {
                        <div class="doing__row" data-doing="@character.Id">
                            <Select TValue="string"
                                    Label="@character.Name"
                                    Options="ExplorationStore.Value.Options"
                                    Value="@(character.ExplorationActivity ?? string.Empty)"
                                    ValueChanged="key => Dispatcher.Dispatch(
                                        new ExplorationActivityChosen(
                                            character.Id,
                                            string.IsNullOrEmpty(key) ? null : key))" />

                            @if (ExplorationStore.Value.ConsequenceOf(character.ExplorationActivity) is { } says)
                            {
                                <p class="doing__says">@says</p>
                            }
                        </div>
                    }
                </div>
            </ChildContent>
        </Card>
    </div>;

    /// <summary>
    /// The fight. Initiative order, whose turn it is, and what the last turn change left the DM
    /// to do. A player gets the same list with the monsters they have been shown and nothing at
    /// all about the ones they have not; that is the projection's doing, not this screen's, so
    /// there is no role check inside the loop.
    /// </summary>
    RenderFragment Fight(CampaignView table) => @<div class="fight">
        <Card Class="fight__card">
            <ChildContent>
                <div class="fight__top">
                    <h2 class="fight__heading">Initiative</h2>
                    @if (table.Role == "Dm")
                    {
                        <div class="fight__acts">
                            <Button Variant="ButtonVariant.Secondary"
                                    OnClick="() => Dispatcher.Dispatch(new CombatantPickerOpened())">
                                Add
                            </Button>
                            <Button Variant="ButtonVariant.Secondary"
                                    OnClick="() => Dispatcher.Dispatch(new InitiativeRolled())">
                                Roll
                            </Button>
                            <Button Variant="ButtonVariant.Secondary"
                                    OnClick="() => Dispatcher.Dispatch(new ChangeUndone())">
                                Undo
                            </Button>
                            <Button OnClick="() => Dispatcher.Dispatch(new TurnAdvanced())">Next turn</Button>
                        </div>
                    }
                </div>

                @if (table.Encounter is not { Combatants.Count: > 0 } fight)
                {
                    <EmptyState Title="Nobody is in this fight yet">
                        <ChildContent>
                            @if (table.Role == "Dm")
                            {
                                <text>Add the party and whatever they ran into, then roll initiative.</text>
                            }
                            else
                            {
                                <text>The GM has not started the fight yet.</text>
                            }
                        </ChildContent>
                    </EmptyState>
                }
                else
                {
                    <ol class="order">
                        @foreach (var combatant in fight.Combatants)
                        {
                            <li class="turn @(combatant.IsCurrentTurn ? "turn--now" : null)"
                                data-combatant="@combatant.Id">
                                <span class="turn__initiative">@combatant.Initiative</span>
                                <span class="turn__who">
                                    <span class="turn__name">@combatant.Name</span>
                                    @if (combatant.Monster is { } monster)
                                    {
                                        <span class="turn__line">
                                            @monster.CurrentHitPoints / @monster.MaxHitPoints HP · AC @monster.ArmorClass
                                        </span>
                                    }
                                    @if (combatant.Effects.Count > 0)
                                    {
                                        <span class="turn__chips">
                                            @foreach (var effect in combatant.Effects)
                                            {
                                                <TraitChip>@Named(effect)</TraitChip>
                                            }
                                        </span>
                                    }
                                </span>

                                @if (combatant.Kind == "Adversary" && table.Role == "Dm")
                                {
                                    <span class="turn__dm">
                                        @* The same typed field the cards use, because a monster
                                           loses fifty hit points as easily as a player does and a
                                           combatant id is the creature id either way. *@
                                        <div class="amount">
                                            <TextInput Class="amount__field"
                                                       Label="@($"Hit points to apply to {combatant.Name}")"
                                                       InputMode="numeric"
                                                       Placeholder="0"
                                                       Value="@State.HitPointDraft(combatant.Id)"
                                                       ValueChanged="typed => Dispatcher.Dispatch(
                                                           new HitPointDraftChanged(combatant.Id, typed ?? string.Empty))" />
                                            <Button Variant="ButtonVariant.Secondary"
                                                    Disabled="@(Typed(combatant.Id) is null)"
                                                    OnClick='() => Apply(combatant.Id, "Damage")'>
                                                Damage
                                            </Button>
                                            <Button Variant="ButtonVariant.Secondary"
                                                    Disabled="@(Typed(combatant.Id) is null)"
                                                    OnClick='() => Apply(combatant.Id, "Heal")'>
                                                Heal
                                            </Button>
                                        </div>
                                        @* A monster the players have not been shown is not on
                                           their screen at all, so this is the only way it gets
                                           there, and a bare toggle would not say so. *@
                                        <label class="reveal">
                                            <Switch Checked="combatant.Revealed"
                                                    CheckedChanged="on => Dispatcher.Dispatch(new MonsterRevealed(combatant.Id, on))" />
                                            <span class="reveal__label">Players can see it</span>
                                        </label>
                                    </span>
                                }
                            </li>
                        }
                    </ol>

                    @if (fight.Reminders.Count > 0)
                    {
                        @* What the turn change left somebody to do. The app does not do these
                           itself: persistent damage is followed by a flat check, and an app that
                           takes the hit points without rolling it has decided half a rule. *@
                        <ul class="reminders">
                            @foreach (var reminder in fight.Reminders)
                            {
                                <li class="reminder">@reminder</li>
                            }
                        </ul>
                    }

                    @if (table.Role == "Dm")
                    {
                        <Button Variant="ButtonVariant.Secondary"
                                Class="fight__end"
                                OnClick="() => Dispatcher.Dispatch(new EncounterEnded())">
                            End the fight
                        </Button>
                    }
                }
            </ChildContent>
        </Card>
    </div>;
    static readonly IReadOnlyList<ChoiceOption<PickerArm>> Arms =
    [
        new(PickerArm.Conditions, "Effects"),
        new(PickerArm.Rules, "Rules"),
        new(PickerArm.Custom, "Custom"),
    ];

    sealed record EffectGroup(string Heading, IReadOnlyList<ConditionSummary> Effects);

    static IReadOnlyList<EffectGroup> Grouped(IReadOnlyList<ConditionSummary> effects) =>
    [
        .. new[] { ("Buff", "Buffs"), ("Condition", "Conditions") }
            .Select(kind => new EffectGroup(kind.Item2,
                [.. effects.Where(e => e.Kind == kind.Item1).OrderBy(e => e.Name, StringComparer.Ordinal)]))
            .Where(group => group.Effects.Count > 0),
    ];

    /// <summary>What the effect does, in the words of the breakdown it will appear in, so nobody
    /// has to open the rule to find out whether an anthem helps their armour class.</summary>
    static string Reads(ConditionSummary effect) =>
        string.Join("; ", effect.Modifiers.Select(m =>
            $"{(m.Value > 0 ? "+" : string.Empty)}{m.Value} {m.Type.ToLowerInvariant()} to {string.Join(", ", m.Applies)}"));

    static readonly IReadOnlyList<ChoiceOption<bool>> Signs =
    [
        new(true, "Bonus"),
        new(false, "Penalty"),
    ];

    static readonly IReadOnlyList<ChoiceOption<string>> Types =
    [
        new("Status", "Status"),
        new("Circumstance", "Circumstance"),
        new("Item", "Item"),
        new("Untyped", "Untyped"),
    ];

    static readonly IReadOnlyList<ChoiceOption<string>> Targets =
        [.. EffectVocabulary.All.Select(choice => new ChoiceOption<string>(choice.Token, choice.Label))];

    CampaignState State => Store.Value;

    OpenBreakdown? Opened => State.Breakdown;

    EffectPicker? Picking => State.Picker;

    string BreakdownTitle =>
        Opened is { } open && Character(open.CharacterId) is { } character
        && open.Stat.In(character) is { } breakdown
            ? $"{open.Stat.Label} {breakdown.Total}"
            : "Breakdown";

    RenderFragment Entrance => @<div class="join">
        <div class="panel">
            <Card>
                <EmptyState Title="Join a campaign">
                    <ChildContent>
                        A campaign is a short code everyone playing types in. Whoever starts one reads it
                        out; after that every change anybody makes shows up on everybody's screen.
                    </ChildContent>
                    <Action>
                        <div class="entry">
                            <TextInput Label="Campaign code"
                                       Placeholder="ABC234"
                                       InputMode="text"
                                       Value="@State.CodeDraft"
                                       ValueChanged="code => Dispatcher.Dispatch(new CodeDraftChanged(code ?? string.Empty))" />
                            <div class="pf-cluster">
                                <Button Variant="ButtonVariant.Primary"
                                        Disabled="@(State.CodeDraft.Trim().Length == 0)"
                                        OnClick="() => Dispatcher.Dispatch(new JoinRequested(State.CodeDraft))">
                                    Join
                                </Button>
                                <Button Variant="ButtonVariant.Secondary"
                                        OnClick="() => Dispatcher.Dispatch(new CampaignCreationRequested())">
                                    Start a new campaign
                                </Button>
                            </div>
                        </div>
                    </Action>
                </EmptyState>
            </Card>
        </div>
    </div>;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        if (Browser.Value.ActiveGroup != GroupKey.Play)
        {
            Dispatcher.Dispatch(new BoardOpened(GroupKey.Play));
        }

        if (ConditionsStore.Value.Conditions is RemoteData<IReadOnlyList<ConditionSummary>>.NotAsked)
        {
            Dispatcher.Dispatch(new ConditionsRequested());
        }

        if (ExplorationStore.Value.Activities is RemoteData<IReadOnlyList<ExplorationActivityView>>.NotAsked)
        {
            Dispatcher.Dispatch(new ExplorationActivitiesRequested());
        }
    }

    CharacterSheetView? Character(Guid id) =>
        State.Campaign is RemoteData<CampaignView>.Loaded loaded
            ? loaded.Value.Characters.FirstOrDefault(character => character.Id == id)
            : null;

    static ActiveEffectView? Held(CharacterSheetView character, string key) =>
        character.Effects.FirstOrDefault(effect =>
            effect.Kind == "Seeded" && string.Equals(effect.Key, key, StringComparison.OrdinalIgnoreCase));

    static string Named(ActiveEffectView effect) =>
        effect.HasValue && effect.Value > 0 ? $"{effect.Name} {effect.Value}" : effect.Name;

    static RenderFragment Says(RuleSummary rule) => @<text>
        @if (rule.HasModifiers)
        {
            <span class="states">States a modifier this app can apply</span>
        }
        else
        {
            <span class="states states--none">States no modifier this app can apply yet. Tap to write it yourself.</span>
        }
    </text>;

    void Open(Guid characterId, StatAddress address) =>
        Dispatcher.Dispatch(new BreakdownOpened(characterId, address));

    /// <summary>A roll reads +14 or -1, never 14, because the number is added to a die.</summary>
    static string Signed(int total) => total >= 0 ? $"+{total}" : total.ToString();

    static IReadOnlyList<NamedBreakdownView> Trained(CharacterSheetView character) =>
        [.. character.Skills.Where(skill => skill.Rank != nameof(ProficiencyRank.Untrained))];

    static IReadOnlyList<NamedBreakdownView> Untrained(CharacterSheetView character) =>
        [.. character.Skills.Where(skill => skill.Rank == nameof(ProficiencyRank.Untrained))];

    void Nudge(Guid characterId, int delta) =>
        Dispatcher.Dispatch(new HitPointsNudged(characterId, delta));

    /// <summary>Null for anything that is not a number a table would apply, which is what leaves
    /// both buttons disabled rather than sending a request the server will refuse.</summary>
    int? Typed(Guid characterId) =>
        int.TryParse(State.HitPointDraft(characterId), out var amount) && amount is > 0 and <= 999
            ? amount
            : null;

    void Apply(Guid characterId, string direction)
    {
        if (Typed(characterId) is { } amount)
        {
            Dispatcher.Dispatch(new HitPointsApplied(characterId, amount, direction));
        }
    }

    void Redraft(EffectDraft draft) => Dispatcher.Dispatch(new DraftChanged(draft));

    void Take(CharacterSheetView character, RuleSummary rule)
    {
        if (rule.HasModifiers)
        {
            Dispatcher.Dispatch(new RuleEffectRequested(character.Id, rule.Id, rule.Name));
            return;
        }

        Dispatcher.Dispatch(new RuleDeclined(rule.Name));
    }

    /// <summary>A seeded effect reuses whatever slot it already holds, so raising clumsy from 1 to
    /// 2 is the same effect rather than a second one.</summary>
    void Seed(CharacterSheetView character, ConditionSummary condition, int value)
    {
        var slot = Held(character, condition.Key)?.Id ?? Guid.NewGuid();
        var effect = value <= 0
            ? null
            : new EffectSpec(
                condition.Name,
                "Seeded",
                condition.Key,
                condition.HasValue ? value : 0,
                null,
                []);

        Dispatcher.Dispatch(new EffectSet(character.Id, slot, effect));
    }
}
