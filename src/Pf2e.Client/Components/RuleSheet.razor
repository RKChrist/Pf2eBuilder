@inherits FluxorComponent
@inject IState<RuleDetailState> Detail
@inject IDispatcher Dispatcher
@inject NavigationManager Navigation
@inject RulesApi Api
@inject IJSRuntime Js

<BottomSheet Open="@(Detail.Value.Id is not null)" Title="@Title" OnClose="Close" Class="pf-sheet--dock rule-sheet">
    <RemoteView T="RuleDetail" Data="Detail.Value.Detail">
        <Loading>
            <div class="pending">
                <Spinner ShowLabel="true" Label="Loading the rule" />
            </div>
        </Loading>
        <Failed Context="message">
            <ErrorState Title="Could not load this rule">
                <ChildContent>@message</ChildContent>
                <Action>
                    <Button Variant="ButtonVariant.Secondary"
                            OnClick="@(() => Dispatcher.Dispatch(new RuleRetried()))">
                        Try again
                    </Button>
                </Action>
            </ErrorState>
        </Failed>
        <Loaded Context="rule">
            <div class="head">
                <p class="kind">@Kind(rule.Summary)</p>
                @if (RuleDisplay.RarityOf(rule.Summary.Rarity) is var rarity && rarity != Rarity.Common)
                {
                    <RarityBadge Value="rarity" />
                }
            </div>

            @if (RuleDisplay.TraitsBeside(rule.Summary).ToList() is { Count: > 0 } traits)
            {
                <div class="traits" aria-label="Traits, each explained when tapped">
                    @foreach (var trait in traits)
                    {
                        <TraitLink Name="@trait" />
                    }
                </div>
            }

            @{ var (lead, after) = MechanicsDisplay.Split(rule); }

            @if (lead.Count > 0)
            {
                <dl class="stats">
                    @foreach (var row in lead)
                    {
                        <div class="stat @(MechanicsDisplay.IsGate(row.Key) ? "gate" : null)">
                            <dt>@row.Label</dt>
                            <dd>@Value(row)</dd>
                        </div>
                    }
                </dl>
            }

            @if (after.Count > 0)
            {
                <dl class="mechanics">
                    @foreach (var row in after)
                    {
                        <dt>@row.Label</dt>
                        <dd>@Value(row)</dd>
                    }
                </dl>
            }

            <a class="pf-btn pf-btn--secondary pf-btn--full archives" href="@rule.Summary.SourceUrl" target="_blank" rel="noopener">
                Full rules text on Archives of Nethys
            </a>
        </Loaded>
    </RemoteView>
</BottomSheet>

@code {
    /// <summary>Owned by the query string so the phone's back button closes the sheet, on any
    /// screen: the sheet lives in the layout.</summary>
    [Parameter, SupplyParameterFromQuery(Name = "rule")] public string? RuleId { get; set; }

    string Title => Detail.Value.Detail is RemoteData<RuleDetail>.Loaded loaded
        ? loaded.Value.Summary.Name
        : "Rule";

    static string Kind(RuleSummary summary) => summary.Level is int level
        ? $"{RuleCatalog.OneOf(summary.Category)} {level}"
        : RuleCatalog.OneOf(summary.Category);

    RenderFragment Value(MechanicRow row) => row.Key switch
    {
        "actions" => @<span class="cost">
            @if (Glance.Part(new MechanicField(row.Key, row.Values)) is { Cost: { } cost })
            {
                <ActionCost Cost="cost" />
            }
            <span>@string.Join(", ", row.Values)</span>
        </span>,
        _ when References.CategoryFor(row.Key) is not null => @<span class="refs">
            @foreach (var value in row.Values)
            {
                <button type="button" class="ref" @onclick="() => Follow(row.Key, value)">@value</button>
            }
        </span>,
        _ => @<text>@string.Join(", ", row.Values)</text>,
    };

    /// <summary>A named record opens in this sheet, with back returning to the one it was named
    /// in. A name the ruleset has no record for, such as a Lore skill, becomes a search.</summary>
    async Task Follow(string field, string name)
    {
        var category = References.CategoryFor(field)!;
        if (category == References.TraitCategory)
        {
            Navigation.NavigateTo(Navigation.Trait(name));
            return;
        }

        RuleSummary? found = null;
        try
        {
            found = await Api.FindAsync(category, name, CancellationToken.None);
        }
        catch (RulesApiException)
        {
            // The search this falls back to meets the same outage and says so on its own screen.
        }

        Navigation.NavigateTo(found is null ? Links.Search(name) : Navigation.Rule(found.Id));
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        if (RuleId != Detail.Value.Id)
        {
            Dispatcher.Dispatch(RuleId is null ? new RuleClosed() : (object)new RuleOpened(RuleId));
        }
    }

    async Task Close() => await Js.InvokeVoidAsync("history.back");
}
