@inherits FluxorComponent
@inject IState<RuleDetailState> Detail
@inject IDispatcher Dispatcher
@inject IJSRuntime Js

<BottomSheet Open="@(Detail.Value.Id is not null)" Title="@Title" OnClose="Close" Class="pf-sheet--dock">
    <RemoteView T="RuleDetail" Data="Detail.Value.Detail">
        <Loading>
            <div class="pending">
                <Spinner ShowLabel="true" Label="Loading the rule" />
            </div>
        </Loading>
        <Failed Context="message">
            <ErrorState Title="Could not load this rule">
                <ChildContent>@message</ChildContent>
                <Action>
                    <Button Variant="ButtonVariant.Secondary"
                            OnClick="@(() => Dispatcher.Dispatch(new RuleRetried()))">
                        Try again
                    </Button>
                </Action>
            </ErrorState>
        </Failed>
        <Loaded Context="rule">
            <div class="pf-cluster">
                @if (rule.Summary.Level is int level)
                {
                    <span class="level">Level @level</span>
                }
                <RarityBadge Value="RuleDisplay.RarityOf(rule.Summary.Rarity)" />
                @foreach (var trait in RuleDisplay.TraitsBeside(rule.Summary))
                {
                    <TraitChip>@trait</TraitChip>
                }
            </div>

            <dl class="mechanics">
                @foreach (var row in MechanicsDisplay.Rows(rule))
                {
                    <dt>@row.Label</dt>
                    <dd>@string.Join(", ", row.Values)</dd>
                }
            </dl>

            <a class="archives" href="@rule.Summary.SourceUrl" target="_blank" rel="noopener">
                Read it on Archives of Nethys
            </a>
        </Loaded>
    </RemoteView>
</BottomSheet>

@code {
    /// <summary>Owned by the query string so the phone's back button closes the sheet.</summary>
    [Parameter] public string? RuleId { get; set; }

    string Title => Detail.Value.Detail is RemoteData<RuleDetail>.Loaded loaded
        ? loaded.Value.Summary.Name
        : "Rule";

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        if (RuleId != Detail.Value.Id)
        {
            Dispatcher.Dispatch(RuleId is null ? new RuleClosed() : (object)new RuleOpened(RuleId));
        }
    }

    async Task Close() => await Js.InvokeVoidAsync("history.back");
}
