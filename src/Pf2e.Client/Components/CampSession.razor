@inject IDispatcher Dispatcher

@* One camping evening, in the order a table actually asks about it: what tonight is like, what
   each person is doing about it, and then the night itself.

   The rules run a camping session in five steps and the steps used to be this screen. They are
   not any more. The order of the steps is a rule about the fiction, not about the interface, and
   a party of six was spending taps walking a tab strip along instead of playing. What replaced it
   is one row per character carrying everything about that person, because "what is Brann doing
   tonight" is the question a GM asks and it used to be answered out of three separate blocks.

   Both pickers open in one sheet rather than inline, so the roster stays exactly one row per
   person however long the list inside the picker is. *@
<div class="session" data-step="@Camp.Step">

    @* Band one. The zone, the two DCs every roll tonight is against, and how making camp went.
       It stays in view all evening because everything below it is measured against it. *@
    <section class="tonight" aria-label="Tonight">
        <header class="band__head">
            <h3 class="band__name">Tonight</h3>
        </header>

        <div class="zone">
            @if (IsDm)
            {
                <Select TValue="string"
                        Class="zone__pick"
                        Label="Where you are camping"
                        Options="ZoneOptions"
                        Value="@(Zones.Any(zone => zone.Name == Camp.ZoneName) ? Camp.ZoneName : Elsewhere)"
                        ValueChanged="PickZone" />
            }
            else
            {
                <p class="zone__where">@(Camp.ZoneName ?? "Somewhere in the wild")</p>
            }
        </div>

        <div class="dcs">
            <div class="dc">
                @if (IsDm)
                {
                    <input class="dc__value dc__value--typed" type="text" inputmode="numeric"
                           aria-label="Zone DC" value="@Camp.ZoneDc"
                           @onchange="e => SetDcs(e.Value?.ToString(), null)" />
                }
                else
                {
                    <span class="dc__value">@Camp.ZoneDc</span>
                }
                <span class="dc__label">Zone DC</span>
                <span class="dc__says">Prepare Campsite and most Camping checks</span>
            </div>
            <div class="dc @(Camp.EncounterDcTonight != Camp.EncounterDc ? "dc--moved" : null)">
                @* Tonight's, which a perfect campsite moves. The DM types the zone's own
                   number; what the night is actually rolled against is derived from it. *@
                @if (IsDm && Camp.EncounterDcTonight == Camp.EncounterDc)
                {
                    <input class="dc__value dc__value--typed" type="text" inputmode="numeric"
                           aria-label="Encounter DC" value="@Camp.EncounterDc"
                           @onchange="e => SetDcs(null, e.Value?.ToString())" />
                }
                else
                {
                    <span class="dc__value">@Camp.EncounterDcTonight</span>
                }
                <span class="dc__label">Encounter DC tonight</span>
                <span class="dc__says">A flat check. Meeting it means something finds the camp.</span>
            </div>
        </div>

        @* The four degrees as four doors, name only. What each one opens and shuts is one line
           under them rather than four sentences somebody reads once and never again. *@
        <div class="outcomes" role="group" aria-label="How Prepare Campsite went">
            @foreach (var outcome in Outcomes)
            {
                <button type="button"
                        class="outcome outcome--@outcome.Tone @(Camp.Campsite == outcome.Key ? "outcome--on" : null)"
                        data-outcome="@outcome.Key"
                        disabled="@(!IsDm)"
                        aria-pressed="@(Camp.Campsite == outcome.Key ? "true" : "false")"
                        @onclick="() => Dispatcher.Dispatch(new CampsiteRecorded(Camp.Campsite == outcome.Key ? null : outcome.Key))">
                    <span class="outcome__name">@outcome.Name</span>
                </button>
            }
        </div>

        @if (Made is { } made)
        {
            <p class="tonight__means" role="status">
                <strong class="tonight__was">@made.Name.</strong> @made.Campsite
            </p>
        }
        else
        {
            <p class="tonight__means">
                Nobody has made camp yet. <RuleLink Ref='@(new RuleRef.Named("action", "Prepare Campsite"))' /> is a
                Survival check against the Zone DC and takes two hours. Roll it, then tap what you got.
            </p>
        }
    </section>

    @* Band two, and the row is the unit of design. One person per line: who they are, what they
       are doing and how it went, what they are eating, which watch they hold. The larder is the
       party's and not anybody's, so it sits in the heading beside the name of the band. *@
    <section class="party" aria-label="The party tonight">
        <header class="band__head">
            <h3 class="band__name">The party tonight</h3>

            <div class="larder">
                <div class="larder__count">
                    <span class="larder__label">Basic</span>
                    <NumberStepper Label="Basic ingredients" Min="0" Max="9999" Value="Camp.BasicIngredients"
                                   ValueChanged="count => Dispatcher.Dispatch(new CampSuppliesSet(count, Camp.SpecialIngredients))" />
                </div>
                <div class="larder__count">
                    <span class="larder__label">Special</span>
                    <NumberStepper Label="Special ingredients" Min="0" Max="9999" Value="Camp.SpecialIngredients"
                                   ValueChanged="count => Dispatcher.Dispatch(new CampSuppliesSet(Camp.BasicIngredients, count))" />
                </div>
                <p class="larder__left @(Camp.BasicIngredientsLeft != Camp.BasicIngredients ? "larder__left--spent" : null)"
                   role="status">
                    @Camp.BasicIngredientsLeft of @Camp.BasicIngredients basic left after tonight's meals
                </p>
                <p class="larder__says">
                    A basic meal takes two basic ingredients a serving and this screen takes them for you. A special
                    meal's cost is written into its own recipe, which the app does not hold, so take those out of the
                    special count yourselves. <RuleLink Ref='@(new RuleRef.Named("action", "Hunt and Gather"))' /> is
                    how you find more.
                </p>
            </div>
        </header>

        <ul class="roster">
            @foreach (var (character, seat) in Table.Characters.Select((character, seat) => (character, seat)))
            {
                var taken = Camp.Taken.Where(take => take.CharacterId == character.Id).ToList();
                var meal = Camp.Meals.FirstOrDefault(choice => choice.CharacterId == character.Id);
                <li class="who" data-who="@character.Id">
                    <div class="who__is">
                        <span class="who__name">@character.Name</span>
                        @* Watches.For shares the night among at most nine, so a tenth character
                           keeps none, and a party of one cannot keep a watch and sleep. *@
                        @if (Camp.EachWatchMinutes > 0 && seat < 9)
                        {
                            <span class="who__watch">Watch @(seat + 1)</span>
                        }
                    </div>

                    <div class="who__doing">
                        @foreach (var take in taken)
                        {
                            <span class="who__took who__took--@Tone(take.Outcome)">@take.Activity, @Spoken(take.Outcome)</span>
                        }
                        <button type="button" class="who__open" data-doing="@character.Id"
                                @onclick="() => _open = new Open(character.Id, Picker.Doing)">
                            <span class="who__for">Doing</span>
                            <span class="who__verb">@(taken.Count == 0 ? "nothing yet" : "something else")</span>
                            <span class="who__pips" aria-label="@($"{taken.Count} of 4 activities taken")">
                                @for (var pip = 0; pip < 4; pip++)
                                {
                                    <span class="who__pip @(pip < taken.Count ? "who__pip--used" : null)"></span>
                                }
                            </span>
                        </button>
                    </div>

                    <div class="who__eating">
                        <button type="button"
                                class="who__open who__open--meal @(meal is null ? null : "who__open--on")"
                                data-eating="@character.Id"
                                @onclick="() => _open = new Open(character.Id, Picker.Eating)">
                            <span class="who__for">Eating</span>
                            <span class="who__verb">@MealLabel(meal)</span>
                        </button>
                        @* A recipe the table wrote carries its own words. A seeded meal's words are
                           prose the licence withholds, so the record panel is how they reach a
                           reader and the link is the only honest thing to show. *@
                        @if (meal?.Benefit is { Length: > 0 } benefit)
                        {
                            <p class="who__benefit">@benefit</p>
                        }
                        else if (meal?.RuleId is { Length: > 0 } record)
                        {
                            <p class="who__benefit">
                                <RuleLink Ref='@(new RuleRef.Id(record))' Label="What it does" />
                            </p>
                        }
                    </div>
                </li>
            }
        </ul>
    </section>

    @* Band three. The rules print the watches as a table of eight rows. For one party it is one
       picture: this many watches, this long each, and a check every four hours. *@
    <section class="night" aria-label="The night">
        <header class="band__head">
            <h3 class="band__name">The night</h3>
        </header>

        @if (Camp.EachWatchMinutes > 0)
        {
            <div class="watches" role="img"
                 aria-label="@($"{Table.Characters.Count} watches of {Duration.Spoken(Camp.EachWatchMinutes)} each, {Duration.Spoken(Camp.RestMinutes)} in all")">
                <div class="watches__bar">
                    @foreach (var character in Table.Characters.Take(9))
                    {
                        <span class="watches__watch"><span class="watches__who">@character.Name</span></span>
                    }
                    @foreach (var check in EncounterChecks)
                    {
                        <span class="watches__check" style="inset-inline-start: @(check * 100 / Camp.RestMinutes)%"
                              title="@($"Encounter check at {Duration.Spoken(check)}")"></span>
                    }
                </div>
                <div class="watches__scale"><span>Camp settles</span><span>@Duration.Spoken(Camp.RestMinutes)</span></div>
            </div>
            <p class="band__says">
                <strong>@Table.Characters.Count on watch in turn, @Duration.Spoken(Camp.EachWatchMinutes) each.</strong>
                Everybody gets eight hours and somebody is always awake, which takes
                @Duration.Spoken(Camp.RestMinutes). Each mark on the bar is a flat check against Encounter DC
                @Camp.EncounterDcTonight, one every four hours.
            </p>
        }
        else
        {
            <p class="band__says">
                One person cannot keep a watch and sleep. Eight hours, and a flat check against Encounter DC
                @Camp.EncounterDcTonight every four.
            </p>
        }

        @* Nothing else sets the step. Resting moves it to daily preparations and breaking camp
           puts it back, which is how every screen knows the night has happened. *@
        @if (IsDm && Camp.Step == "DailyPreparations")
        {
            <p class="band__says">
                Spells, focus, gear and breaking camp, all in the half hour. Staying another night here means
                preparing the campsite again, which takes one hour the second time and goes the way it went the first.
            </p>
            <Button Variant="ButtonVariant.Primary" Class="night__act"
                    OnClick="() => Dispatcher.Dispatch(new CampBroken())">
                <Icon Name="sun" Class="pf-icon--lead" />Break camp
            </Button>
        }
        else if (IsDm)
        {
            <Button Variant="ButtonVariant.Primary" Class="night__act"
                    OnClick="() => Dispatcher.Dispatch(new NightRested())">
                <Icon Name="moon" Class="pf-icon--lead" />Rest for the night
            </Button>
        }
    </section>

    @* The camp book: what this table has written down for itself. Folded away because it is read
       while the party is making a recipe up and not on any other evening. *@
    <Disclosure Class="book" Title="Your camp book" Glyph="clipboard" Count="@Camp.Book.Count">
        <p class="band__says">
            Recipes your party knows and Camping activities of your own. Anybody at the table can write in it.
        </p>

        @if (Camp.Book.Count > 0)
        {
            <ul class="entries">
                @foreach (var entry in Camp.Book.OrderBy(entry => entry.Kind).ThenBy(entry => entry.Name, StringComparer.OrdinalIgnoreCase))
                {
                    <li class="entry" data-entry="@entry.Id">
                        <span class="entry__kind entry__kind--@entry.Kind.ToLowerInvariant()">@(entry.Kind == "Recipe" ? "Recipe" : "Activity")</span>
                        <span class="entry__name">@entry.Name</span>
                        @if (entry.Dc is { } dc)
                        {
                            <span class="entry__dc">DC @dc</span>
                        }
                        <span class="entry__does">@entry.Does</span>
                        <Button Variant="ButtonVariant.Quiet" Class="entry__out"
                                OnClick="() => Dispatcher.Dispatch(new CampEntryRemoved(entry.Id))">
                            <Icon Name="close" Label="@($"Take {entry.Name} out of the book")" />
                        </Button>
                    </li>
                }
            </ul>
        }

        <form class="writing" @onsubmit="Write" @onsubmit:preventDefault>
            <SegmentedControl TValue="string" Label="What it is" Options="Kinds"
                              Value="@_kind" ValueChanged="kind => _kind = kind ?? Recipe" />
            <TextInput Label="Name" Value="@_name" ValueChanged="name => _name = name ?? string.Empty"
                       Placeholder="@(_kind == Recipe ? "Hearty stew" : "Sing rounds")" Autocomplete="off" />
            @if (_kind == Recipe)
            {
                <TextInput Class="writing__dc" Label="Cooking DC" InputMode="numeric" Value="@_dc"
                           ValueChanged="dc => _dc = dc ?? string.Empty"
                           Hint="Survival or Cooking Lore. It varies by recipe." />
            }
            <TextArea Label="What it does" Rows="4" Value="@_does" ValueChanged="does => _does = does ?? string.Empty"
                      Placeholder="@(_kind == Recipe ? "What it costs, and what a success, a critical success and a critical failure do." : "The check, and what each result does.")" />
            <Button Variant="ButtonVariant.Primary" Type="ButtonType.Submit" Disabled="@(_name.Trim().Length == 0)">
                Write it in
            </Button>
        </form>
    </Disclosure>
</div>

@* One sheet for both pickers, switched by which one is open. Two instances per character would
   be twelve sheets in the render tree for a party of six, all of them shut. *@
<BottomSheet Open="@(_open is not null)" Title="@SheetTitle" OnClose="() => _open = null">
    @if (_open is { } open && Table.Characters.FirstOrDefault(character => character.Id == open.CharacterId) is { } who)
    {
        @if (open.Picker == Picker.Doing)
        {
            @if (!Camp.ActivitiesAllowed)
            {
                <p class="sheet__shut" role="status">
                    <Icon Name="warn" Class="pf-icon--lead" />The campsite is a mess. It is good enough to rest in and
                    to prepare for the day, and not for Camping activities, so there are none tonight.
                </p>
            }
            else
            {
                @* Requirements, skill and odds belong here rather than on the roster, because this
                   is the moment somebody is choosing and the only moment they are wanted. *@
                <ul class="doing">
                    @foreach (var activity in Offered)
                    {
                        var closed = IsClosed(activity.Name);
                        <li class="act @(closed ? "act--closed" : null)" data-act="@activity.Name">
                            <div class="act__what">
                                @if (activity.RuleId is { } record)
                                {
                                    <RuleLink Ref='@(new RuleRef.Id(record))' Label="@activity.Name" Class="act__name" />
                                }
                                else
                                {
                                    <span class="act__name act__name--own">@activity.Name</span>
                                    <span class="act__own">Your table's own</span>
                                }
                                @if (activity.Needs is { Length: > 0 } needs)
                                {
                                    <span class="act__needs">Needs: @needs</span>
                                }
                                @if (activity.Does is { Length: > 0 } does)
                                {
                                    <span class="act__needs">@does</span>
                                }
                            </div>

                            @* A poor campsite costs the check two, so the penalty is counted into
                               the number on screen: what is drawn is what they roll. *@
                            @if (!closed && activity.Skill is { Length: > 0 } skill)
                            {
                                var modifier = SheetFormat.SkillOf(who, skill) + Camp.ActivityPenalty;
                                <div class="act__odds">
                                    <span class="act__chance">
                                        @who.Name, @skill @SheetFormat.Signed(modifier) against DC @Camp.ZoneDc@(Camp.ActivityPenalty != 0 ? $" with the poor campsite's {Camp.ActivityPenalty} counted in" : null)
                                    </span>
                                    <DieChart Modifier="modifier" Dc="Camp.ZoneDc" />
                                </div>
                            }

                            @if (closed)
                            {
                                <span class="act__done"><Icon Name="check" Class="pf-icon--lead" />Done for tonight</span>
                            }
                            else
                            {
                                <div class="act__roll" role="group" aria-label="@($"How {activity.Name} went for {who.Name}")">
                                    @foreach (var outcome in Outcomes)
                                    {
                                        <button type="button"
                                                class="roll roll--@outcome.Tone"
                                                title="@outcome.Name"
                                                data-roll="@outcome.Key"
                                                disabled="@(Camp.Taken.Count(take => take.CharacterId == who.Id) >= 4)"
                                                @onclick="() => Took(who.Id, activity.Name, outcome.Key)">
                                            @outcome.Short
                                        </button>
                                    }
                                </div>
                            }
                        </li>
                    }
                </ul>
            }
        }
        else
        {
            var eating = Camp.Meals.FirstOrDefault(choice => choice.CharacterId == who.Id);
            <div class="menu">
                <div class="menu__quick" role="group" aria-label="@($"What {who.Name} is eating")">
                    <button type="button" class="pick @(eating?.Kind == Rations ? "pick--on" : null)"
                            data-meal="Rations" @onclick="() => Ate(who.Id, Rations, null, null)">
                        <span class="pick__name">Rations</span>
                    </button>
                    <button type="button" class="pick @(eating?.Kind == BasicMeal ? "pick--on" : null)"
                            data-meal="BasicMeal" @onclick="() => Ate(who.Id, BasicMeal, null, null)">
                        <span class="pick__name">Basic meal</span>
                        <span class="pick__cost">2 basic ingredients</span>
                    </button>
                    <button type="button" class="pick @(eating is null ? "pick--on" : null)"
                            data-meal="None" @onclick="() => Ate(who.Id, null, null, null)">
                        <span class="pick__name">Nothing yet</span>
                    </button>
                </div>

                @* The rules want a cook, and a screen that refused a meal because the table did
                   things in a different order would be ceremony. It says who rolls instead. *@
                <p class="menu__says">
                    Whoever took <RuleLink Ref='@(new RuleRef.Named("action", "Cook Basic Meal"))' /> or
                    <RuleLink Ref='@(new RuleRef.Named("action", "Cook Special Meal"))' /> rolls for these, once
                    everybody has chosen. A sickened character cannot eat a special meal. A special meal's
                    ingredients are written into its recipe rather than into the rules, so take those out of the
                    special count yourselves.
                </p>

                @if (Recipes.Any())
                {
                    <h4 class="menu__heading">Your camp book</h4>
                    <ul class="menu__list">
                        @foreach (var recipe in Recipes)
                        {
                            <li class="meal @(eating?.RecipeId == recipe.Id ? "meal--on" : null)" data-recipe="@recipe.Id">
                                <span class="meal__name">@recipe.Name</span>
                                @if (recipe.Dc is { } dc)
                                {
                                    <span class="meal__tag">Cooking DC @dc</span>
                                }
                                <p class="meal__does">@recipe.Does</p>
                                <button type="button" class="meal__take"
                                        @onclick="() => Ate(who.Id, SpecialMeal, recipe.Id, null)">
                                    @(eating?.RecipeId == recipe.Id ? "Eating this" : "Eat this")
                                </button>
                            </li>
                        }
                    </ul>
                }

                <h4 class="menu__heading">
                    Campsite meals
                    @* Six of the twenty-seven sit below level 3, so a first-level party has a real
                       list without the other twenty-one in the way. *@
                    <button type="button" class="menu__all" @onclick="() => _everyMeal = !_everyMeal">
                        @(_everyMeal ? $"Only up to level {PartyLevel}" : $"All {Meals.Count}")
                    </button>
                </h4>
                <ul class="menu__list">
                    @foreach (var dish in OnOffer)
                    {
                        <li class="meal @(eating?.RuleId == dish.RuleId ? "meal--on" : null)" data-dish="@dish.RuleId">
                            @* A link with an id is a real anchor and navigates away, so the name
                               cannot also be the control that chooses the meal. *@
                            <RuleLink Ref='@(new RuleRef.Id(dish.RuleId))' Label="@dish.Name" Class="meal__name" />
                            <span class="meal__tag">Level @(dish.Level ?? 0)</span>
                            @if (Uncommon(dish.Rarity) is { } rarity)
                            {
                                <span class="meal__rarity meal__rarity--@rarity">@rarity</span>
                            }
                            @if (dish.Requires is { Length: > 0 } requires)
                            {
                                <p class="meal__does">Requires @requires</p>
                            }
                            <button type="button" class="meal__take"
                                    @onclick="() => Ate(who.Id, SpecialMeal, null, dish.RuleId)">
                                @(eating?.RuleId == dish.RuleId ? "Eating this" : "Eat this")
                            </button>
                        </li>
                    }
                </ul>

                @if (!_everyMeal && OnOffer.Count < Meals.Count)
                {
                    <p class="menu__says">
                        @(Meals.Count - OnOffer.Count) meals above level @PartyLevel are not shown. There are
                        @Meals.Count in all.
                    </p>
                }
            </div>
        }
    }
</BottomSheet>

@code {
    [Parameter, EditorRequired] public CampaignView Table { get; set; } = default!;

    /// <summary>The ruleset's Camping activities, which this component does not fetch.</summary>
    [Parameter] public IReadOnlyList<CampingActivityView> Activities { get; set; } = [];

    /// <summary>The ruleset's campsite meals, on the same terms.</summary>
    [Parameter] public IReadOnlyList<CampsiteMealView> Meals { get; set; } = [];

    const string Recipe = "Recipe";
    const string Rations = "Rations";
    const string BasicMeal = "BasicMeal";
    const string SpecialMeal = "SpecialMeal";
    const string Elsewhere = "Somewhere else";

    CampSiteView Camp => Table.Camp;

    bool IsDm => Table.Role == "Dm";

    /// <summary>Which picker is open, over whom. A character and a kind, or nothing at all: there
    /// is no state in which one of those is known and the other is not.</summary>
    enum Picker { Doing, Eating }

    sealed record Open(Guid CharacterId, Picker Picker);

    Open? _open;
    bool _everyMeal;
    string _kind = Recipe, _name = string.Empty, _does = string.Empty, _dc = string.Empty;

    string SheetTitle => _open is { } open
        ? $"{NameOf(open.CharacterId)}: {(open.Picker == Picker.Doing ? "what they are doing" : "what they are eating")}"
        : string.Empty;

    /// <summary>The four degrees, with what each means for a campsite. Tone is the outcome ramp's
    /// own, so a critical failure here is the colour a critical failure is everywhere.</summary>
    sealed record OutcomeInfo(string Key, string Name, string Short, string Tone, string Campsite);

    static readonly OutcomeInfo[] Outcomes =
    [
        new("CriticalSuccess", "Critical success", "Crit", "crit-success",
            "The perfect spot. Encounter DC 2 higher for a day, and no encounter check for the first hour of activities."),
        new("Success", "Success", "Success", "success", "A serviceable camp. Everything works as written."),
        new("Failure", "Failure", "Fail", "failure", "It will do. Camping activities that need a check take a -2 penalty."),
        new("CriticalFailure", "Critical failure", "Crit fail", "crit-failure",
            "A mess. No Camping activities tonight, and a flat check against the Encounter DC now."),
    ];

    OutcomeInfo? Made => Outcomes.FirstOrDefault(info => info.Key == Camp.Campsite);

    static string Tone(string outcome) => Outcomes.First(info => info.Key == outcome).Tone;

    static string Spoken(string outcome) => Outcomes.First(info => info.Key == outcome).Name.ToLowerInvariant();

    string NameOf(Guid characterId) => Table.Characters.FirstOrDefault(c => c.Id == characterId)?.Name ?? "Somebody";

    static bool Same(string a, string b) => string.Equals(a.Trim(), b.Trim(), StringComparison.OrdinalIgnoreCase);

    /// <summary>The server decides this for real and refuses with the rule. It is mirrored here so
    /// an activity that is shut looks shut before anybody taps it.</summary>
    bool IsClosed(string activity) =>
        !Same(activity, "Cook Special Meal")
        && Camp.Taken.Any(take => Same(take.Activity, activity) && take.Outcome is "CriticalSuccess" or "Success");

    /// <summary>Skill is the one the activity is rolled with, and null where the activity names
    /// none or names several: a chart of one skill's odds would be a guess about the others.</summary>
    sealed record Offer(string Name, string? RuleId, string? Needs, string? Does, string? Skill);

    /// <summary>The ruleset's activities and then the table's own, in one list, because at the
    /// table they are one list.</summary>
    IEnumerable<Offer> Offered =>
        Activities.Select(activity => new Offer(
                activity.Name, activity.RuleId, activity.Requires, null,
                activity.Skills.Count == 1 ? activity.Skills[0] : null))
            .Concat(Camp.Book.Where(entry => entry.Kind == "Activity")
                .Select(entry => new Offer(entry.Name, null, null, entry.Does, null)));

    IEnumerable<CampEntryView> Recipes => Camp.Book.Where(entry => entry.Kind == Recipe);

    /// <summary>The level a party can reasonably cook at, which is its highest. A meal whose record
    /// carries no level reads as zero, which is where the two level-zero meals belong anyway.</summary>
    int PartyLevel => Table.Characters.Count == 0 ? 1 : Table.Characters.Max(character => character.Level);

    IReadOnlyList<CampsiteMealView> OnOffer =>
        _everyMeal ? Meals : [.. Meals.Where(dish => (dish.Level ?? 0) <= PartyLevel)];

    /// <summary>The rarity worth saying, and null for common, which every other screen leaves
    /// unsaid because it is the default.</summary>
    static string? Uncommon(string? rarity) =>
        rarity is { Length: > 0 } named && !Same(named, "Common") ? named.ToLowerInvariant() : null;

    string MealLabel(MealChoiceView? meal) => meal switch
    {
        null => "nothing yet",
        { Kind: Rations } => "Rations",
        { Kind: BasicMeal } => "Basic meal",
        { RecipeName: { Length: > 0 } named } => named,
        { RuleId: { Length: > 0 } id } => Meals.FirstOrDefault(dish => dish.RuleId == id)?.Name ?? "A campsite meal",
        _ => "A special meal",
    };

    /// <summary>When during the rest the GM checks for an encounter: every four hours.</summary>
    IEnumerable<int> EncounterChecks =>
        Enumerable.Range(1, Math.Max(0, (Camp.RestMinutes - 1) / 240)).Select(check => check * 240);

    static readonly IReadOnlyList<ChoiceOption<string>> Kinds =
        [new(Recipe, "A recipe"), new("Activity", "A Camping activity")];

    /// <summary>Choosing the activity and recording how it went is one tap, so the sheet has
    /// served its purpose the moment the roll lands.</summary>
    void Took(Guid characterId, string activity, string outcome)
    {
        Dispatcher.Dispatch(new CampingActivityTaken(characterId, activity, outcome));
        _open = null;
    }

    /// <summary>A null kind clears the meal. The validator wants exactly one of the two names when
    /// the kind is a special meal, and neither otherwise, which is what the callers pass.</summary>
    void Ate(Guid characterId, string? kind, Guid? recipeId, string? ruleId)
    {
        Dispatcher.Dispatch(new MealChosen(characterId, kind, recipeId, ruleId));
        _open = null;
    }

    /// <summary>The Camping Zones table from the Kingmaker Companion Guide: a zone, the DC for
    /// camping checks there, and the flat check for a random encounter.</summary>
    sealed record Zone(string Name, int ZoneDc, int EncounterDc);

    static readonly Zone[] Zones =
    [
        new("Brevoy", 14, 12), new("Rostland Hinterlands", 15, 12), new("Greenbelt", 16, 14),
        new("Tuskwater", 18, 12), new("Kamelands", 19, 12), new("Narlmarches", 20, 14),
        new("Sellen Hills", 20, 12), new("Dunsward", 18, 12), new("Nomen Heights", 24, 12),
        new("Tors of Levenies", 28, 16), new("Hooktongue", 32, 14), new("Drelev", 28, 12),
        new("Tiger Lords", 28, 12), new("Rushlight", 26, 12), new("Glenebon Lowlands", 30, 12),
        new("Pitax", 29, 12), new("Glenebon Uplands", 35, 12), new("Numeria", 36, 12),
        new("Thousand Voices", 43, 14), new("Branthlend Mountains", 41, 16),
    ];

    static readonly IReadOnlyList<ChoiceOption<string>> ZoneOptions =
    [
        new(Elsewhere, "Somewhere else (set the DCs yourself)"),
        .. Zones.Select(zone => new ChoiceOption<string>(zone.Name, $"{zone.Name} (Zone DC {zone.ZoneDc}, Encounter DC {zone.EncounterDc})")),
    ];

    void PickZone(string? name)
    {
        if (Zones.FirstOrDefault(zone => zone.Name == name) is { } zone)
        {
            Dispatcher.Dispatch(new CampZoneSet(zone.Name, zone.ZoneDc, zone.EncounterDc));
        }
        else
        {
            Dispatcher.Dispatch(new CampZoneSet(null, Camp.ZoneDc, Camp.EncounterDc));
        }
    }

    /// <summary>A DC typed by hand is somewhere the table does not list, so the name goes.</summary>
    void SetDcs(string? zoneDc, string? encounterDc)
    {
        var zone = int.TryParse(zoneDc, out var typedZone) ? typedZone : Camp.ZoneDc;
        var encounter = int.TryParse(encounterDc, out var typedEncounter) ? typedEncounter : Camp.EncounterDc;
        if (zone is >= 5 and <= 60 && encounter is >= 2 and <= 20)
        {
            Dispatcher.Dispatch(new CampZoneSet(null, zone, encounter));
        }
    }

    void Write()
    {
        if (_name.Trim().Length == 0)
        {
            return;
        }

        Dispatcher.Dispatch(new CampEntrySaved(
            Guid.NewGuid(), _kind, _name.Trim(), _does.Trim(),
            _kind == Recipe && int.TryParse(_dc, out var dc) && dc is >= 5 and <= 60 ? dc : null));
        (_name, _does, _dc) = (string.Empty, string.Empty, string.Empty);
    }
}
