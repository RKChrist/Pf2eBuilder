<svg class="glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    @switch (Group)
    {
        case GroupKey.Build:
            <circle cx="12" cy="6.5" r="3.2" />
            <path d="M5 20v-1.5a7 7 0 0 1 14 0V20" />
            break;

        case GroupKey.Feats:
            <path d="M12 3.5 14.6 9l6 .9-4.3 4.2 1 6-5.3-2.8L6.7 20l1-6L3.4 9.9 9.4 9Z" />
            break;

        case GroupKey.Spells:
            <path d="M12 3v6M12 15v6M3 12h6M15 12h6" />
            <path d="M12 9.2 14.8 12 12 14.8 9.2 12Z" />
            break;

        case GroupKey.Gear:
            <path d="M12 3.2 20 6v6.3c0 4.2-3.2 7.2-8 8.5-4.8-1.3-8-4.3-8-8.5V6Z" />
            break;

        case GroupKey.Play:
            <path d="M12 2.8 20.5 7.5v9L12 21.2 3.5 16.5v-9Z" />
            <circle cx="12" cy="12" r="1.6" fill="currentColor" stroke="none" />
            break;

        case GroupKey.Reference:
            <path d="M4 4.8h6a2.6 2.6 0 0 1 2 2.6v12a2.2 2.2 0 0 0-2-1.4H4Z" />
            <path d="M20 4.8h-6a2.6 2.6 0 0 0-2 2.6v12a2.2 2.2 0 0 1 2-1.4h6Z" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired] public GroupKey Group { get; set; }
}
