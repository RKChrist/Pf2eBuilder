@inherits FluxorComponent
@inject IState<CampaignState> Store
@inject IState<ConditionsState> ConditionsStore
@inject IDispatcher Dispatcher

@* What is on somebody, and everything that could go on them. Opened from the party card and
   from the initiative order, because a condition is applied far more often mid-fight than
   between fights and walking back to the party page to do it costs a turn nobody has.

   The subject is a kind and an id rather than a character, so the same sheet puts frightened on
   an ogre. The server refuses a player who tries. *@
<BottomSheet Open="@(Picking is not null)"
             Title="@(Subject is { } pointed ? $"Effects on {pointed.Name}" : "Effects")"
             OnClose="() => Dispatcher.Dispatch(new PickerClosed())">
    @if (Picking is { } picker && Subject is { } subject)
    {
        <SegmentedControl Class="picker__arms"
                          TValue="PickerArm"
                          Label="Where the effect comes from"
                          Options="Arms"
                          Value="picker.Arm"
                          ValueChanged="arm => Dispatcher.Dispatch(new ArmSelected(arm))" />

        @* What is on them right now, above the list of what could be. Taking one off is the
           commonest thing done in this sheet once a fight moves on, so it is not behind a tab. *@
        <div class="applied">
            @foreach (var effect in subject.Effects)
            {
                <div class="applied__row" data-effect="@effect.Id">
                    <Icon Name="@(Kind(effect) == "Buff" ? "spark" : "warn")" Class="applied__glyph" />
                    <span class="applied__name">@Named(effect)</span>
                    <Button Variant="ButtonVariant.Quiet"
                            Class="applied__off"
                            OnClick="() => Dispatcher.Dispatch(new EffectSet(picker.Subject, effect.Id, null))">
                        <Icon Name="close" Label="@($"Remove {Named(effect)}")" />
                    </Button>
                </div>
            }
            @if (subject.Effects.Count == 0)
            {
                <p class="applied__none">Nothing is on @subject.Name yet.</p>
            }
        </div>

        @switch (picker.Arm)
        {
            case PickerArm.Conditions:
                <RemoteView T="IReadOnlyList<ConditionSummary>" Data="ConditionsStore.Value.Conditions">
                    <Loading>
                        <div class="pending">
                            <Spinner ShowLabel="true" Label="Loading conditions" />
                        </div>
                    </Loading>
                    <Failed Context="message">
                        <ErrorState Title="Could not load the conditions">
                            <ChildContent>@message</ChildContent>
                            <Action>
                                <Button Variant="ButtonVariant.Secondary"
                                        OnClick="() => Dispatcher.Dispatch(new ConditionsRequested())">
                                    Try again
                                </Button>
                            </Action>
                        </ErrorState>
                    </Failed>
                    <Loaded Context="effects">
                        @* Buffs first. Somebody reaches for this sheet because something good
                           just happened to them far more often than because something bad did. *@
                        @foreach (var group in Grouped(effects))
                        {
                            <Disclosure Class="effects__group"
                                        Title="@group.Heading"
                                        Glyph="@group.Glyph"
                                        Count="group.Effects.Count"
                                        Open="true"
                                        data-effect-group="@group.Heading">
                                <div class="conditions">
                                    @foreach (var condition in group.Effects)
                                    {
                                        <div class="condition" data-condition="@condition.Key">
                                            <span class="condition__name">
                                                @condition.Name
                                                @if (Reads(condition) is { Length: > 0 } reads)
                                                {
                                                    <span class="condition__reads">@reads</span>
                                                }
                                            </span>
                                            @if (condition.HasValue)
                                            {
                                                <NumberStepper Label="@condition.Name"
                                                               Min="0"
                                                               Max="10"
                                                               Value="Held(subject, condition.Key)?.Value ?? 0"
                                                               ValueChanged="value => Seed(picker.Subject, subject, condition, value)" />
                                            }
                                            else
                                            {
                                                <Switch Checked="@(Held(subject, condition.Key) is not null)"
                                                        CheckedChanged="on => Seed(picker.Subject, subject, condition, on ? 1 : 0)">
                                                    <span class="visually-hidden">@condition.Name</span>
                                                </Switch>
                                            }
                                        </div>
                                    }
                                </div>
                            </Disclosure>
                        }
                    </Loaded>
                </RemoteView>
                break;

            case PickerArm.Rules:
                <div class="rules">
                    <SearchField Value="@picker.Query"
                                 ValueChanged="query => Dispatcher.Dispatch(new RuleQueryChanged(query ?? string.Empty))"
                                 Placeholder="Search every rule"
                                 Label="Search the rules for an effect" />

                    <RemoteView T="RuleSearchResult" Data="picker.Found">
                        <NotAsked>
                            <p class="hint">
                                The same records the browser shows. Tap one to apply what it states.
                            </p>
                        </NotAsked>
                        <Loading>
                            <div class="pending">
                                <Spinner ShowLabel="true" Label="Searching" />
                            </div>
                        </Loading>
                        <Failed Context="message">
                            <ErrorState Title="Could not search the rules">
                                <ChildContent>@message</ChildContent>
                            </ErrorState>
                        </Failed>
                        <Loaded Context="found">
                            @if (found.Items.Count == 0)
                            {
                                <p class="hint">Nothing matches that.</p>
                            }
                            else
                            {
                                <Card>
                                    <ListContent>
                                        @foreach (var rule in found.Items)
                                        {
                                            <ListRow Title="@rule.Name"
                                                     Meta="@Says(rule)"
                                                     OnClick="() => Take(picker.Subject, rule)" />
                                        }
                                    </ListContent>
                                </Card>
                            }
                        </Loaded>
                    </RemoteView>
                </div>
                break;

            case PickerArm.Custom:
                <div class="custom">
                    <TextInput Label="Name"
                               Placeholder="Courageous Anthem"
                               Value="@State.Draft.Name"
                               ValueChanged="name => Redraft(State.Draft with { Name = name ?? string.Empty })" />

                    <SegmentedControl Class="custom__sign"
                                      TValue="bool"
                                      Label="Bonus or penalty"
                                      Options="Signs"
                                      Value="State.Draft.Bonus"
                                      ValueChanged="bonus => Redraft(State.Draft with { Bonus = bonus })" />

                    <NumberStepper Class="custom__value"
                                   Label="How much"
                                   Min="1"
                                   Max="10"
                                   Value="State.Draft.Value"
                                   ValueChanged="value => Redraft(State.Draft with { Value = value })" />

                    <Select Class="custom__type"
                            TValue="string"
                            Label="Type"
                            Options="Types"
                            Value="@State.Draft.Type"
                            ValueChanged="type => Redraft(State.Draft with { Type = type ?? Types[0].Value })" />

                    <Select Class="custom__applies"
                            TValue="string"
                            Label="Applies to"
                            Options="Targets"
                            Value="@State.Draft.Applies"
                            ValueChanged="applies => Redraft(State.Draft with { Applies = applies ?? Targets[0].Value })" />

                    <Button Variant="ButtonVariant.Primary"
                            Disabled="@(State.Draft.Name.Trim().Length == 0)"
                            OnClick="() => Dispatcher.Dispatch(new CustomEffectAdded(picker.Subject, State.Draft))">
                        Add
                    </Button>
                </div>
                break;
        }
    }
</BottomSheet>

@code {
    CampaignState State => Store.Value;

    EffectPicker? Picking => State.Picker;

    CampaignView? Table =>
        State.Campaign is RemoteData<CampaignView>.Loaded loaded ? loaded.Value : null;

    /// <summary>Who the picker is pointed at, as much of them as this sheet needs: a name for
    /// the heading and what is already on them. A character is found on the roster and a monster
    /// in the initiative order, which is the only place one exists.</summary>
    sealed record Pointed(string Name, IReadOnlyList<ActiveEffectView> Effects);

    Pointed? Subject
    {
        get
        {
            if (Picking is not { } picker || Table is not { } table)
            {
                return null;
            }

            if (picker.Subject.Kind == "Character")
            {
                return table.Characters.FirstOrDefault(c => c.Id == picker.Subject.Id) is { } character
                    ? new Pointed(character.Name, character.Effects)
                    : null;
            }

            return table.Encounter?.Combatants.FirstOrDefault(c => c.Id == picker.Subject.Id) is { } combatant
                ? new Pointed(combatant.Name, combatant.Effects)
                : null;
        }
    }

    static readonly IReadOnlyList<ChoiceOption<PickerArm>> Arms =
    [
        new(PickerArm.Conditions, "Effects"),
        new(PickerArm.Rules, "Rules"),
        new(PickerArm.Custom, "Custom"),
    ];

    sealed record EffectGroup(string Heading, string Glyph, IReadOnlyList<ConditionSummary> Effects);

    static IReadOnlyList<EffectGroup> Grouped(IReadOnlyList<ConditionSummary> effects) =>
    [
        .. new[] { ("Buff", "Buffs", "spark"), ("Condition", "Conditions", "warn") }
            .Select(kind => new EffectGroup(kind.Item2, kind.Item3,
                [.. effects.Where(e => e.Kind == kind.Item1).OrderBy(e => e.Name, StringComparer.Ordinal)]))
            .Where(group => group.Effects.Count > 0),
    ];

    /// <summary>Which of the two an applied effect came from, read back off the registry so a
    /// chip is marked the same way here as in the list it was chosen from. A rule or a custom
    /// effect is in neither group and reads as a condition, which is the cautious way round.</summary>
    string Kind(ActiveEffectView effect) =>
        effect.Key is { Length: > 0 } key
        && ConditionsStore.Value.Conditions is RemoteData<IReadOnlyList<ConditionSummary>>.Loaded loaded
        && loaded.Value.FirstOrDefault(c =>
            string.Equals(c.Key, key, StringComparison.OrdinalIgnoreCase)) is { } found
            ? found.Kind
            : "Condition";

    /// <summary>What the effect does, in the words of the breakdown it will appear in, so nobody
    /// has to open the rule to find out whether an anthem helps their armour class.</summary>
    static string Reads(ConditionSummary effect) =>
        string.Join("; ", effect.Modifiers.Select(m =>
            $"{(m.Value > 0 ? "+" : string.Empty)}{m.Value} {m.Type.ToLowerInvariant()} to {string.Join(", ", m.Applies)}"));

    static readonly IReadOnlyList<ChoiceOption<bool>> Signs =
    [
        new(true, "Bonus"),
        new(false, "Penalty"),
    ];

    static readonly IReadOnlyList<ChoiceOption<string>> Types =
    [
        new("Status", "Status"),
        new("Circumstance", "Circumstance"),
        new("Item", "Item"),
        new("Untyped", "Untyped"),
    ];

    static readonly IReadOnlyList<ChoiceOption<string>> Targets =
        [.. EffectVocabulary.All.Select(choice => new ChoiceOption<string>(choice.Token, choice.Label))];

    static ActiveEffectView? Held(Pointed subject, string key) =>
        subject.Effects.FirstOrDefault(effect =>
            effect.Kind == "Seeded" && string.Equals(effect.Key, key, StringComparison.OrdinalIgnoreCase));

    static string Named(ActiveEffectView effect) => SheetFormat.Named(effect);

    static RenderFragment Says(RuleSummary rule) => @<text>
        @if (rule.HasModifiers)
        {
            <span class="states">States a modifier this app can apply</span>
        }
        else
        {
            <span class="states states--none">States no modifier this app can apply yet. Tap to write it yourself.</span>
        }
    </text>;

    void Redraft(EffectDraft draft) => Dispatcher.Dispatch(new DraftChanged(draft));

    void Take(EffectSubject subject, RuleSummary rule)
    {
        if (rule.HasModifiers)
        {
            Dispatcher.Dispatch(new RuleEffectRequested(subject, rule.Id, rule.Name));
            return;
        }

        Dispatcher.Dispatch(new RuleDeclined(rule.Name));
    }

    /// <summary>A seeded effect reuses whatever slot it already holds, so raising clumsy from 1 to
    /// 2 is the same effect rather than a second one.</summary>
    void Seed(EffectSubject subject, Pointed pointed, ConditionSummary condition, int value)
    {
        var slot = Held(pointed, condition.Key)?.Id ?? Guid.NewGuid();
        var effect = value <= 0
            ? null
            : new EffectSpec(
                condition.Name,
                "Seeded",
                condition.Key,
                condition.HasValue ? value : 0,
                null,
                []);

        Dispatcher.Dispatch(new EffectSet(subject, slot, effect));
    }
}
