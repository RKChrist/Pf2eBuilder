{
  "surface": {
    "$type": "color",
    "page": {
      "$value": "{color.ink.50}"
    },
    "raised": {
      "$value": "{color.ink.0}"
    },
    "sunken": {
      "$value": "{color.ink.100}"
    },
    "overlay": {
      "$value": "{color.ink.0}"
    }
  },
  "text": {
    "$type": "color",
    "primary": {
      "$value": "{color.ink.900}"
    },
    "secondary": {
      "$value": "{color.ink.600}"
    },
    "muted": {
      "$value": "{color.ink.500}"
    },
    "on-accent": {
      "$value": "{color.ink.0}"
    },
    "on-danger": {
      "$value": "{color.ink.0}"
    }
  },
  "line": {
    "$type": "color",
    "subtle": {
      "$value": "{color.ink.200}"
    },
    "strong": {
      "$value": "{color.ink.500}"
    },
    "focus": {
      "$value": "{color.teal.600}"
    }
  },
  "accent": {
    "$type": "color",
    "base": {
      "$value": "{color.teal.600}"
    },
    "press": {
      "$value": "{color.teal.700}"
    },
    "wash": {
      "$value": "{color.teal.300}"
    }
  },
  "danger": {
    "$type": "color",
    "$description": "Destructive UI actions and invalid input. Deliberately not the outcome ramp: a delete button is not a failed roll, and overloading the four degrees of success would move them whenever the chrome changes.",
    "base": {
      "$value": "{color.crimson.600}"
    },
    "press": {
      "$value": "{color.crimson.700}"
    }
  },
  "scrim": {
    "$type": "color",
    "$description": "The ground behind a bottom sheet. It must darken the page in both themes, so no surface role fits: surface-sunken is a pale grey in light.",
    "$value": "{color.ink.950}"
  },
  "rarity": {
    "$type": "color",
    "common": {
      "$value": "{color.ink.500}"
    },
    "uncommon": {
      "$value": "{color.amber.600}"
    },
    "rare": {
      "$value": "{color.blue.600}"
    },
    "unique": {
      "$value": "{color.violet.600}"
    }
  },
  "outcome": {
    "$type": "color",
    "critical-failure": {
      "$value": "{color.crimson.700}"
    },
    "failure": {
      "$value": "{color.rose.500}"
    },
    "success": {
      "$value": "{color.moss.600}"
    },
    "critical-success": {
      "$value": "{color.jade.700}"
    }
  },
  "rank": {
    "$type": "color",
    "filled": {
      "$value": "{color.teal.600}"
    },
    "empty": {
      "$value": "{color.ink.200}"
    }
  }
}
